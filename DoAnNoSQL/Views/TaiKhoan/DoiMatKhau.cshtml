@{
    ViewBag.Title = "Đổi mật khẩu";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                <i class="fas fa-home mr-2"></i>
                Trang chủ
            </a>
        </li>
        <li>
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <a href="@Url.Action("Index", "TaiKhoan")" class="text-sm font-medium text-gray-700 hover:text-blue-600">
                    Tài khoản
                </a>
            </div>
        </li>
        <li aria-current="page">
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <span class="text-sm font-medium text-gray-500">Đổi mật khẩu</span>
            </div>
        </li>
    </ol>
</nav>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-6 py-4 rounded-lg mb-6 animate__animated animate__fadeInDown" role="alert">
        <div class="flex items-center">
            <i class="fas fa-check-circle text-2xl mr-3"></i>
            <div>
                <strong class="font-bold">Thành công!</strong>
                <p class="text-sm">@TempData["SuccessMessage"]</p>
            </div>
            <button type="button" class="ml-auto" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times text-green-700 hover:text-green-900"></i>
            </button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-100 border border-red-400 text-red-700 px-6 py-4 rounded-lg mb-6 animate__animated animate__fadeInDown" role="alert">
        <div class="flex items-center">
            <i class="fas fa-exclamation-circle text-2xl mr-3"></i>
            <div>
                <strong class="font-bold">Lỗi!</strong>
                <p class="text-sm">@TempData["ErrorMessage"]</p>
            </div>
            <button type="button" class="ml-auto" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times text-red-700 hover:text-red-900"></i>
            </button>
        </div>
    </div>
}

<!-- 3D Header -->
<div class="page-header-3d border-beam-3d mb-8" data-aos="fade-down">
    <div class="relative z-10 flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-teal-500/20 border border-teal-400/40 text-teal-300 flex items-center justify-center shadow-lg shadow-teal-500/20">
            <i class="fas fa-key text-2xl"></i>
        </div>
        <div>
            <h1 class="text-2xl sm:text-3xl font-black font-heading text-white">
                Đổi mật khẩu tài khoản
            </h1>
            <p class="text-xs text-slate-300 mt-0.5">Bảo vệ thông tin cá nhân và đơn hàng với mật khẩu mạnh</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Sidebar Menu 3D (1/4) -->
    <div class="lg:col-span-1">
        <div class="card-glass-3d p-5 sticky top-4" data-aos="fade-right">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-400 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
                <i class="fas fa-bars-staggered text-teal-600"></i>
                Quản lý tài khoản
            </h3>
            <nav class="space-y-2">
                <a href="@Url.Action("Index", "TaiKhoan")" class="flex items-center px-4 py-3 text-slate-700 hover:bg-teal-50 hover:text-teal-700 rounded-xl font-bold text-xs transition-colors">
                    <i class="fas fa-user-circle w-5 mr-3 text-sm text-slate-400"></i>
                    Thông tin tài khoản
                </a>
                <a href="@Url.Action("DoiMatKhau", "TaiKhoan")" class="flex items-center px-4 py-3 bg-gradient-to-r from-teal-600 to-emerald-600 text-white rounded-xl font-bold text-xs shadow-md shadow-teal-600/30">
                    <i class="fas fa-key w-5 mr-3 text-sm"></i>
                    Đổi mật khẩu
                </a>
                <a href="@Url.Action("DonHang", "TaiKhoan")" class="flex items-center px-4 py-3 text-slate-700 hover:bg-teal-50 hover:text-teal-700 rounded-xl font-bold text-xs transition-colors">
                    <i class="fas fa-shopping-bag w-5 mr-3 text-sm text-slate-400"></i>
                    Đơn hàng của tôi
                </a>
                <a href="@Url.Action("Logout", "Account")" class="flex items-center px-4 py-3 text-rose-600 hover:bg-rose-50 rounded-xl font-bold text-xs transition-colors mt-4 pt-3 border-t border-slate-100">
                    <i class="fas fa-sign-out-alt w-5 mr-3 text-sm"></i>
                    Đăng xuất
                </a>
            </nav>
        </div>
    </div>

    <!-- Main Content 3D (3/4) -->
    <div class="lg:col-span-3">
        <div class="card-glass-3d border-beam-3d p-6 sm:p-8" data-aos="fade-left">
            <h2 class="text-lg sm:text-xl font-black text-slate-900 mb-6 pb-4 border-b border-slate-100 flex items-center justify-between">
                <span class="flex items-center gap-2.5">
                    <i class="fas fa-lock text-teal-600"></i>
                    Cập nhật mật khẩu mới
                </span>
                <span class="text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 rounded-full bg-teal-50 text-teal-700 border border-teal-200">Mã hóa đa lớp</span>
            </h2>

            <div class="max-w-xl">
                <form action="@Url.Action("DoiMatKhau", "TaiKhoan")" method="post" id="changePasswordForm">
                    @Html.AntiForgeryToken()

                    <!-- Mật khẩu cũ -->
                    <div class="mb-5">
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Mật khẩu hiện tại <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="matKhauCu"
                                   name="matKhauCu"
                                   required
                                   class="w-full input-3d pr-12 text-xs font-semibold"
                                   placeholder="Nhập mật khẩu hiện tại">
                            <button type="button" onclick="togglePassword('matKhauCu')" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-teal-600 transition">
                                <i class="fas fa-eye" id="matKhauCu-icon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="mb-5">
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Mật khẩu mới <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="matKhauMoi"
                                   name="matKhauMoi"
                                   required
                                   minlength="6"
                                   class="w-full input-3d pr-12 text-xs font-semibold"
                                   placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)">
                            <button type="button" onclick="togglePassword('matKhauMoi')" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-teal-600 transition">
                                <i class="fas fa-eye" id="matKhauMoi-icon"></i>
                            </button>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1.5 flex items-center gap-1">
                            <i class="fas fa-info-circle text-teal-500"></i>
                            Mật khẩu nên gồm chữ hoa, chữ thường và chữ số để tối ưu an toàn
                        </p>
                    </div>

                    <!-- Xác nhận mật khẩu mới -->
                    <div class="mb-6">
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Xác nhận mật khẩu mới <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="xacNhanMatKhau"
                                   name="xacNhanMatKhau"
                                   required
                                   class="w-full input-3d pr-12 text-xs font-semibold"
                                   placeholder="Nhập lại mật khẩu mới">
                            <button type="button" onclick="togglePassword('xacNhanMatKhau')" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-teal-600 transition">
                                <i class="fas fa-eye" id="xacNhanMatKhau-icon"></i>
                            </button>
                        </div>
                        <p id="passwordMatchMessage" class="text-xs mt-1.5 hidden font-semibold"></p>
                    </div>

                    <!-- Security Tips 3D -->
                    <div class="card-glass-3d p-4 mb-6 border-l-4 border-amber-400 bg-amber-50/40">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 text-sm">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="text-xs text-slate-600">
                                <p class="font-bold text-slate-800 mb-1">Mẹo bảo mật tài khoản:</p>
                                <ul class="list-disc list-inside space-y-0.5 text-slate-500 text-[11px]">
                                    <li>Sử dụng mật khẩu mạnh có tối thiểu 6-8 ký tự</li>
                                    <li>Không chia sẻ mã đăng nhập hoặc OTP cho bất kỳ ai</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="flex items-center gap-3">
                        <button type="submit"
                                class="btn-3d btn-3d-primary flex-1 py-3 text-xs font-black uppercase rounded-xl flex items-center justify-center gap-2">
                            <i class="fas fa-floppy-disk"></i>
                            Đổi mật khẩu
                        </button>
                        <a href="@Url.Action("Index", "TaiKhoan")"
                           class="btn-3d btn-3d-secondary flex-1 py-3 text-xs font-black uppercase rounded-xl flex items-center justify-center gap-2">
                            <i class="fas fa-times"></i>
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Toggle password visibility
        function togglePassword(fieldId) {
            var field = document.getElementById(fieldId);
            var icon = document.getElementById(fieldId + '-icon');

            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // Check password match
        $('#xacNhanMatKhau').on('input', function () {
            var matKhauMoi = $('#matKhauMoi').val();
            var xacNhan = $(this).val();
            var message = $('#passwordMatchMessage');

            if (xacNhan.length > 0) {
                if (matKhauMoi === xacNhan) {
                    message.removeClass('text-red-500').addClass('text-green-600')
                        .html('<i class="fas fa-check-circle mr-1"></i>Mật khẩu khớp')
                        .removeClass('hidden');
                } else {
                    message.removeClass('text-green-600').addClass('text-red-500')
                        .html('<i class="fas fa-times-circle mr-1"></i>Mật khẩu không khớp')
                        .removeClass('hidden');
                }
            } else {
                message.addClass('hidden');
            }
        });

        // Form validation
        $('#changePasswordForm').on('submit', function (e) {
            var matKhauMoi = $('#matKhauMoi').val();
            var xacNhan = $('#xacNhanMatKhau').val();

            if (matKhauMoi !== xacNhan) {
                e.preventDefault();
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Mật khẩu xác nhận không khớp',
                    confirmButtonColor: '#dc3545'
                });
                $('#xacNhanMatKhau').focus();
                return false;
            }
        });

        // Auto-hide messages
        setTimeout(function () {
            $('[role="alert"]').fadeOut('slow', function () {
                $(this).remove();
            });
        }, 5000);
    </script>
}