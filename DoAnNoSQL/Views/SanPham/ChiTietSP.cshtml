@model DoAnNoSQL.Models.ProductDetailViewModel

@{
    ViewBag.Title = Model.SanPham.TenSanPham;
    var user = Session["User"] as DoAnNoSQL.Models.UserSessionViewModel;

    // Chuẩn bị danh sách ảnh cho Gallery & Lightbox
    var galleryImages = new List<string>();
    if (!string.IsNullOrEmpty(Model.SanPham.HinhAnh))
    {
        galleryImages.Add(Url.Content("~/Content/Images/" + Model.SanPham.HinhAnh));
    }
    if (Model.DanhSachAnh != null && Model.DanhSachAnh.Any())
    {
        foreach (var a in Model.DanhSachAnh)
        {
            var u = Url.Content("~/Content/Images/" + a.HinhAnh);
            if (!galleryImages.Contains(u))
            {
                galleryImages.Add(u);
            }
        }
    }
    if (!galleryImages.Any())
    {
        galleryImages.Add(Url.Content("~/Content/Images/no-image.png"));
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Breadcrumb -->
    <nav class="flex mb-6 text-xs text-slate-500 font-medium" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-2">
            <li>
                <a href="@Url.Action("Index", "Home")" class="text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-1.5">
                    <i class="fas fa-house text-[11px]"></i>
                    <span>Trang chủ</span>
                </a>
            </li>
            @if (ViewBag.TenDanhMuc != null)
            {
                <li class="flex items-center space-x-2">
                    <i class="fas fa-chevron-right text-[10px] text-slate-300"></i>
                    <a href="@Url.Action("Index", "SanPham", new { danhMucId = ViewBag.DanhMucId })" class="text-slate-500 hover:text-slate-900 transition-colors">
                        @ViewBag.TenDanhMuc
                    </a>
                </li>
            }
            <li class="flex items-center space-x-2">
                <i class="fas fa-chevron-right text-[10px] text-slate-300"></i>
                <span class="text-slate-900 font-semibold truncate max-w-[240px] sm:max-w-md">@Model.SanPham.TenSanPham</span>
            </li>
        </ol>
    </nav>

    <!-- Main Product Card (Flagship Studio Layout) -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs p-6 sm:p-8 lg:p-10 mb-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">

            <!-- LEFT: Product Gallery (5/12 cols on desktop) -->
            <div class="lg:col-span-5 space-y-4">
                <!-- Main Featured Image -->
                <div onclick="openLightbox(currentGalleryIndex)" 
                     class="aspect-square product-image-3d-stage bg-slate-50/80 rounded-2xl border border-slate-100 flex items-center justify-center p-6 sm:p-8 relative group cursor-zoom-in transition-all select-none">
                    
                    <img id="mainImage" 
                         src="@galleryImages[0]" 
                         alt="@Model.SanPham.TenSanPham" 
                         class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-sm" />

                    <!-- Floating Badges Top Left -->
                    <div class="absolute top-4 left-4 flex flex-col gap-1.5 items-start">
                        @if (Model.SanPham.LaSanPhamMoi == true)
                        {
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-900 text-white tracking-wide uppercase shadow-xs">
                                Mới ra mắt
                            </span>
                        }
                        @if (Model.SanPham.GiaKhuyenMai.HasValue && Model.SanPham.GiaKhuyenMai < Model.SanPham.Gia)
                        {
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-600 text-white tracking-wide shadow-xs">
                                Tiết kiệm @Math.Round((decimal)(1 - (Model.SanPham.GiaKhuyenMai.Value / Model.SanPham.Gia.Value)) * 100)%
                            </span>
                        }
                    </div>

                    <!-- Zoom Icon Button Top Right -->
                    <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/90 backdrop-blur-md border border-slate-200/60 text-slate-700 flex items-center justify-center shadow-xs opacity-0 group-hover:opacity-100 transition-all hover:bg-white hover:scale-110" title="Xem ảnh phóng to">
                        <i class="fas fa-expand text-xs"></i>
                    </div>


                </div>

                <!-- Thumbnails Strip -->
                @if (galleryImages.Count > 1)
                {
                    <div class="flex items-center gap-2.5 overflow-x-auto pb-1" id="thumbnailTrack">
                        @for (int idx = 0; idx < galleryImages.Count; idx++)
                        {
                            var imgPath = galleryImages[idx];
                            <div onclick="selectThumbnail(@idx, this)"
                                 data-image="@imgPath"
                                 class="thumbnail-image w-16 h-16 sm:w-18 sm:h-18 rounded-xl bg-slate-50 border-2 @(idx == 0 ? "border-slate-900 ring-2 ring-slate-900/10" : "border-slate-200/80 hover:border-slate-400 opacity-70 hover:opacity-100") p-1.5 cursor-pointer transition-all shrink-0 flex items-center justify-center">
                                <img src="@imgPath" alt="Thumbnail" class="w-full h-full object-contain pointer-events-none" />
                            </div>
                        }
                    </div>
                }

                <!-- Interactive 3D Product Orbit Studio Button -->
                <div class="pt-2">
                    <button type="button" 
                            class="btn-launch-3d w-full py-3 px-4 rounded-2xl text-white font-bold text-sm sm:text-base flex items-center justify-center gap-3 transition-all cursor-pointer shadow-lg group"
                            data-action="open-3d-studio"
                            data-title="@Model.SanPham.TenSanPham"
                            data-image="@galleryImages[0]">
                        <div class="w-8 h-8 rounded-xl bg-teal-500/20 border border-teal-400/40 flex items-center justify-center text-teal-300 group-hover:scale-110 transition-transform">
                            <i class="fas fa-cube text-base"></i>
                        </div>
                        <div class="text-left flex-1">
                            <span class="block text-white leading-tight font-heading">Khám Phá Mô Hình 3D (360° Studio)</span>
                            <span class="block text-[11px] text-teal-300/80 font-normal">Kéo xoay 360° • Đổi màu Titanium • Hologram</span>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black tracking-wider uppercase bg-teal-400/20 text-teal-200 border border-teal-400/40 shadow-xs">
                            INTERACTIVE 3D
                        </span>
                    </button>
                </div>

            </div>

            <!-- RIGHT: Product Info & Buy Area (7/12 cols on desktop) -->
            <div class="lg:col-span-7 flex flex-col justify-between">
                <div class="space-y-3 sm:space-y-3.5">
                    <!-- Brand & Code Meta -->
                    <div class="flex items-center justify-between gap-4 mb-2">
                        @if (Model.SanPham.tb_ThuongHieu != null)
                        {
                            <a href="@Url.Action("Index", "SanPham", new { thuongHieuId = Model.SanPham.ThuongHieuId })" class="text-xs font-bold uppercase tracking-widest text-teal-600 hover:text-teal-700 transition-colors">
                                @Model.SanPham.tb_ThuongHieu.TenThuongHieu
                            </a>
                        }
                        else
                        {
                            <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Chính hãng</span>
                        }
                        <span class="text-xs text-slate-400 font-mono">Mã: @Model.SanPham.MaSanPham</span>
                    </div>

                    <!-- Product Name -->
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight font-heading leading-tight mb-3">
                        @Model.SanPham.TenSanPham
                    </h1>

                    <!-- Rating & Social Proof Live Pulse -->
                    <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 pb-4 border-b border-slate-100">
                        @if (Model.TongSoDanhGia > 0)
                        {
                            <div class="flex items-center gap-1.5">
                                <div class="flex text-amber-400 text-xs">
                                    @{
                                        var avgRating = Model.DiemTrungBinh;
                                        for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(avgRating))
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else if (i == Math.Ceiling(avgRating) && avgRating % 1 != 0)
                                            {
                                                <i class="fas fa-star-half-alt"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-slate-300"></i>
                                            }
                                        }
                                    }
                                </div>
                                <span class="font-bold text-slate-800">@avgRating.ToString("0.0")</span>
                                <span class="text-slate-400">(@Model.TongSoDanhGia đánh giá)</span>
                            </div>
                            <span class="text-slate-300">•</span>
                        }
                        <span class="flex items-center gap-1">
                            <i class="far fa-eye text-slate-400"></i>
                            <span>@(Model.SanPham.LuotXem ?? 0) lượt xem</span>
                        </span>
                        <span class="text-slate-300">•</span>
                        <!-- Live viewing indicator -->
                        <span class="inline-flex items-center gap-1.5 text-emerald-700 font-medium">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                            </span>
                            <span>18 người đang xem</span>
                        </span>
                    </div>

                    <!-- Clean Premium Price Presentation -->
                    <div class="py-2">
                        <div class="flex items-baseline gap-3 flex-wrap">
                            @if (Model.SanPham.GiaKhuyenMai.HasValue && Model.SanPham.GiaKhuyenMai < Model.SanPham.Gia)
                            {
                                <span class="text-3xl sm:text-4xl font-extrabold text-rose-600 font-heading tracking-tight">
                                    @String.Format("{0:0,0}", Model.SanPham.GiaKhuyenMai.Value) đ
                                </span>
                                <span class="text-base text-slate-400 line-through font-medium">
                                    @String.Format("{0:0,0}", Model.SanPham.Gia.Value) đ
                                </span>
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-600 border border-rose-200/80">
                                    Tiết kiệm @String.Format("{0:0,0}", (Model.SanPham.Gia.Value - Model.SanPham.GiaKhuyenMai.Value)) đ
                                </span>
                            }
                            else
                            {
                                <span class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-heading tracking-tight">
                                    @String.Format("{0:0,0}", Model.SanPham.Gia ?? 0) đ
                                </span>
                            }
                        </div>

                        <!-- Delivery Note -->
                        <div class="mt-2 text-xs text-slate-500 flex items-center gap-2">
                            <i class="fas fa-truck-fast text-teal-600"></i>
                            <span>Miễn phí giao hàng toàn quốc • Nhận hàng dự kiến: <strong class="text-slate-800 font-semibold">Ngày mai</strong></span>
                        </div>
                    </div>

                    <!-- Color Swatches -->
                    @if (ViewBag.TenDanhMuc == null || !ViewBag.TenDanhMuc.ToString().ToLower().Contains("phụ kiện"))
                    {
                        <div>
                            <div class="flex items-center justify-between mb-2.5">
                                <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Chọn màu sắc:</span>
                                <span id="selectedColorName" class="text-xs font-bold text-slate-900">Xám Titanium</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <label class="relative cursor-pointer">
                                    <input type="radio" name="color" value="gray" checked class="peer sr-only color-radio" data-color-name="Xám Titanium" />
                                    <div class="w-9 h-9 rounded-full bg-slate-500 border-2 border-white peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:ring-offset-2 transition-all shadow-xs flex items-center justify-center">
                                        <i class="fas fa-check text-white text-[10px] opacity-0 peer-checked:opacity-100"></i>
                                    </div>
                                </label>

                                <label class="relative cursor-pointer">
                                    <input type="radio" name="color" value="silver" class="peer sr-only color-radio" data-color-name="Bạc Ánh Kim" />
                                    <div class="w-9 h-9 rounded-full bg-slate-200 border-2 border-white peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:ring-offset-2 transition-all shadow-xs flex items-center justify-center">
                                        <i class="fas fa-check text-slate-800 text-[10px] opacity-0 peer-checked:opacity-100"></i>
                                    </div>
                                </label>

                                <label class="relative cursor-pointer">
                                    <input type="radio" name="color" value="black" class="peer sr-only color-radio" data-color-name="Đen Huyền Bí" />
                                    <div class="w-9 h-9 rounded-full bg-slate-900 border-2 border-white peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:ring-offset-2 transition-all shadow-xs flex items-center justify-center">
                                        <i class="fas fa-check text-white text-[10px] opacity-0 peer-checked:opacity-100"></i>
                                    </div>
                                </label>

                                <label class="relative cursor-pointer">
                                    <input type="radio" name="color" value="gold" class="peer sr-only color-radio" data-color-name="Vàng Sa Mạc" />
                                    <div class="w-9 h-9 rounded-full bg-amber-300 border-2 border-white peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:ring-offset-2 transition-all shadow-xs flex items-center justify-center">
                                        <i class="fas fa-check text-slate-800 text-[10px] opacity-0 peer-checked:opacity-100"></i>
                                    </div>
                                </label>

                                <label class="relative cursor-pointer">
                                    <input type="radio" name="color" value="blue" class="peer sr-only color-radio" data-color-name="Xanh Đại Dương" />
                                    <div class="w-9 h-9 rounded-full bg-blue-600 border-2 border-white peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:ring-offset-2 transition-all shadow-xs flex items-center justify-center">
                                        <i class="fas fa-check text-white text-[10px] opacity-0 peer-checked:opacity-100"></i>
                                    </div>
                                </label>
                            </div>
                        </div>
                    }

                    <!-- Short Description (If any) -->
                    @if (!string.IsNullOrEmpty(Model.SanPham.MoTa))
                    {
                        <div class="p-3 bg-slate-50/70 rounded-2xl border border-slate-100 text-xs text-slate-600 leading-relaxed">
                            <p class="line-clamp-3">@Model.SanPham.MoTa</p>
                        </div>
                    }
                </div>

                <!-- Stock Status & Purchase Actions Container (Aligned with thumbnails) -->
                <div id="mainBuySection" class="pt-3">
                        <!-- Add to Cart Form -->
                        <form id="mainAddToCartForm" action="@Url.Action("ThemVaoGioHang", "SanPham")" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sanPhamId" value="@Model.SanPham.Id" />
                            <input type="hidden" name="color" id="selectedColor" value="gray" />


                            @if (Model.SanPham.SoLuong.HasValue && Model.SanPham.SoLuong > 0)
                            {
                                <div class="space-y-3">
                                    <!-- Big Hero CTA: MUA NGAY -->
                                    <button type="button" 
                                            onclick="buyNow()" 
                                            class="w-full h-14 rounded-2xl bg-gradient-to-r from-red-600 via-rose-600 to-red-600 hover:from-red-700 hover:to-rose-700 text-white font-bold transition-all shadow-md shadow-red-500/20 active:scale-[0.99] flex flex-col items-center justify-center group cursor-pointer">
                                        <span class="text-base font-black tracking-wider uppercase flex items-center gap-2">
                                            <i class="fas fa-bolt text-yellow-300 group-hover:scale-110 transition-transform"></i> MUA NGAY
                                        </span>
                                        <span class="text-[11px] font-normal text-white/90">Giao hàng tận nơi hoặc nhận tại cửa hàng</span>
                                    </button>

                                    <!-- Secondary Action Row: Stepper + Thêm vào giỏ -->
                                    <div class="flex items-center gap-3">
                                        <!-- Stepper Quantity -->
                                        <div class="flex items-center justify-between border-2 border-slate-200 rounded-xl h-12 w-32 bg-slate-50 px-2 shrink-0">
                                            <button type="button" 
                                                    onclick="decrementQty()" 
                                                    class="w-8 h-full text-slate-500 hover:text-slate-900 flex items-center justify-center transition-colors active:scale-90">
                                                <i class="fas fa-minus text-xs"></i>
                                            </button>
                                            <input type="number" 
                                                   name="soLuong" 
                                                   id="quantity" 
                                                   value="1" 
                                                   min="1" 
                                                   max="@(Model.SanPham.SoLuong ?? 1)" 
                                                   class="w-10 text-center bg-transparent border-none font-bold text-slate-900 text-sm focus:outline-none focus:ring-0 appearance-none m-0 p-0" 
                                                   onchange="validateQuantity()" />
                                            <button type="button" 
                                                    onclick="incrementQty()" 
                                                    class="w-8 h-full text-slate-500 hover:text-slate-900 flex items-center justify-center transition-colors active:scale-90">
                                                <i class="fas fa-plus text-xs"></i>
                                            </button>
                                        </div>

                                        <!-- Add to Cart Button -->
                                        <button type="submit" 
                                                class="flex-1 h-12 rounded-xl border-2 border-slate-800 hover:border-slate-900 bg-white hover:bg-slate-900 hover:text-white text-slate-900 font-bold text-xs sm:text-sm transition-all duration-200 flex items-center justify-center gap-2 shadow-xs active:scale-[0.99] cursor-pointer">
                                            <i class="fas fa-cart-plus text-base"></i>
                                            <span>Thêm vào giỏ hàng</span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" disabled class="w-full h-14 bg-slate-200 text-slate-400 font-bold rounded-2xl text-sm cursor-not-allowed flex items-center justify-center gap-2">
                                    <i class="fas fa-ban text-sm"></i>
                                    <span>Tạm thời hết hàng</span>
                                </button>
                            }
                        </form>
                    </div>
            </div>
        </div>

        <!-- 4 Standalone Guarantee Cards (No Outer Big Box, No Header) -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mt-8 pt-6 border-t border-slate-100">
            <!-- Item 1: Giao nhanh -->
            <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-2xl bg-slate-50/90 hover:bg-slate-100/80 border border-slate-200/70 transition-all shadow-2xs">
                <span class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center shrink-0 text-sm shadow-2xs">
                    <i class="fas fa-truck-fast"></i>
                </span>
                <div class="min-w-0">
                    <strong class="text-slate-900 block text-xs sm:text-sm font-bold leading-tight truncate">Giao hàng hỏa tốc 2H</strong>
                    <span class="text-[11px] text-slate-500 truncate block">Miễn phí ship cho đơn từ 500k</span>
                </div>
            </div>

            <!-- Item 2: Chính hãng -->
            <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-2xl bg-slate-50/90 hover:bg-slate-100/80 border border-slate-200/70 transition-all shadow-2xs">
                <span class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 text-sm shadow-2xs">
                    <i class="fas fa-award"></i>
                </span>
                <div class="min-w-0">
                    <strong class="text-slate-900 block text-xs sm:text-sm font-bold leading-tight truncate">Chính hãng 100%</strong>
                    <span class="text-[11px] text-slate-500 truncate block">Bảo hành 12 - 24 tháng toàn quốc</span>
                </div>
            </div>

            <!-- Item 3: Đổi trả -->
            <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-2xl bg-slate-50/90 hover:bg-slate-100/80 border border-slate-200/70 transition-all shadow-2xs">
                <span class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 text-sm shadow-2xs">
                    <i class="fas fa-rotate-left"></i>
                </span>
                <div class="min-w-0">
                    <strong class="text-slate-900 block text-xs sm:text-sm font-bold leading-tight truncate">1 đổi 1 trong 30 ngày</strong>
                    <span class="text-[11px] text-slate-500 truncate block">Nếu phát sinh lỗi do nhà sản xuất</span>
                </div>
            </div>

            <!-- Item 4: Trả góp -->
            <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-2xl bg-slate-50/90 hover:bg-slate-100/80 border border-slate-200/70 transition-all shadow-2xs">
                <span class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center shrink-0 text-sm shadow-2xs">
                    <i class="fas fa-credit-card"></i>
                </span>
                <div class="min-w-0">
                    <strong class="text-slate-900 block text-xs sm:text-sm font-bold leading-tight truncate">Hỗ trợ trả góp 0%</strong>
                    <span class="text-[11px] text-slate-500 truncate block">Thủ tục nhanh qua thẻ tín dụng</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Details Tabs (Full-width Integrated Header) -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden mb-10">
        <!-- Integrated Full-Width Tabs Header -->
        <div class="bg-slate-100/80 p-2 sm:p-2.5 border-b border-slate-200/80">
            <nav class="grid grid-cols-3 gap-1.5 sm:gap-2 w-full">
                <button class="tab-button active bg-white shadow-xs text-slate-900 py-3 px-3 sm:px-5 rounded-2xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 cursor-pointer" data-tab="details">
                    <i class="fas fa-align-left text-xs text-slate-700"></i>
                    <span class="hidden sm:inline">Chi tiết sản phẩm</span>
                    <span class="sm:hidden">Chi tiết</span>
                </button>
                <button class="tab-button text-slate-500 hover:text-slate-900 py-3 px-3 sm:px-5 rounded-2xl text-xs sm:text-sm font-semibold transition-all flex items-center justify-center gap-2 cursor-pointer" data-tab="specs">
                    <i class="fas fa-sliders text-xs"></i>
                    <span class="hidden sm:inline">Thông số kỹ thuật</span>
                    <span class="sm:hidden">Thông số</span>
                </button>
                <button class="tab-button text-slate-500 hover:text-slate-900 py-3 px-3 sm:px-5 rounded-2xl text-xs sm:text-sm font-semibold transition-all flex items-center justify-center gap-2 cursor-pointer" data-tab="reviews">
                    <i class="fas fa-star text-xs text-amber-400"></i>
                    <span>Đánh giá (@ViewBag.SoLuotDanhGia)</span>
                </button>
            </nav>
        </div>

        <!-- Tab Content Body with Padding -->
        <div class="p-6 sm:p-8 lg:p-10">
            <!-- Details Tab -->
            <div id="details-tab" class="tab-content">
                @if (!string.IsNullOrEmpty(Model.SanPham.ChiTiet))
                {
                    <div class="prose max-w-none text-slate-700 leading-relaxed text-sm sm:text-base">
                        @Html.Raw(Model.SanPham.ChiTiet)
                    </div>
                }
                else
                {
                    <p class="text-slate-400 italic text-center py-12">Chưa có thông tin chi tiết cho sản phẩm này.</p>
                }
            </div>

            <!-- Specs Tab -->
            <div id="specs-tab" class="tab-content hidden">
                @if (Model.SanPham.tb_ThongSo != null && Model.SanPham.tb_ThongSo.Any())
                {
                    <div class="overflow-hidden rounded-2xl border border-slate-200/80 shadow-xs w-full">
                        <table class="min-w-full divide-y divide-slate-200 text-sm">
                            <thead class="bg-slate-50">
                                <tr>
                                    <th scope="col" class="px-6 py-3.5 text-left text-xs font-bold text-slate-600 uppercase tracking-wider w-1/3">
                                        Thông số
                                    </th>
                                    <th scope="col" class="px-6 py-3.5 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">
                                        Giá trị
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-slate-100">
                                @foreach (var thongSo in Model.SanPham.tb_ThongSo.OrderBy(t => t.Id))
                                {
                                    <tr class="hover:bg-slate-50/70 transition-colors odd:bg-slate-50/30">
                                        <td class="px-6 py-3.5 font-semibold text-slate-900">
                                            @thongSo.TenThongSo
                                        </td>
                                        <td class="px-6 py-3.5 text-slate-600 font-medium">
                                            @thongSo.GiaTri
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-12">
                        <i class="fas fa-clipboard-list text-slate-300 text-4xl mb-3"></i>
                        <p class="text-slate-500 font-medium text-sm">Chưa có thông số kỹ thuật</p>
                    </div>
                }
            </div>

            <!-- Reviews Tab -->
            <div id="reviews-tab" class="tab-content hidden">
                @{
                    var reviewList = ViewBag.ListDanhGia != null ? ((IEnumerable<dynamic>)ViewBag.ListDanhGia).ToList() : new List<dynamic>();
                    int rTotal = reviewList.Count;
                    int r5 = reviewList.Count(r => (int)(r.Sao ?? 0) == 5);
                    int r4 = reviewList.Count(r => (int)(r.Sao ?? 0) == 4);
                    int r3 = reviewList.Count(r => (int)(r.Sao ?? 0) == 3);
                    int r2 = reviewList.Count(r => (int)(r.Sao ?? 0) == 2);
                    int r1 = reviewList.Count(r => (int)(r.Sao ?? 0) == 1);
                }
                
                <!-- Reviews Summary Bar -->
                <div class="bg-slate-50 rounded-2xl p-6 sm:p-8 mb-8 border border-slate-200/80 flex flex-col md:flex-row items-center justify-between gap-8">
                    <!-- Rating score -->
                    <div class="text-center md:text-left shrink-0">
                        <div class="text-5xl font-extrabold text-slate-900 mb-1 font-heading">@ViewBag.SaoTrungBinh</div>
                        <div class="flex text-amber-400 text-sm mb-1">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star"></i>
                            }
                        </div>
                        <p class="text-xs text-slate-500">Dựa trên <strong>@ViewBag.SoLuotDanhGia</strong> đánh giá</p>
                    </div>

                    <!-- Rating Progress Bars -->
                    <div class="w-full max-w-sm space-y-1.5">
                        @for (int starNum = 5; starNum >= 1; starNum--)
                        {
                            int countForStar = starNum == 5 ? r5 : (starNum == 4 ? r4 : (starNum == 3 ? r3 : (starNum == 2 ? r2 : r1)));
                            int pct = rTotal > 0 ? (countForStar * 100 / rTotal) : (starNum == 5 ? 100 : 0);
                            <div class="flex items-center gap-2 text-xs">
                                <span class="w-10 text-slate-600 font-semibold text-right">@starNum sao</span>
                                <div class="flex-1 bg-slate-200 rounded-full h-1.5 overflow-hidden">
                                    <div class="bg-amber-400 h-full rounded-full" style="width: @pct%;"></div>
                                </div>
                                <span class="w-8 text-slate-400 text-right">@pct%</span>
                            </div>
                        }
                    </div>

                    <!-- Write Review Button -->
                    <div class="shrink-0 text-center">
                        <button onclick="toggleReviewForm()" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm transition-all shadow-xs active:scale-95 flex items-center gap-2">
                            <i class="fas fa-pen-nib text-xs"></i>
                            <span>Viết đánh giá</span>
                        </button>
                    </div>
                </div>

                <!-- Review Form (Collapsed by default) -->
                <div id="reviewForm" class="bg-slate-50 border border-slate-200 rounded-2xl p-6 mb-8 hidden">
                    <h3 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-star text-amber-400"></i>
                        Đánh giá sản phẩm
                    </h3>

                    <form id="submitReviewForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sanPhamId" value="@Model.SanPham.Id" />

                        <!-- Star Rating -->
                        <div class="mb-5">
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                Chọn mức độ hài lòng <span class="text-rose-500">*</span>
                            </label>
                            <div class="flex items-center gap-3">
                                <div class="flex gap-1 text-2xl text-slate-300 cursor-pointer" id="starRating">
                                    <i class="far fa-star hover:text-amber-400 transition-colors star-icon" data-rating="1"></i>
                                    <i class="far fa-star hover:text-amber-400 transition-colors star-icon" data-rating="2"></i>
                                    <i class="far fa-star hover:text-amber-400 transition-colors star-icon" data-rating="3"></i>
                                    <i class="far fa-star hover:text-amber-400 transition-colors star-icon" data-rating="4"></i>
                                    <i class="far fa-star hover:text-amber-400 transition-colors star-icon" data-rating="5"></i>
                                </div>
                                <span class="text-xs font-bold text-slate-700" id="ratingText">Chưa chọn</span>
                            </div>
                            <input type="hidden" name="sao" id="ratingValue" value="0" required />
                        </div>

                        <!-- Name -->
                        <div class="mb-4">
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                                Họ và tên <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="tenNguoiGui" required
                                   class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-all @(user != null ? "bg-slate-100" : "")"
                                   placeholder="Nhập họ tên của bạn"
                                   value="@(user != null ? user.HoTen : "")"
                                   @(user != null ? Html.Raw("readonly") : Html.Raw("")) />
                        </div>

                        <!-- Email -->
                        <div class="mb-4">
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                                Email (Không bắt buộc)
                            </label>
                            <input type="email" name="email"
                                   class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-all @(user != null ? "bg-slate-100" : "")"
                                   placeholder="email@example.com"
                                   value="@(user != null ? user.Email : "")"
                                   @(user != null ? Html.Raw("readonly") : Html.Raw("")) />
                        </div>

                        <!-- Content -->
                        <div class="mb-5">
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                                Nội dung nhận xét <span class="text-rose-500">*</span>
                            </label>
                            <textarea name="noiDung" rows="3" required
                                      class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-all resize-none"
                                      placeholder="Hãy chia sẻ cảm nhận thực tế về chất lượng sản phẩm..."></textarea>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="flex items-center gap-3">
                            <button type="submit" class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl text-xs sm:text-sm transition-all shadow-xs">
                                Gửi đánh giá
                            </button>
                            <button type="button" onclick="toggleReviewForm()" class="px-5 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-xl text-xs sm:text-sm transition-colors">
                                Hủy bỏ
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Reviews List -->
                <div id="reviewsList" class="space-y-4">
                    @if (ViewBag.ListDanhGia != null && ((IEnumerable<dynamic>)ViewBag.ListDanhGia).Any())
                    {
                        foreach (var review in (IEnumerable<dynamic>)ViewBag.ListDanhGia)
                        {
                            <div class="p-5 rounded-2xl bg-slate-50/60 border border-slate-100 flex items-start gap-4">
                                <!-- Avatar Letter -->
                                <div class="w-10 h-10 rounded-full bg-slate-200 text-slate-700 font-bold flex items-center justify-center text-sm shrink-0">
                                    @(review.TenNguoiGui != null && review.TenNguoiGui.Length > 0 ? review.TenNguoiGui.Substring(0, 1).ToUpper() : "U")
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-2 mb-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-slate-900 text-sm">@review.TenNguoiGui</span>
                                            <span class="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-semibold border border-emerald-200/60">
                                                <i class="fas fa-check-circle text-[9px] mr-1"></i>Đã mua hàng
                                            </span>
                                        </div>
                                        <span class="text-[11px] text-slate-400">
                                            @(review.NgayTao != null ? ((DateTime)review.NgayTao).ToString("dd/MM/yyyy") : "")
                                        </span>
                                    </div>
                                    <!-- Stars -->
                                    <div class="flex text-amber-400 text-xs mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= (review.Sao ?? 0))
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-slate-300"></i>
                                            }
                                        }
                                    </div>
                                    <p class="text-slate-600 text-sm leading-relaxed">@review.NoiDung</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-12 text-slate-400">
                            <i class="far fa-comment-dots text-3xl mb-2"></i>
                            <p class="text-sm">Chưa có đánh giá nào cho sản phẩm này.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products Section (Clean Minimalist Grid) -->
    @if (Model.SanPhamLienQuan != null && Model.SanPhamLienQuan.Any())
    {
        <div class="mt-12 mb-8">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 font-heading tracking-tight">Sản phẩm liên quan</h2>
                    <p class="text-xs text-slate-400 mt-0.5">Khám phá các sản phẩm cùng danh mục bạn có thể thích</p>
                </div>
                <a href="@Url.Action("Index", "SanPham", new { danhMucId = Model.SanPham.DanhMucId })" class="text-xs font-bold text-teal-600 hover:text-teal-700 flex items-center gap-1 transition-colors">
                    <span>Xem tất cả</span>
                    <i class="fas fa-arrow-right text-[10px]"></i>
                </a>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-5">
                @foreach (var sp in Model.SanPhamLienQuan.Take(5))
                {
                    <div class="bg-white rounded-2xl border border-slate-200/80 hover:border-slate-300 hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col group p-3">
                        <a href="@Url.Action("ChiTietSP", "SanPham", new { id = sp.Id })" class="block flex-1 flex flex-col">
                            <!-- Image Frame -->
                            <div class="aspect-square bg-slate-50/70 rounded-xl p-3 flex items-center justify-center relative overflow-hidden mb-3">
                                @if (!string.IsNullOrEmpty(sp.HinhAnh))
                                {
                                    <img src="@Url.Content("~/Content/Images/" + sp.HinhAnh)" 
                                         alt="@sp.TenSanPham" 
                                         class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/Content/Images/no-image.png")" 
                                         alt="No image" 
                                         class="w-full h-full object-contain opacity-40" />
                                }
                                @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai < sp.Gia)
                                {
                                    <span class="absolute top-2 left-2 bg-rose-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-2xs z-10">
                                        -@Math.Round((decimal)(1 - (sp.GiaKhuyenMai.Value / sp.Gia.Value)) * 100)%
                                    </span>
                                }

                                <!-- Quick View Button -->
                                <button type="button" onclick="openQuickView(@sp.Id); return false;" title="Xem nhanh" class="absolute top-2 right-2 w-7 h-7 sm:w-8 sm:h-8 bg-white/90 hover:bg-teal-600 text-slate-700 hover:text-white rounded-full shadow-md backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-200 transform scale-90 group-hover:scale-100 z-20">
                                    <i class="fas fa-eye text-xs"></i>
                                </button>
                            </div>

                            <!-- Title -->
                            <h3 class="text-xs font-bold text-slate-800 line-clamp-2 leading-snug group-hover:text-teal-600 transition-colors mb-2 min-h-[2.2rem]">
                                @sp.TenSanPham
                            </h3>

                            <!-- Price -->
                            <div class="mt-auto">
                                @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai < sp.Gia)
                                {
                                    <div class="flex items-baseline gap-1.5">
                                        <span class="text-sm font-extrabold text-rose-600">@String.Format("{0:0,0}", sp.GiaKhuyenMai.Value) đ</span>
                                        <span class="text-[11px] text-slate-400 line-through">@String.Format("{0:0,0}", sp.Gia.Value) đ</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm font-extrabold text-slate-900">@String.Format("{0:0,0}", sp.Gia ?? 0) đ</span>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- ==================== INTERACTIVE LIGHTBOX MODAL ==================== -->
<div id="imageLightbox" 
     class="fixed inset-0 z-[99999] bg-black/95 backdrop-blur-md hidden flex-col items-center justify-between p-4 md:p-8 select-none transition-all duration-300 opacity-0 pointer-events-none" 
     onclick="handleLightboxBackdropClick(event)">
    <!-- Lightbox Header -->
    <div class="w-full flex items-center justify-between text-white max-w-5xl z-10">
        <div class="flex items-center gap-3">
            <span class="font-bold text-sm font-heading line-clamp-1">@Model.SanPham.TenSanPham</span>
            <span id="lightboxCounter" class="bg-white/10 text-xs px-2.5 py-0.5 rounded-full font-medium">1 / @galleryImages.Count</span>
        </div>
        <button type="button" 
                onclick="closeLightbox()" 
                class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors" 
                title="Đóng (ESC)">
            <i class="fas fa-times text-base"></i>
        </button>
    </div>

    <!-- Lightbox Main Stage -->
    <div class="relative w-full max-w-4xl flex-1 flex items-center justify-center my-4 overflow-hidden">
        <button type="button" 
                onclick="prevLightboxImage(event)" 
                class="absolute left-2 sm:left-4 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all backdrop-blur-md" 
                title="Ảnh trước">
            <i class="fas fa-chevron-left text-sm"></i>
        </button>

        <img id="lightboxMainImg" 
             src="@galleryImages[0]" 
             alt="@Model.SanPham.TenSanPham" 
             class="max-h-[72vh] max-w-full object-contain transition-all duration-300 select-none drop-shadow-2xl" />

        <button type="button" 
                onclick="nextLightboxImage(event)" 
                class="absolute right-2 sm:right-4 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all backdrop-blur-md" 
                title="Ảnh kế tiếp">
            <i class="fas fa-chevron-right text-sm"></i>
        </button>
    </div>

    <!-- Thumbnails Strip inside Lightbox -->
    <div class="w-full max-w-xl flex items-center justify-center gap-2 overflow-x-auto py-2 z-10">
        @for (int i = 0; i < galleryImages.Count; i++)
        {
            var p = galleryImages[i];
            <div onclick="setLightboxIndex(@i)" 
                 class="lightbox-thumb-item w-14 h-14 rounded-xl border-2 @(i == 0 ? "border-white scale-105" : "border-white/20 opacity-50 hover:opacity-100") bg-white/5 overflow-hidden cursor-pointer shrink-0 transition-all flex items-center justify-center p-1" 
                 data-index="@i">
                <img src="@p" alt="Thumb" class="w-full h-full object-contain pointer-events-none" />
            </div>
        }
    </div>
</div>


<!-- ==================== CUSTOM TOAST CONTAINER ==================== -->
<div id="customToastContainer" class="fixed bottom-20 sm:bottom-24 right-4 sm:right-6 z-[99998] pointer-events-none flex flex-col gap-2 max-w-sm w-full"></div>

<!-- ==================== JAVASCRIPT LOGIC ==================== -->
<script>
    const productGallery = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(galleryImages ?? new List<string>()));
    let currentGalleryIndex = 0;

    // Thumbnail switching
    function selectThumbnail(index, el) {
        if (index < 0 || index >= productGallery.length) return;
        currentGalleryIndex = index;
        $('#mainImage').attr('src', productGallery[index]);

        $('.thumbnail-image').removeClass('border-slate-900 ring-2 ring-slate-900/10').addClass('border-slate-200/80 opacity-70');
        if (el) {
            $(el).removeClass('border-slate-200/80 opacity-70').addClass('border-slate-900 ring-2 ring-slate-900/10 opacity-100');
        }
    }

    // Lightbox handlers
    function openLightbox(index) {
        if (index !== undefined && index >= 0 && index < productGallery.length) {
            currentGalleryIndex = index;
        }
        updateLightboxUI();

        const lb = document.getElementById('imageLightbox');
        lb.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
        lb.classList.add('flex', 'opacity-100');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        const lb = document.getElementById('imageLightbox');
        lb.classList.remove('opacity-100');
        lb.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
            lb.classList.remove('flex');
            lb.classList.add('hidden');
            document.body.style.overflow = '';
        }, 250);
    }

    function handleLightboxBackdropClick(e) {
        if (e.target.id === 'imageLightbox') closeLightbox();
    }

    function nextLightboxImage(e) {
        if (e) e.stopPropagation();
        currentGalleryIndex = (currentGalleryIndex + 1) % productGallery.length;
        updateLightboxUI();
    }

    function prevLightboxImage(e) {
        if (e) e.stopPropagation();
        currentGalleryIndex = (currentGalleryIndex - 1 + productGallery.length) % productGallery.length;
        updateLightboxUI();
    }

    function setLightboxIndex(idx) {
        currentGalleryIndex = idx;
        updateLightboxUI();
    }

    function updateLightboxUI() {
        const img = document.getElementById('lightboxMainImg');
        if (img) {
            img.style.opacity = '0.5';
            setTimeout(() => {
                img.src = productGallery[currentGalleryIndex];
                img.style.opacity = '1';
            }, 100);
        }

        const counter = document.getElementById('lightboxCounter');
        if (counter) counter.innerText = (currentGalleryIndex + 1) + ' / ' + productGallery.length;

        $('.lightbox-thumb-item').each(function(i) {
            if (i === currentGalleryIndex) {
                $(this).removeClass('border-white/20 opacity-50').addClass('border-white scale-105 opacity-100');
            } else {
                $(this).removeClass('border-white scale-105 opacity-100').addClass('border-white/20 opacity-50');
            }
        });
    }

    // Keyboard ESC & Arrows
    $(document).on('keydown', function(e) {
        const lb = document.getElementById('imageLightbox');
        if (lb && !lb.classList.contains('hidden')) {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowRight') nextLightboxImage();
            if (e.key === 'ArrowLeft') prevLightboxImage();
        }
    });


    // Quantity controls
    function incrementQty() {
        var input = document.getElementById('quantity');
        var currentValue = parseInt(input.value) || 1;
        var maxValue = parseInt(input.max) || 999;
        if (currentValue < maxValue) {
            input.value = currentValue + 1;
        } else {
            showCustomToast('Số lượng', 'Đã đạt giới hạn số lượng trong kho', 'warning');
        }
    }

    function decrementQty() {
        var input = document.getElementById('quantity');
        var currentValue = parseInt(input.value) || 1;
        var minValue = parseInt(input.min) || 1;
        if (currentValue > minValue) {
            input.value = currentValue - 1;
        }
    }

    function validateQuantity() {
        var input = document.getElementById('quantity');
        var value = parseInt(input.value);
        var max = parseInt(input.max) || 999;
        var min = parseInt(input.min) || 1;
        if (isNaN(value) || value < min) input.value = min;
        else if (value > max) {
            input.value = max;
            showCustomToast('Số lượng', 'Đã đạt giới hạn số lượng trong kho', 'warning');
        }
    }

    // Color Swatches Change
    $(document).ready(function() {
        $('input[name="color"]').on('change', function() {
            var colorVal = $(this).val();
            var colorName = $(this).data('color-name') || colorVal;
            $('#selectedColor').val(colorVal);
            $('#selectedColorName').text(colorName);
            $('#stickyColorBadge').text('• Màu: ' + colorName);
        });
    });

    // Wishlist Toggle
    function toggleWishlist(productId) {
        let wishlist = [];
        try {
            wishlist = JSON.parse(localStorage.getItem('user_wishlist') || '[]');
        } catch(e) { wishlist = []; }

        const idx = wishlist.indexOf(productId);
        const icon = document.getElementById('wishlistHeartIcon');
        const text = document.getElementById('wishlistText');

        if (idx > -1) {
            wishlist.splice(idx, 1);
            if (icon) icon.className = 'far fa-heart text-sm transition-transform duration-200';
            if (text) text.innerText = 'Thêm vào yêu thích';
            showCustomToast('Yêu thích', 'Đã bỏ sản phẩm khỏi danh sách yêu thích.', 'info');
        } else {
            wishlist.push(productId);
            if (icon) icon.className = 'fas fa-heart text-rose-500 text-sm scale-110 transition-transform duration-200';
            if (text) text.innerText = 'Đã lưu yêu thích';
            showCustomToast('Yêu thích', 'Đã thêm sản phẩm vào danh sách yêu thích!', 'success');
        }
        localStorage.setItem('user_wishlist', JSON.stringify(wishlist));
    }

    $(document).ready(function() {
        try {
            const currentSpId = parseInt('@Model.SanPham.Id') || 0;
            if (wishlist.includes(currentSpId)) {
                const icon = document.getElementById('wishlistHeartIcon');
                const text = document.getElementById('wishlistText');
                if (icon) icon.className = 'fas fa-heart text-rose-500 text-sm';
                if (text) text.innerText = 'Đã lưu yêu thích';
            }
        } catch(e) {}
    });

    // Share Product
    function shareProduct() {
        const url = window.location.href;
        if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(() => {
                showCustomToast('Chia sẻ', 'Đã sao chép liên kết vào bộ nhớ tạm.', 'success');
            });
        }
    }

    // Custom Toast
    function showCustomToast(title, message, type) {
        const container = document.getElementById('customToastContainer');
        if (!container) return;

        let icon = '<i class="fas fa-check text-emerald-500 text-xs"></i>';
        if (type === 'warning') icon = '<i class="fas fa-exclamation text-amber-500 text-xs"></i>';
        if (type === 'error') icon = '<i class="fas fa-times text-rose-500 text-xs"></i>';
        if (type === 'info') icon = '<i class="fas fa-info text-blue-500 text-xs"></i>';

        const toast = document.createElement('div');
        toast.className = 'pointer-events-auto bg-slate-900/95 backdrop-blur-md text-white shadow-xl rounded-2xl p-3 flex items-center gap-3 transition-all duration-300 transform translate-y-3 opacity-0 text-xs';
        toast.innerHTML = `
            <div class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center shrink-0">${icon}</div>
            <div class="flex-1 min-w-0">
                <p class="font-bold leading-tight">${title}</p>
                <p class="text-slate-300 text-[11px] truncate">${message}</p>
            </div>
            <button type="button" class="text-slate-400 hover:text-white p-1" onclick="this.parentElement.remove()">
                <i class="fas fa-times text-[10px]"></i>
            </button>
        `;
        container.appendChild(toast);

        requestAnimationFrame(() => {
            toast.classList.remove('translate-y-3', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
        });

        setTimeout(() => {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => toast.remove(), 250);
        }, 3200);
    }

    // Tabs switching
    $(document).ready(function() {
        $('.tab-button').on('click', function() {
            var tabName = $(this).data('tab');
            $('.tab-button').removeClass('active bg-white shadow-xs text-slate-900 font-bold')
                .addClass('text-slate-500 hover:text-slate-900 font-semibold');

            $(this).removeClass('text-slate-500 hover:text-slate-900 font-semibold')
                .addClass('active bg-white shadow-xs text-slate-900 font-bold');

            $('.tab-content').addClass('hidden');
            $('#' + tabName + '-tab').removeClass('hidden');
        });
    });

    // Add to Cart
    $('form[action*="ThemVaoGioHang"]').on('submit', function(e) {
        e.preventDefault();

        var productId = parseInt('@Model.SanPham.Id') || 0;
        var quantity = parseInt($('#quantity').val()) || 1;
        var color = $('#selectedColor').val();

        $.ajax({
            url: '@Url.Action("AddToCart", "GioHang")',
            type: 'POST',
            data: { productId: productId, quantity: quantity, color: color },
            success: function(response) {
                if (response.success) {
                    if (typeof updateCartCount === 'function') updateCartCount(response.cartCount);
                    showCustomToast('Thành công', 'Đã thêm sản phẩm vào giỏ hàng.', 'success');
                    if (typeof openSideCart === 'function') {
                        openSideCart();
                    } else {
                        window.location.href = '@Url.Action("Index", "GioHang")';
                    }
                } else if (response.requireLogin) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Vui lòng đăng nhập!',
                        text: response.message,
                        showCancelButton: true,
                        confirmButtonText: 'Đăng nhập',
                        cancelButtonText: 'Hủy'
                    }).then((r) => {
                        if (r.isConfirmed) $('#authModal').modal('show');
                    });
                } else {
                    showCustomToast('Lỗi', response.message, 'error');
                }
            },
            error: function() {
                showCustomToast('Lỗi', 'Không thể kết nối máy chủ.', 'error');
            }
        });
    });

    // Buy Now
    function buyNow() {
        var productId = parseInt('@Model.SanPham.Id') || 0;
        var quantity = parseInt($('#quantity').val()) || 1;
        var color = $('#selectedColor').val();

        $.ajax({
            url: '@Url.Action("AddToCart", "GioHang")',
            type: 'POST',
            data: { productId: productId, quantity: quantity, color: color },
            success: function(response) {
                if (response.success) {
                    window.location.href = '@Url.Action("Index", "ThanhToan")';
                } else if (response.requireLogin) {
                    $('#authModal').modal('show');
                } else {
                    showCustomToast('Lỗi', response.message, 'error');
                }
            }
        });
    }

    // Review Form Toggle & Stars
    function toggleReviewForm() {
        $('#reviewForm').slideToggle(250);
    }

    var selectedRating = 0;
    var ratingTexts = ['', 'Rất tệ', 'Tệ', 'Bình thường', 'Hài lòng', 'Tuyệt vời'];

    $('.star-icon').hover(
        function() {
            var rating = $(this).data('rating');
            highlightStars(rating);
            $('#ratingText').text(ratingTexts[rating]);
        },
        function() {
            highlightStars(selectedRating);
            $('#ratingText').text(selectedRating > 0 ? ratingTexts[selectedRating] : 'Chưa chọn');
        }
    );

    $('.star-icon').click(function() {
        selectedRating = $(this).data('rating');
        $('#ratingValue').val(selectedRating);
        highlightStars(selectedRating);
        $('#ratingText').text(ratingTexts[selectedRating]);
    });

    function highlightStars(rating) {
        $('.star-icon').each(function(index) {
            if (index < rating) {
                $(this).removeClass('far text-slate-300').addClass('fas text-amber-400');
            } else {
                $(this).removeClass('fas text-amber-400').addClass('far text-slate-300');
            }
        });
    }

    $('#submitReviewForm').on('submit', function(e) {
        e.preventDefault();
        if (parseInt($('#ratingValue').val()) < 1) {
            showCustomToast('Đánh giá', 'Vui lòng chọn số sao đánh giá', 'warning');
            return;
        }

        $.ajax({
            url: '@Url.Action("ThemDanhGia", "SanPham")',
            type: 'POST',
            data: $(this).serialize(),
            success: function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    showCustomToast('Lỗi', response.message, 'error');
                }
            }
        });
    });
</script>

