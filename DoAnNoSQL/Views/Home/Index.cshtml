@section scripts {
    <script>
    // ========== AUTHENTICATION CHECK ==========
    var isUserAuthenticated = '@(Request.IsAuthenticated ? "true" : "false")' === 'true';

    function checkLogin() {
        if (!isUserAuthenticated) {
            Swal.fire({
                icon: 'warning',
                title: 'Vui lòng đăng nhập!',
                text: 'Bạn cần đăng nhập để thêm sản phẩm vào giỏ hàng',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-sign-in-alt mr-2"></i>Đăng nhập',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#6b7280'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#authModal').modal('show');
                }
            });
            return false;
        }
        return true;
    }

    // ========== ADD TO CART FUNCTION ==========
    function addToCart(productId, productName, price, image) {
        // Show loading (không check frontend nữa, để backend handle)
        Swal.fire({
            title: 'Đang xử lý...',
            html: 'Vui lòng đợi trong giây lát',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '@Url.Action("AddToCart", "GioHang")',
            type: 'POST',
            data: {
                productId: productId,
                quantity: 1,
                color: ''
            },
            success: function(response) {
                Swal.close();

                if (response.success) {
                    // Show success with product info
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        html: `
                            <div class="text-left">
                                <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg mb-4">
                                    <img src="${image}" alt="${productName}" class="w-20 h-20 object-contain rounded border">
                                    <div>
                                        <p class="font-semibold text-gray-900">${productName}</p>
                                        <p class="text-sm text-gray-600">Giá: ${formatCurrency(price)}</p>
                                        <p class="text-sm text-blue-600">Số lượng: 1</p>
                                    </div>
                                </div>
                                <p class="text-center text-gray-700">Sản phẩm đã được thêm vào giỏ hàng!</p>
                                <p class="text-center text-sm text-gray-500 mt-2">Tổng: <strong>${response.cartCount}</strong> sản phẩm - <strong>${formatCurrency(response.cartTotal)}</strong></p>
                            </div>
                        `,
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-shopping-cart mr-2"></i>Xem giỏ hàng',
                        cancelButtonText: '<i class="fas fa-shopping-bag mr-2"></i>Tiếp tục mua',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#6b7280',
                        customClass: {
                            popup: 'rounded-xl',
                            confirmButton: 'px-6 py-3 rounded-lg font-bold',
                            cancelButton: 'px-6 py-3 rounded-lg font-bold'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            if (typeof openSideCart === 'function') {
                                openSideCart();
                            } else {
                                window.location.href = '@Url.Action("Index", "GioHang")';
                            }
                        }
                    });

                    // Update cart count in header (if exists)
                    updateCartCount(response.cartCount);
                } else if (response.requireLogin) {
                    // User not logged in (backend check)
                    Swal.fire({
                        icon: 'warning',
                        title: 'Vui lòng đăng nhập!',
                        text: response.message,
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-sign-in-alt mr-2"></i>Đăng nhập',
                        cancelButtonText: 'Hủy',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#6b7280'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $('#authModal').modal('show');
                        }
                    });
                } else {
                    // Other errors
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: response.message,
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#ef4444'
                    });
                }
            },
            error: function(xhr, status, error) {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Có lỗi xảy ra. Vui lòng thử lại sau.',
                    confirmButtonText: 'Đóng',
                    confirmButtonColor: '#ef4444'
                });
            }
        });
    }

    // ========== HELPER FUNCTIONS ==========

    // Format currency
    function formatCurrency(amount) {
        return new Intl.NumberFormat('vi-VN').format(amount) + ' đ';
    }

    // Update cart count in header
    function updateCartCount(count) {
        $('.cart-count').text(count);
        $('.cart-badge').text(count);

        // Add animation
        $('.cart-count, .cart-badge').addClass('animate-pulse');
        setTimeout(function() {
            $('.cart-count, .cart-badge').removeClass('animate-pulse');
        }, 1000);
    }

    // ========== PAGE LOAD ==========
    $(document).ready(function() {
        // Product slider
        $('.product-slider').each(function() {
            var slider = $(this);
            var slides = slider.find('.product-slides');
            var prevBtn = slider.find('.prev-btn');
            var nextBtn = slider.find('.next-btn');
            var scrollAmount = 300;

            prevBtn.click(function() {
                slides.animate({scrollLeft: '-=' + scrollAmount}, 300);
            });

            nextBtn.click(function() {
                slides.animate({scrollLeft: '+=' + scrollAmount}, 300);
            });
        });

        // ========== MEGA MENU DANH MỤC NGANG ==========
        var megaTimer = null;
        var megaCache = {};
        var imgBase = '@Url.Content("~/Content/Images/")';

        // Di chuyển panel ra ngoài body để tọa độ absolute luôn chính xác tuyệt đối
        $('#megaMenuPanel').appendTo('body');

        var $panel = $('#megaMenuPanel');
        var $panelTitle = $('#megaMenuTitle');
        var $panelViewAll = $('#megaMenuViewAll');
        var $panelBrands = $('#megaMenuBrands');
        var $panelProducts = $('#megaMenuProducts');

        function positionPanel($item) {
            var rect = $item[0].getBoundingClientRect();
            var panelW = 560; // based on width
            var left = rect.left;

            // Nếu tràn mép phải màn hình thì dịch sang trái
            if (left + panelW > window.innerWidth - 20) {
                left = window.innerWidth - panelW - 20;
            }
            if (left < 16) left = 16;

            // Căn top ngay bên dưới mục danh mục
            $panel.css({
                top: rect.bottom + window.scrollY + 8,
                left: left,
                height: 'auto',
                maxHeight: '420px'
            });
        }

        var $panelPrices = $('#megaMenuPrices');
        var currentDmUrl = '#';

        function renderMegaMenu(data) {
            // --- Thương hiệu: list dọc với logo + tên + (số lượng) ---
            if (!data.thuongHieu || data.thuongHieu.length === 0) {
                $panelBrands.html('<div style="color:#9ca3af;font-size:12px;padding:8px 0;">Không có dữ liệu hãng</div>');
            } else {
                var bHtml = '';
                $.each(data.thuongHieu, function(i, th) {
                    var logoHtml = th.hinhAnh
                        ? '<img src="' + imgBase + th.hinhAnh + '" alt="' + th.ten + '" style="width:20px;height:20px;object-fit:contain;margin-right:8px;flex-shrink:0;">'
                        : '<span style="width:20px;height:20px;margin-right:8px;flex-shrink:0;"></span>';
                    var href = currentDmUrl + (currentDmUrl.indexOf('?') > -1 ? '&' : '?') + 'thuongHieuId=' + th.id;
                    // build proper URL
                    var dmIdVal = currentDmUrl.match(/danhMucId=(\d+)/);
                    if (dmIdVal) {
                        href = '@Url.Action("Index", "SanPham")' + '?danhMucId=' + dmIdVal[1] + '&thuongHieuId=' + th.id;
                    } else {
                        href = '@Url.Action("Index", "SanPham")' + '?thuongHieuId=' + th.id;
                    }
                    bHtml += '<a href="' + href + '" ' +
                        'style="display:flex;align-items:center;padding:6px 8px;border-radius:7px;text-decoration:none;color:#374151;transition:background .12s;"' +
                        ' onmouseenter="this.style.background=\'#eff6ff\';this.style.color=\'#2563eb\';"' +
                        ' onmouseleave="this.style.background=\'\';this.style.color=\'#374151\';">' +
                        logoHtml +
                        '<span style="font-size:13px;font-weight:500;flex:1;">' + th.ten + '</span>' +
                        '</a>';
                });
                $panelBrands.html(bHtml);
            }

            // --- Mức giá ---
            if (!data.mucGia || data.mucGia.length === 0) {
                $panelPrices.html('');
            } else {
                var pHtml = '';
                var dmIdVal2 = currentDmUrl.match(/danhMucId=(\d+)/);
                $.each(data.mucGia, function(i, mg) {
                    var params = dmIdVal2 ? 'danhMucId=' + dmIdVal2[1] : '';
                    if (mg.giaMin != null) params += (params ? '&' : '') + 'giaMin=' + mg.giaMin;
                    if (mg.giaMax != null) params += (params ? '&' : '') + 'giaMax=' + mg.giaMax;
                    var href = '@Url.Action("Index", "SanPham")' + (params ? '?' + params : '');
                    pHtml += '<a href="' + href + '" ' +
                        'style="display:flex;align-items:center;padding:6px 8px;border-radius:7px;text-decoration:none;color:#374151;transition:background .12s;"' +
                        ' onmouseenter="this.style.background=\'#eff6ff\';this.style.color=\'#2563eb\';"' +
                        ' onmouseleave="this.style.background=\'\';this.style.color=\'#374151\';">' +
                        '<i class="fas fa-dollar-sign" style="color:#3b82f6;margin-right:8px;font-size:12px;width:14px;"></i>' +
                        '<span style="font-size:13px;">' + mg.nhan + '</span>' +
                        '</a>';
                });
                $panelPrices.html(pHtml);
            }
        }

        function showMegaMenu($item) {
            var dmId   = $item.data('id');
            var dmTen  = $item.data('ten');
            var dmUrl  = $item.data('url');

            // Cập nhật header
            currentDmUrl = dmUrl;
            $panelTitle.text(dmTen);
            $panelViewAll.attr('href', dmUrl);

            // Position
            positionPanel($item);

            // Highlight row
            $('.danh-muc-item .dm-row').css({ background: '', color: '' });
            $item.find('.dm-row').css({ background: '#eff6ff', color: '#2563eb' });

            // Đã cache?
            if (megaCache[dmId]) {
                $panel.stop(true, true).css('display', 'flex').hide().fadeIn(150);
                renderMegaMenu(megaCache[dmId]);
                return;
            }

            // Hiện loading
            $panel.stop(true, true).css('display', 'flex').hide().fadeIn(150);
            $panelBrands.html('<div style="text-align:center;padding:20px 0;color:#9ca3af;font-size:12px;"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>');
            $panelPrices.html('<div style="text-align:center;padding:20px 0;color:#9ca3af;font-size:12px;"><i class="fas fa-spinner fa-spin"></i></div>');

            $.ajax({
                url: '@Url.Action("GetSanPhamTheoDanhMuc", "Home")',
                data: { danhMucId: dmId },
                type: 'GET',
                success: function(data) {
                    megaCache[dmId] = data;
                    renderMegaMenu(data);
                },
                error: function() {
                    $panelBrands.html('<div style="color:#ef4444;font-size:12px;padding:8px;">Lỗi tải dữ liệu</div>');
                    $panelPrices.html('');
                }
            });
        }

        function hideMegaMenu() {
            $panel.stop(true, true).fadeOut(150);
            $('.danh-muc-item .dm-row').css({ background: '', color: '' });
        }

        $('#danhMucList .danh-muc-item').on('mouseenter', function() {
            clearTimeout(megaTimer);
            showMegaMenu($(this));
        }).on('mouseleave', function() {
            megaTimer = setTimeout(hideMegaMenu, 120);
        });

        $panel.on('mouseenter', function() {
            clearTimeout(megaTimer);
        }).on('mouseleave', function() {
            megaTimer = setTimeout(hideMegaMenu, 120);
        });

    });
    </script>
}
