@model List<DoAnNoSQL.tb_TinTuc>

@{
    ViewBag.Title = "Tin tức & Sự kiện";
    var danhMucList = ViewBag.DanhMucTinList as List<DoAnNoSQL.tb_DanhMucTin> ?? new List<DoAnNoSQL.tb_DanhMucTin>();
    var tinNoiBat = ViewBag.TinNoiBat as List<DoAnNoSQL.tb_TinTuc> ?? new List<DoAnNoSQL.tb_TinTuc>();
    int currentDmId = ViewBag.DanhMucId != null ? (int)ViewBag.DanhMucId : 0;
    string currentSort = ViewBag.SortBy as string ?? "newest";
    string searchKeyword = ViewBag.SearchKeyword as string ?? "";
    bool isSearching = ViewBag.IsSearching == true;
    int totalNews = ViewBag.TotalNews != null ? (int)ViewBag.TotalNews : Model.Count;
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    string searchParam = !string.IsNullOrEmpty(searchKeyword) ? "&q=" + HttpUtility.UrlEncode(searchKeyword) : "";
    var currentDm = danhMucList.FirstOrDefault(d => d.Id == currentDmId);
}

<div class="max-w-7xl mx-auto pb-12">
    <!-- Breadcrumb -->
    <nav class="flex mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                    <i class="fas fa-home mr-2"></i>
                    Trang chủ
                </a>
            </li>
            @if (currentDmId > 0)
            {
                <li>
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                        <a href="@Url.Action("Index", "TinTuc")" class="text-sm font-medium text-gray-700 hover:text-blue-600">
                            Tin tức &amp; Sự kiện
                        </a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                        <span class="text-sm font-medium text-gray-500">@(currentDm?.TenDanhMuc ?? "Chuyên mục")</span>
                    </div>
                </li>
            }
            else
            {
                <li aria-current="page">
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                        <span class="text-sm font-medium text-gray-500">Tin tức &amp; Sự kiện</span>
                    </div>
                </li>
            }
        </ol>
    </nav>

    <!-- 3D Tech Magazine Header Banner -->
    <div class="page-header-3d border-beam-3d mb-8" data-aos="fade-down">
        <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-400/20 text-teal-200 border border-teal-400/30 mb-3 backdrop-blur-md">
                    <i class="fas fa-bolt text-amber-300"></i>
                    Bản tin công nghệ 24/7 
                </div>

                @if (isSearching)
                {
                    <h1 class="text-2xl sm:text-3xl md:text-4xl font-black font-heading text-white leading-tight mb-2">
                        Kết quả tìm kiếm: <span class="text-teal-300">"@searchKeyword"</span>
                    </h1>
                    <p class="text-sm sm:text-base text-slate-300">
                        Tìm thấy <strong class="text-teal-300 font-bold">@totalNews</strong> bài viết phù hợp với từ khóa của bạn.
                    </p>
                    <div class="mt-4">
                        <a href="@Url.Action("Index", "TinTuc")" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition border border-white/20">
                            <i class="fas fa-times"></i> Xóa bộ lọc tìm kiếm
                        </a>
                    </div>
                }
                else
                {
                    <h1 class="text-2xl sm:text-3xl md:text-4xl font-black font-heading text-white leading-tight mb-2">
                        TIN TỨC 
                    </h1>
                    <p class="text-sm sm:text-base text-slate-300">
                        Cập nhật các đột phá công nghệ mới nhất, đánh giá thiết bị chuyên sâu và hướng dẫn sử dụng tương tác.
                    </p>
                }
            </div>

            <!-- Stats Badge 3D -->
            <div class="flex items-center gap-3.5 self-start md:self-auto bg-white/10 backdrop-blur-md px-5 py-3.5 rounded-2xl border border-white/15 shadow-lg">
                <div class="w-12 h-12 rounded-xl bg-teal-400/25 border border-teal-300/40 flex items-center justify-center text-teal-200 text-xl shadow-md">
                    <i class="fas fa-newspaper"></i>
                </div>
                <div>
                    <div class="text-2xl font-black font-heading text-white leading-none">@totalNews</div>
                    <div class="text-xs text-slate-300 mt-1">Bài viết đã xuất bản</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Layout Grid: Nội dung chính (8 cột) + Sidebar (4 cột) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Main News Column (8 Cột) -->
        <main class="lg:col-span-8 space-y-6">
            
            <!-- Category Pills & Sort Bar Glass -->
            <div class="card-glass-3d p-4 sm:p-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    
                    <!-- Category Pills (Cuộn ngang tiện lợi) -->
                    <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0 scrollbar-none text-xs">
                        <a href="@Url.Action("Index", "TinTuc", new { danhMucId = 0, sortBy = currentSort, q = searchKeyword })" 
                           class="px-4 py-2 rounded-xl font-bold transition-all whitespace-nowrap @(currentDmId == 0 ? "bg-gradient-to-r from-teal-600 to-emerald-600 text-white shadow-md shadow-teal-600/30" : "bg-slate-100/80 text-slate-700 hover:bg-slate-200")">
                            Tất cả
                        </a>
                        @foreach (var dm in danhMucList)
                        {
                            <a href="@Url.Action("Index", "TinTuc", new { danhMucId = dm.Id, sortBy = currentSort, q = searchKeyword })" 
                               class="px-4 py-2 rounded-xl font-bold transition-all whitespace-nowrap @(currentDmId == dm.Id ? "bg-gradient-to-r from-teal-600 to-emerald-600 text-white shadow-md shadow-teal-600/30" : "bg-slate-100/80 text-slate-700 hover:bg-slate-200")">
                                @dm.TenDanhMuc
                            </a>
                        }
                    </div>

                    <!-- Sắp xếp Dropdown -->
                    <div class="flex items-center gap-2 self-end sm:self-auto flex-shrink-0">
                        <label for="sortBy" class="text-xs font-bold text-slate-500 whitespace-nowrap flex items-center gap-1">
                            <i class="fas fa-sort-amount-down text-teal-600"></i> Sắp xếp:
                        </label>
                        <select id="sortBy" class="px-3.5 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500/50 cursor-pointer">
                            <option value="newest" @(currentSort == "newest" ? "selected" : "")>Mới nhất</option>
                            <option value="popular" @(currentSort == "popular" ? "selected" : "")>Xem nhiều nhất</option>
                            <option value="oldest" @(currentSort == "oldest" ? "selected" : "")>Cũ nhất</option>
                            <option value="title_asc" @(currentSort == "title_asc" ? "selected" : "")>Tiêu đề A - Z</option>
                            <option value="title_desc" @(currentSort == "title_desc" ? "selected" : "")>Tiêu đề Z - A</option>
                        </select>
                    </div>

                </div>
            </div>

            <!-- News Grid Cards (3D Glass Cards) -->
            @if (Model.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    @foreach (var tin in Model)
                    {
                        var dmTen = tin.tb_DanhMucTin?.TenDanhMuc ?? tin.DanhMucTin?.TenDanhMuc ?? "Tin tức";
                        <article class="card-glass-3d flex flex-col justify-between overflow-hidden group hover:-translate-y-2 transition-all duration-300" data-aos="fade-up">
                            
                            <div>
                                <!-- Image Container with Floating Badge -->
                                <div class="relative overflow-hidden aspect-[16/10] bg-slate-100 rounded-2xl m-3 mb-0">
                                    @if (!string.IsNullOrEmpty(tin.HinhAnh))
                                    {
                                        <img src="@Url.Content("~/Content/Images/" + tin.HinhAnh)" 
                                             alt="@tin.TieuDe" 
                                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
                                             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=600&q=80';" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full flex items-center justify-center text-slate-300 bg-slate-100">
                                            <i class="fas fa-newspaper text-4xl"></i>
                                        </div>
                                    }

                                    <!-- Floating Category Pill -->
                                    <div class="absolute top-3 left-3">
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-white/90 text-teal-800 shadow-md backdrop-blur-md border border-white/60">
                                            @dmTen
                                        </span>
                                    </div>

                                    @if (tin.LuotXem.HasValue && tin.LuotXem > 0)
                                    {
                                        <div class="absolute top-3 right-3">
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-900/70 text-white backdrop-blur-md">
                                                <i class="far fa-eye mr-1 text-teal-300"></i>@tin.LuotXem.Value
                                            </span>
                                        </div>
                                    }
                                </div>

                                <!-- Card Content -->
                                <div class="p-5 pt-4">
                                    <!-- Date & Author -->
                                    <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2">
                                        <span class="flex items-center gap-1">
                                            <i class="far fa-calendar-alt text-teal-500"></i>
                                            @(tin.NgayTao?.ToString("dd/MM/yyyy") ?? "Mới đăng")
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <i class="far fa-user text-teal-500"></i>
                                            @(string.IsNullOrEmpty(tin.NguoiTao) ? "Admin" : tin.NguoiTao)
                                        </span>
                                    </div>

                                    <!-- Title -->
                                    <h2 class="text-sm sm:text-base font-bold font-heading text-slate-900 group-hover:text-teal-600 transition-colors line-clamp-2 leading-snug mb-2">
                                        <a href="@Url.Action("ChiTiet", "TinTuc", new { id = tin.Id })">
                                            @if (isSearching)
                                            {
                                                @HighlightKeyword(tin.TieuDe, searchKeyword)
                                            }
                                            else
                                            {
                                                @tin.TieuDe
                                            }
                                        </a>
                                    </h2>

                                    <!-- Short Description -->
                                    @if (!string.IsNullOrEmpty(tin.MoTa))
                                    {
                                        <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                                            @if (isSearching)
                                            {
                                                @HighlightKeyword(tin.MoTa, searchKeyword)
                                            }
                                            else
                                            {
                                                @tin.MoTa
                                            }
                                        </p>
                                    }
                                </div>
                            </div>

                            <!-- Card Footer Action -->
                            <div class="px-5 py-3 border-t border-slate-100 flex items-center justify-between">
                                <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Công nghệ 4.0</span>
                                <a href="@Url.Action("ChiTiet", "TinTuc", new { id = tin.Id })" 
                                   class="inline-flex items-center gap-1.5 text-xs font-black text-teal-600 group-hover:text-teal-700 group-hover:translate-x-1 transition-all">
                                    Đọc tiếp <i class="fas fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>

                        </article>
                    }
                </div>

                <!-- Phân trang hiện đại -->
                if (totalPages > 1)
                {
                    <div class="flex justify-center items-center gap-2 pt-6">
                        @if (currentPage > 1)
                        {
                            <a href="?danhMucId=@currentDmId&sortBy=@currentSort@searchParam&page=@(currentPage - 1)" 
                               class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-teal-50 hover:text-teal-700 hover:border-teal-300 transition shadow-xs">
                                <i class="fas fa-chevron-left text-xs"></i>
                            </a>
                        }

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <a href="?danhMucId=@currentDmId&sortBy=@currentSort@searchParam&page=@i" 
                               class="w-10 h-10 flex items-center justify-center rounded-xl font-bold text-sm transition-all @(i == currentPage ? "bg-teal-600 text-white shadow-md shadow-teal-600/30" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-100")">
                                @i
                            </a>
                        }

                        @if (currentPage < totalPages)
                        {
                            <a href="?danhMucId=@currentDmId&sortBy=@currentSort@searchParam&page=@(currentPage + 1)" 
                               class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-teal-50 hover:text-teal-700 hover:border-teal-300 transition shadow-xs">
                                <i class="fas fa-chevron-right text-xs"></i>
                            </a>
                        }
                    </div>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="bg-white rounded-3xl p-12 text-center border border-slate-200/90 shadow-soft">
                    <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mx-auto mb-4 text-2xl">
                        <i class="fas fa-newspaper"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 font-heading mb-2">Chưa có bài viết nào</h3>
                    <p class="text-sm text-slate-500 max-w-md mx-auto mb-6">
                        @if (isSearching)
                        {
                            <span>Không tìm thấy bài viết nào phù hợp với từ khóa "<strong>@searchKeyword</strong>". Vui lòng thử từ khóa khác.</span>
                        }
                        else
                        {
                            <span>Chuyên mục này hiện chưa có bài viết. Vui lòng quay lại sau!</span>
                        }
                    </p>
                    <a href="@Url.Action("Index", "TinTuc")" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-teal-600 text-white font-bold text-xs hover:bg-teal-700 transition shadow-md">
                        <i class="fas fa-redo"></i> Xem tất cả tin tức
                    </a>
                </div>
            }

        </main>

        <!-- Sidebar 4 Cột 3D -->
        <aside class="lg:col-span-4 space-y-6">
            
            <!-- Box tìm kiếm với Live Search 3D -->
            <div class="card-glass-3d p-6">
                <h3 class="text-sm font-black uppercase tracking-wider text-slate-800 font-heading mb-3 flex items-center gap-2">
                    <i class="fas fa-search text-teal-600"></i>
                    Tìm kiếm bài viết
                </h3>
                <form id="searchForm" action="@Url.Action("Index", "TinTuc")" method="get">
                    <input type="hidden" name="danhMucId" value="@currentDmId" />
                    <input type="hidden" name="sortBy" value="@currentSort" />
                    <div class="relative">
                        <input type="text" 
                               id="searchInput"
                               name="q" 
                               value="@searchKeyword"
                               placeholder="Nhập từ khóa công nghệ..." 
                               class="w-full input-3d text-xs font-semibold pr-12" 
                               autocomplete="off" />
                        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-xl bg-gradient-to-tr from-teal-600 to-emerald-500 text-white flex items-center justify-center hover:opacity-90 transition shadow-md" title="Tìm kiếm">
                            <i class="fas fa-search text-xs"></i>
                        </button>

                        <!-- Live Search Dropdown -->
                        <div id="searchDropdown" class="hidden absolute top-full left-0 right-0 mt-2 bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-teal-100 z-50 max-h-96 overflow-y-auto">
                        </div>
                    </div>
                </form>

                <!-- Quick Keywords Tag -->
                <div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-slate-100 text-xs">
                    <span class="text-slate-400 text-[11px] font-bold">Gợi ý:</span>
                    <a href="@Url.Action("Index", "TinTuc", new { q = "iPhone" })" class="px-2.5 py-1 rounded-lg bg-teal-50 text-teal-700 font-semibold hover:bg-teal-100 transition text-[11px]">iPhone</a>
                    <a href="@Url.Action("Index", "TinTuc", new { q = "AI" })" class="px-2.5 py-1 rounded-lg bg-teal-50 text-teal-700 font-semibold hover:bg-teal-100 transition text-[11px]">AI</a>
                    <a href="@Url.Action("Index", "TinTuc", new { q = "Mẹo" })" class="px-2.5 py-1 rounded-lg bg-teal-50 text-teal-700 font-semibold hover:bg-teal-100 transition text-[11px]">Mẹo hay</a>
                </div>
            </div>

            <!-- Chuyên mục tin tức -->
            @if (danhMucList.Any())
            {
                <div class="card-glass-3d p-6">
                    <h3 class="text-sm font-black uppercase tracking-wider text-slate-800 font-heading pb-3 mb-3 border-b border-slate-100 flex items-center gap-2">
                        <i class="fas fa-folder-open text-teal-600"></i>
                        Chuyên mục bài viết
                    </h3>
                    <div class="space-y-1.5">
                        <a href="@Url.Action("Index", "TinTuc", new { danhMucId = 0 })" 
                           class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all @(currentDmId == 0 ? "bg-teal-50 text-teal-700 border border-teal-200" : "text-slate-700 hover:bg-slate-50")">
                            <span>Tất cả chuyên mục</span>
                            <i class="fas fa-chevron-right text-[10px] @(currentDmId == 0 ? "text-teal-600" : "text-slate-300")"></i>
                        </a>
                        @foreach (var dm in danhMucList)
                        {
                            <a href="@Url.Action("Index", "TinTuc", new { danhMucId = dm.Id })" 
                               class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all @(currentDmId == dm.Id ? "bg-teal-50 text-teal-700 border border-teal-200" : "text-slate-700 hover:bg-slate-50")">
                                <span>@dm.TenDanhMuc</span>
                                <i class="fas fa-chevron-right text-[10px] @(currentDmId == dm.Id ? "text-teal-600" : "text-slate-300")"></i>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Widget: Tin nổi bật -->
            @if (tinNoiBat.Any())
            {
                <div class="card-glass-3d p-6">
                    <h3 class="text-sm font-black uppercase tracking-wider text-slate-800 font-heading pb-3 mb-4 border-b border-slate-100 flex items-center justify-between">
                        <span class="flex items-center gap-2">
                            <i class="fas fa-star text-amber-500"></i>
                            Tin nổi bật nhất
                        </span>
                        <span class="text-[10px] uppercase font-black px-2 py-0.5 rounded-full bg-rose-50 text-rose-600 border border-rose-200">Hot</span>
                    </h3>

                    <div class="space-y-3.5">
                        @{ int rank = 1; }
                        @foreach (var tin in tinNoiBat)
                        {
                            <a href="@Url.Action("ChiTiet", "TinTuc", new { id = tin.Id })" class="group flex items-start gap-3 pb-3 border-b border-slate-100 last:border-0 last:pb-0">
                                <span class="w-6 h-6 rounded-lg @(rank <= 3 ? "bg-amber-100 text-amber-800 font-black border border-amber-300" : "bg-slate-100 text-slate-500 font-bold") flex-shrink-0 flex items-center justify-center text-[11px] shadow-xs">
                                    0@(rank++)
                                </span>
                                @if (!string.IsNullOrEmpty(tin.HinhAnh))
                                {
                                    <div class="w-16 h-16 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0">
                                        <img src="@Url.Content("~/Content/Images/" + tin.HinhAnh)" 
                                             alt="@tin.TieuDe" 
                                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                                             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=200&q=80';" />
                                    </div>
                                }
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-xs font-bold text-slate-800 group-hover:text-teal-600 transition-colors line-clamp-2 leading-snug">
                                        @tin.TieuDe
                                    </h4>
                                    <p class="text-[10px] text-slate-400 mt-1 flex items-center gap-1">
                                        <i class="far fa-calendar-alt text-teal-500"></i>
                                        @(tin.NgayTao?.ToString("dd/MM/yyyy") ?? "")
                                    </p>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Banner Tư vấn Hỗ trợ 3D -->
            <div class="page-header-3d p-6 relative overflow-hidden" data-aos="fade-up">
                <div class="relative z-10">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-teal-400/20 text-teal-200 border border-teal-400/30 mb-3">
                        <i class="fas fa-headset mr-1.5 text-amber-300"></i> Hỗ trợ kỹ thuật
                    </span>
                    <h4 class="text-base font-black font-heading text-white leading-snug mb-2">
                        Cần tư vấn thiết bị &amp; công nghệ?
                    </h4>
                    <p class="text-xs text-slate-300 mb-4 leading-relaxed">
                        Chuyên viên công nghệ luôn sẵn sàng hỗ trợ bạn trải nghiệm giải pháp và báo giá tốt nhất.
                    </p>
                    <a href="tel:19001234" class="btn-3d btn-3d-primary w-full py-2.5 text-xs font-black uppercase rounded-xl flex items-center justify-center gap-2">
                        <i class="fas fa-phone-alt"></i> Hotline: 1900 1234
                    </a>
                </div>
            </div>

        </aside>

    </div>
</div>

@functions {
    public static MvcHtmlString HighlightKeyword(string text, string keyword)
    {
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(keyword))
        {
            return MvcHtmlString.Create(HttpUtility.HtmlEncode(text));
        }

        text = HttpUtility.HtmlEncode(text);
        keyword = HttpUtility.HtmlEncode(keyword);

        var highlightedText = System.Text.RegularExpressions.Regex.Replace(
            text,
            keyword,
            match => $"<mark class='bg-amber-200 text-amber-900 font-semibold px-1 rounded'>{match.Value}</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );

        return MvcHtmlString.Create(highlightedText);
    }
}

@section scripts {
<script>
    $(document).ready(function() {
        // Sort change
        $('#sortBy').on('change', function() {
            var sortBy = $(this).val();
            var danhMucId = '@currentDmId';
            var searchKeyword = '@Html.Raw(HttpUtility.JavaScriptStringEncode(searchKeyword))';
            
            showLoadingOverlay();
            
            var url = '@Url.Action("Index", "TinTuc")' + '?danhMucId=' + danhMucId + '&sortBy=' + sortBy;
            if (searchKeyword) {
                url += '&q=' + encodeURIComponent(searchKeyword);
            }
            window.location.href = url;
        });

        // Live search
        var searchTimeout;
        var $searchInput = $('#searchInput');
        var $searchDropdown = $('#searchDropdown');

        $searchInput.on('input', function() {
            clearTimeout(searchTimeout);
            var keyword = $(this).val().trim();

            if (keyword.length < 2) {
                $searchDropdown.addClass('hidden').empty();
                return;
            }

            searchTimeout = setTimeout(function() {
                performLiveSearch(keyword);
            }, 300);
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#searchInput, #searchDropdown').length) {
                $searchDropdown.addClass('hidden');
            }
        });

        function performLiveSearch(keyword) {
            $.ajax({
                url: '@Url.Action("LiveSearch", "TinTuc")',
                type: 'GET',
                data: { q: keyword },
                dataType: 'json',
                beforeSend: function() {
                    $searchDropdown.html('<div class="p-4 text-center"><i class="fas fa-spinner fa-spin text-teal-600 text-xl"></i></div>').removeClass('hidden');
                },
                success: function(response) {
                    if (response.success && response.results && response.results.length > 0) {
                        var html = '<div class="p-2">';
                        html += '<div class="px-3 py-2 text-xs font-semibold text-slate-400 border-b border-slate-100">Tìm thấy ' + response.count + ' kết quả</div>';

                        $.each(response.results, function(index, item) {
                            html += '<a href="/TinTuc/ChiTiet/' + item.id + '" class="flex items-start p-2.5 hover:bg-slate-50 rounded-xl transition-colors gap-3">';
                            var imageUrl = item.hinhAnh ? '/Content/Images/' + item.hinhAnh : 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=120&q=80';
                            html += '<img src="' + imageUrl + '" alt="' + escapeHtml(item.tieuDe) + '" class="w-14 h-14 object-cover rounded-lg flex-shrink-0" onerror="this.src=\'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=120&q=80\'" />';
                            html += '<div class="flex-1 min-w-0">';
                            html += '<h4 class="text-xs font-bold text-slate-800 line-clamp-2 mb-1">' + escapeHtml(item.tieuDe) + '</h4>';
                            html += '<p class="text-[11px] text-slate-400"><i class="far fa-calendar-alt mr-1"></i>' + item.ngayTao;
                            if (item.danhMuc) {
                                html += ' <span class="mx-1 text-slate-300">•</span> <span class="text-teal-600 font-semibold">' + escapeHtml(item.danhMuc) + '</span>';
                            }
                            html += '</p></div>';
                            html += '</a>';
                        });

                        html += '<div class="p-2 border-t border-slate-100 mt-1">';
                        html += '<a href="javascript:void(0)" class="block text-center text-teal-600 hover:text-teal-700 font-bold text-xs py-1" onclick="$(\'#searchForm\').submit();">';
                        html += '<i class="fas fa-search mr-1.5"></i>Xem tất cả kết quả';
                        html += '</a></div>';
                        html += '</div>';

                        $searchDropdown.html(html).removeClass('hidden');
                    } else {
                        var noResultHtml = '<div class="p-6 text-center text-slate-400 text-xs">';
                        noResultHtml += '<i class="fas fa-search text-2xl mb-2 text-slate-300 block"></i>Không tìm thấy bài viết phù hợp';
                        noResultHtml += '</div>';
                        $searchDropdown.html(noResultHtml).removeClass('hidden');
                    }
                },
                error: function() {
                    $searchDropdown.html('<div class="p-4 text-center text-rose-600 text-xs">Có lỗi xảy ra khi tìm kiếm</div>').removeClass('hidden');
                }
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        function showLoadingOverlay() {
            var overlay = $('<div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center">')
                .append('<div class="bg-white rounded-2xl p-6 shadow-2xl flex items-center gap-3 text-slate-800 font-bold text-sm"><i class="fas fa-circle-notch fa-spin text-teal-600 text-2xl"></i><span>Đang tải dữ liệu...</span></div>');
            $('body').append(overlay);
        }
    });
</script>
}
