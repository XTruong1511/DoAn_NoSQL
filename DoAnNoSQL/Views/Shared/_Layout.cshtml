                        <!-- Form Đăng ký -->
                        <form id="modal-register-form" class="auth-form-modal" action="@Url.Action("AjaxRegister", "Account")">
                            @Html.AntiForgeryToken()
                            
                            <div class="input-group-modal">
                                <input type="text" name="FullName" id="modal-register-fullname" placeholder=" " required />
