                                <div class="input-group-modal">
                                    <input type="password" id="modal-fp-confirm-password" name="ConfirmNewPassword" placeholder=" " required />
                                    <label for="modal-fp-confirm-password">Xác nhận mật khẩu</label>
                                    <i class="fas fa-shield-check input-group-icon"></i>
                                    <i class="fas fa-eye password-toggle-modal" data-target="modal-fp-confirm-password"></i>
                                </div>

                                <button type="button" class="submit-btn-modal" id="btn-save-password-modal">
                                    <i class="fas fa-check"></i>
                                    <span>Lưu mật khẩu mới</span>
                                </button>
                            </div>

                            <div class="switch-form-link-modal">
                                <a class="show-login-form" href="javascript:void(0);"><i class="fas fa-arrow-left mr-1"></i> Quay lại đăng nhập</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
