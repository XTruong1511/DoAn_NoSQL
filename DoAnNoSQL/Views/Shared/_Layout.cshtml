                            <button type="button" class="auth-tab-btn active" id="tab-login-btn">
                                <i class="fas fa-sign-in-alt mr-1.5"></i> Đăng nhập
                            </button>
                            <button type="button" class="auth-tab-btn" id="tab-register-btn">
                                <i class="fas fa-user-plus mr-1.5"></i> Đăng ký
                            </button>
                        </div>

                        <!-- Alert Box -->
                        <div id="modal-alert" class="alert-modal"></div>

                        <!-- Form Đăng nhập -->
                        <form id="modal-login-form" class="auth-form-modal active" action="@Url.Action("AjaxLogin", "Account")">
                            @Html.AntiForgeryToken()
                            
                            <div class="input-group-modal">
                                <input type="text" name="EmailOrPhone" id="modal-login-email" placeholder=" " required />
                                <label for="modal-login-email">Email hoặc Số điện thoại</label>
                                <i class="fas fa-user input-group-icon"></i>
                            </div>

                            <div class="input-group-modal">
                                <input type="password" name="Password" id="modal-login-password" placeholder=" " required />
                                <label for="modal-login-password">Mật khẩu</label>
                                <i class="fas fa-lock input-group-icon"></i>
                                <i class="fas fa-eye password-toggle-modal" data-target="modal-login-password" title="Hiện/ẩn mật khẩu"></i>
                            </div>

                            <div class="forget-password-modal">
                                <a id="show-forgot-form" href="javascript:void(0);">
                                    <i class="fas fa-key mr-1"></i> Quên mật khẩu?
                                </a>
                            </div>

                            <button class="submit-btn-modal" type="submit">
                                <i class="fas fa-arrow-right-to-bracket"></i>
                                <span>Đăng nhập</span>
                            </button>

                            <!-- Cyber Divider -->
                            <div class="cyber-divider">
                                <span>Hoặc tiếp tục với</span>
                            </div>

                            <!-- Google Login Button -->
                            <div class="google-btn-wrapper">
                                <!-- Custom visual button (user sees this) -->
                                <button type="button" class="google-login-btn-custom" id="custom-google-login-btn">
                                    <svg class="google-icon-svg" viewBox="0 0 48 48">
                                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                        <path fill="none" d="M0 0h48v48H0z"/>
                                    </svg>
                                    <span class="google-btn-text">Đăng nhập qua Google</span>
                                </button>

                                <!-- Real GSI button overlay (invisible, on top, receives the click) -->
                                <div class="google-gsi-overlay" id="google-gsi-overlay-container">
                                    <div id="g_id_onload"
                                         data-client_id="875214279930-h0d47gbbmvodj3mejnkb3k89dj3esalo.apps.googleusercontent.com"
                                         data-context="signin"
                                         data-ux_mode="popup"
                                         data-callback="handleGoogleLoginModal"
                                         data-auto_prompt="false">
                                    </div>
                                    <div class="g_id_signin"
                                         data-type="standard"
                                         data-shape="rectangular"
                                         data-theme="outline"
                                         data-text="signin_with"
                                         data-size="large"
                                         data-width="400"
                                         data-logo_alignment="center">
                                    </div>
                                </div>
                            </div>

                            <div class="switch-form-link-modal">
                                Bạn chưa có tài khoản? <a id="show-register-form" href="javascript:void(0);">Đăng ký ngay</a>
                            </div>
                        </form>

                        <!-- Form ẩn để submit Google Token từ Modal -->
                        <form id="google-login-modal-form" action="@Url.Action("GoogleLogin", "Account")" method="POST" style="display: none;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="credential" id="google-credential-modal" />
