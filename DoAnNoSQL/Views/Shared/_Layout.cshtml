                                    <input type="text" class="otp-input-modal" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                    <input type="text" class="otp-input-modal" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                    <input type="text" class="otp-input-modal" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                    <input type="text" class="otp-input-modal" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                    <input type="text" class="otp-input-modal" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                    <input type="text" class="otp-input-modal" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                </div>
                                
                                <div class="otp-timer-modal">
                                    Thời hạn mã OTP: <span id="modal-timer-count" class="font-bold text-teal-300 font-mono">05:00</span>
                                </div>

                                <button type="button" class="submit-btn-modal" id="btn-verify-otp-modal">
                                    <i class="fas fa-shield-check"></i>
                                    <span>Xác nhận mã OTP</span>
                                </button>
                            </div>

                            <div id="modal-fp-step-3" style="display: none;">
                                <p class="form-subheading-modal">Mã OTP hợp lệ. Vui lòng thiết lập mật khẩu mới an toàn.</p>
                                
                                <div class="input-group-modal">
                                    <input type="password" id="modal-fp-new-password" name="NewPassword" placeholder=" " required />
                                    <label for="modal-fp-new-password">Mật khẩu mới</label>
