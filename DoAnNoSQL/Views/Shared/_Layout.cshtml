    <script>
        function handleGoogleLoginModal(response) {
            document.getElementById('google-credential-modal').value = response.credential;
            document.getElementById('google-login-modal-form').submit();
        }

        // Add hover effect passthrough: when hovering over the invisible GSI overlay,
        // visually highlight the custom button underneath
        $(document).ready(function() {
            var overlay = document.getElementById('google-gsi-overlay-container');
            var customBtn = document.getElementById('custom-google-login-btn');
            if (overlay && customBtn) {
                overlay.addEventListener('mouseenter', function() {
                    customBtn.classList.add('hover-active');
                });
                overlay.addEventListener('mouseleave', function() {
                    customBtn.classList.remove('hover-active');
                });
            }
        });
