                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: 'Vui lòng nhập địa chỉ email hợp lệ.',
                        confirmButtonColor: '#14b8a6'
                    });
                }
            });
        });
    </script>

