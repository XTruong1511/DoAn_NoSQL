                                    <input type="email" name="Email" id="modal-forgot-email" placeholder=" " required />
                                    <label for="modal-forgot-email">Địa chỉ Email</label>
                                    <i class="fas fa-envelope input-group-icon"></i>
                                </div>
                                <button class="submit-btn-modal" type="button" id="btn-send-otp-modal">
                                    <i class="fas fa-paper-plane"></i>
                                    <span>Gửi mã xác nhận OTP</span>
                                </button>
                            </div>

                            <div id="modal-fp-step-2" style="display: none;">
                                <p class="form-subheading-modal">Nhập mã 6 chữ số vừa được gửi đến hòm thư email của bạn.</p>
                                
