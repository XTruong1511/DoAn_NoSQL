                            inset: 0;
                            background: linear-gradient(135deg, rgba(66, 133, 244, 0.08), rgba(234, 67, 53, 0.06), rgba(251, 188, 5, 0.06), rgba(52, 168, 83, 0.08));
                            opacity: 0;
