<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - @DoAnNoSQL.Helpers.SettingsHelper.GetValue("TenCuaHang", "Cửa hàng của tôi")</title>
    <link rel="icon" type="image/x-icon" href="~/Content/images/@DoAnNoSQL.Helpers.SettingsHelper.GetValue("LogoCuaHang", "logo.png")">

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS & Custom Config -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            300: '#5eead4',
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        heading: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
                    },
                    boxShadow: {
                        'soft': '0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04)',
                        'glow': '0 0 20px rgba(13, 148, 136, 0.35)',
                        'glow-blue': '0 0 20px rgba(37, 99, 235, 0.35)',
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Đường dẫn CSS: Lưu ý dấu ~ để trỏ về thư mục gốc -->
    <link href="~/Content/modern-ui.css" rel="stylesheet" />
    <link href="~/Content/Trang-Chu.css" rel="stylesheet" />
    <link href="~/Content/Global.css" rel="stylesheet" />
    <link href="~/Content/web-3d.css?v=2.2" rel="stylesheet" />

    <!-- jQuery - REQUIRED for AJAX -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap CSS & JS - REQUIRED for Modal -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <!-- SweetAlert2 for beautiful notifications -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Animate.css for smooth animations -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    
    <!-- AOS - Animate On Scroll Library -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-teal-500 selection:text-white">
    <!-- Header -->
    <header class="bg-gradient-to-r from-teal-900 via-slate-900 to-blue-950 shadow-xl sticky top-0 z-50 backdrop-blur-md bg-opacity-95 border-b border-white/10" data-aos="fade-down" data-aos-duration="500">
        <!-- Desktop Header (md and up) -->
        <div class="hidden md:block">
            <div class="container mx-auto px-4 py-3">
                <div class="flex items-center justify-between gap-4">
                    <!-- Logo -->
                    <div class="flex-shrink-0">
                        <a href="@Url.Action("Index", "Home")" class="text-2xl font-bold text-blue-600 flex items-center">
                            <img src="~/Content/Images/@DoAnNoSQL.Helpers.SettingsHelper.GetValue("LogoCuaHang", "logo.png")" alt="Logo" class="mr-2" style="max-height: 50px;" />
                        </a>
                    </div>

                    <!-- Search Bar with Running Border Beam -->
                    <div class="flex-1 max-w-2xl">
                        <div class="relative">
                            <form id="searchForm" action="@Url.Action("Index", "Search")" method="get">
                                <div class="search-beam-container">
                                    <span class="search-beam-border"></span>
                                    <input type="text"
                                           id="searchInput"
                                           name="q"
                                           placeholder="Tìm kiếm điện thoại, laptop, phụ kiện chính hãng..."
                                           class="w-full py-2.5 px-5 pr-12 bg-white/95 backdrop-blur-md border border-slate-200/80 rounded-full focus:outline-none focus:ring-2 focus:ring-teal-400 focus:bg-white text-sm text-slate-800 placeholder-slate-400 transition-all shadow-inner relative z-10"
                                           autocomplete="off">
                                    <button type="submit" class="absolute right-0 top-0 h-full px-4 text-slate-400 hover:text-teal-600 transition-colors z-20">
                                        <i class="fas fa-search text-base"></i>
                                    </button>
                                </div>

                                <!-- Autocomplete Dropdown -->
                                <div id="searchDropdown" class="hidden absolute top-full left-0 right-0 mt-2 bg-white/95 backdrop-blur-lg rounded-2xl shadow-2xl border border-slate-200/80 z-50 max-h-96 overflow-y-auto">
                                    <!-- Results will be populated here -->
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Desktop Menu -->
                    <nav class="hidden lg:flex items-center space-x-1.5">
                        <a href="@Url.Action("Index", "Home")" class="nav-border-beam whitespace-nowrap">
                            <span class="beam-border"></span>
                            <span>TRANG CHỦ</span>
                        </a>
                        <a href="@Url.Action("Index", "KhuyenMai")" class="nav-border-beam whitespace-nowrap">
                            <span class="beam-border"></span>
                            <span>KHUYẾN MÃI</span>
                        </a>
                        <a href="@Url.Action("Index", "TinTuc")" class="nav-border-beam whitespace-nowrap">
                            <span class="beam-border"></span>
                            <span>TIN TỨC</span>
                        </a>
                        <a href="@Url.Action("Index", "LienHe")" class="nav-border-beam whitespace-nowrap">
                            <span class="beam-border"></span>
                            <span>LIÊN HỆ</span>
                        </a>
                        <a href="@Url.Action("About", "Home")" class="nav-border-beam whitespace-nowrap">
                            <span class="beam-border"></span>
                            <span>GIỚI THIỆU</span>
                        </a>
                    </nav>

                    <!-- Desktop User & Cart Icons -->
                    <div class="flex items-center space-x-3 flex-shrink-0">
                        @if (ViewBag.IsAuthenticated == true)
                        {
                            @* Hiển thị khi đã đăng nhập *@
                            <div class="relative group user-dropdown-container">
                                <a href="#" class="text-white/90 hover:text-white hover:bg-white/10 rounded-full p-2 flex items-center transition-all duration-200 hover:scale-105">
                                    <i class="fas fa-user-circle text-2xl mr-2 text-teal-300"></i>
                                    <span class="hidden xl:inline text-sm font-semibold">@ViewBag.CurrentUser.HoTen</span>
                                    <i class="fas fa-chevron-down ml-1 text-xs opacity-75"></i>
                                </a>
                                @* Dropdown menu *@
                                <div class="absolute right-0 mt-2 w-56 bg-white/95 backdrop-blur-lg rounded-2xl shadow-2xl border border-slate-200/80 hidden group-hover:block z-50 overflow-hidden">
                                    <div class="py-2">
                                        <a href="@Url.Action("Index", "TaiKhoan")" class="flex items-center px-4 py-2.5 hover:bg-teal-50 hover:text-teal-700 text-gray-700 transition-colors text-sm">
                                            <i class="fas fa-user-circle w-5 mr-2 text-teal-600"></i> Tài khoản của tôi
                                        </a>
                                        <a href="@Url.Action("DonHang", "TaiKhoan")" class="flex items-center px-4 py-2.5 hover:bg-teal-50 hover:text-teal-700 text-gray-700 transition-colors text-sm">
                                            <i class="fas fa-shopping-bag w-5 mr-2 text-teal-600"></i> Đơn hàng của tôi
                                        </a>
                                        <a href="@Url.Action("DoiMatKhau", "TaiKhoan")" class="flex items-center px-4 py-2.5 hover:bg-teal-50 hover:text-teal-700 text-gray-700 transition-colors text-sm">
                                            <i class="fas fa-key w-5 mr-2 text-teal-600"></i> Đổi mật khẩu
                                        </a>
                                        <div class="border-t border-slate-100 my-1"></div>
                                        <a href="@Url.Action("Logout", "Account")" class="flex items-center px-4 py-2.5 hover:bg-red-50 text-red-600 transition-colors text-sm font-medium">
                                            <i class="fas fa-sign-out-alt w-5 mr-2"></i> Đăng xuất
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @* Hiển thị khi chưa đăng nhập *@
                            <a href="#" data-toggle="modal" data-target="#authModal" class="text-white/90 hover:text-white hover:bg-white/10 rounded-full p-2.5 flex items-center transition-all duration-200 hover:scale-105 active:scale-95" title="Đăng nhập">
                                <i class="fas fa-user text-lg"></i>
                            </a>
                        }

                        <!--Giỏ hàng (Mở Side Cart Drawer 1/4 bên trái)-->
                        @if (ViewBag.IsAuthenticated == true)
                        {
                            <a href="javascript:void(0);" onclick="openSideCart(); return false;" class="open-cart-trigger text-white/90 hover:text-white hover:bg-white/10 rounded-full relative p-2.5 transition-all duration-200 hover:scale-105 active:scale-95 flex items-center justify-center" title="Giỏ hàng">
                                <i class="fas fa-shopping-cart text-lg"></i>
                                <span class="cart-count absolute -top-1 -right-1 bg-gradient-to-r from-red-500 to-rose-600 text-white text-[10px] font-bold rounded-full w-5 h-5 flex items-center justify-center shadow-md shadow-rose-500/40">0</span>
                            </a>
                        }
                        else
                        {
                            <a href="#" data-toggle="modal" data-target="#authModal" class="text-white/90 hover:text-white hover:bg-white/10 rounded-full relative p-2.5 transition-all duration-200 hover:scale-105 active:scale-95 flex items-center justify-center" title="Giỏ hàng">
                                <i class="fas fa-shopping-cart text-lg"></i>
                                <span class="cart-count absolute -top-1 -right-1 bg-gradient-to-r from-red-500 to-rose-600 text-white text-[10px] font-bold rounded-full w-5 h-5 flex items-center justify-center shadow-md shadow-rose-500/40">0</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile Header (below md) -->
        <div class="md:hidden">
            <div class="container mx-auto px-4 py-3">
                <!-- Top Row: Logo, User, Cart -->
                <div class="flex items-center justify-between mb-3">
                    <!-- Logo -->
                    <a href="@Url.Action("Index", "Home")" class="flex items-center">
                        <img src="~/Content/Images/@DoAnNoSQL.Helpers.SettingsHelper.GetValue("LogoCuaHang", "logo.png")" alt="Logo" style="max-height: 40px;" />
                    </a>

                    <!-- User & Cart Icons -->
                    <div class="flex items-center space-x-3">
                        @if (ViewBag.IsAuthenticated == true)
                        {
                            <div class="relative group user-dropdown-container">
                                <a href="#" class="text-white/90 hover:text-white p-2 flex items-center">
                                    <i class="fas fa-user text-xl"></i>
                                </a>
                                <div class="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-xl border border-gray-200 hidden z-50">
                                    <div class="py-2">
                                        <a href="@Url.Action("Index", "TaiKhoan")" class="block px-4 py-3 hover:bg-gray-50 text-gray-700 transition-colors text-sm">
                                            <i class="fas fa-user-circle w-5 mr-2"></i> Tài khoản của tôi
                                        </a>
                                        <a href="@Url.Action("DonHang", "TaiKhoan")" class="block px-4 py-3 hover:bg-gray-50 text-gray-700 transition-colors text-sm">
                                            <i class="fas fa-shopping-bag w-5 mr-2"></i> Đơn hàng của tôi
                                        </a>
                                        <a href="@Url.Action("DoiMatKhau", "TaiKhoan")" class="block px-4 py-3 hover:bg-gray-50 text-gray-700 transition-colors text-sm">
                                            <i class="fas fa-key w-5 mr-2"></i> Đổi mật khẩu
                                        </a>
                                        <div class="border-t my-2"></div>
                                        <a href="@Url.Action("Logout", "Account")" class="block px-4 py-3 hover:bg-red-50 text-red-600 transition-colors text-sm">
                                            <i class="fas fa-sign-out-alt w-5 mr-2"></i> Đăng xuất
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a href="#" data-toggle="modal" data-target="#authModal" class="text-white/90 hover:text-white p-2">
                                <i class="fas fa-user text-xl"></i>
                            </a>
                        }

                        @if (ViewBag.IsAuthenticated == true)
                        {
                            <a href="javascript:void(0);" onclick="openSideCart(); return false;" class="open-cart-trigger text-white/90 hover:text-white relative p-2 transition-colors">
                                <i class="fas fa-shopping-cart text-xl"></i>
                                <span class="cart-count absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span>
                            </a>
                        }
                        else
                        {
                            <a href="#" data-toggle="modal" data-target="#authModal" class="text-white/90 hover:text-white relative p-2 transition-colors">
                                <i class="fas fa-shopping-cart text-xl"></i>
                                <span class="cart-count absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Search Bar Row with Running Border Beam -->
                <div class="relative">
                    <form id="searchFormMobile" action="@Url.Action("Index", "Search")" method="get">
                        <div class="search-beam-container">
                            <span class="search-beam-border"></span>
                            <input type="text"
                                   id="searchInputMobile"
                                   name="q"
                                   placeholder="Tìm kiếm điện thoại, laptop, phụ kiện..."
                                   class="w-full py-2.5 px-4 pr-12 bg-white/95 border border-slate-200/80 rounded-full focus:outline-none focus:ring-2 focus:ring-teal-400 text-sm text-slate-800 placeholder-slate-400 shadow-inner relative z-10"
                                   autocomplete="off">
                            <button type="submit" class="absolute right-0 top-0 h-full px-4 text-slate-400 hover:text-teal-600 transition-colors z-20">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>

                        <!-- Mobile Autocomplete Dropdown -->
                        <div id="searchDropdownMobile" class="hidden absolute top-full left-0 right-0 mt-2 bg-white/95 backdrop-blur-lg rounded-2xl shadow-2xl border border-slate-200/80 z-50 max-h-96 overflow-y-auto">
                            <!-- Results will be populated here -->
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <!-- Category Navigation -  Danh mục sản phẩm trên đầu -->
    <!-- Main Content -->
    <main class="container mx-auto px-4 py-6">
        <!-- RenderBody: Nơi nội dung của từng trang con sẽ hiển thị ở đây -->
        @RenderBody()
    </main>

  

    <!-- Footer -->
    <footer class="bg-gradient-to-b from-slate-900 via-slate-950 to-black text-slate-300 py-12" data-aos="fade-up" data-aos-duration="800">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
                <!-- Contact Info -->
                <div class="space-y-3">
                    <h3 class="text-base font-bold text-teal-400 tracking-wide uppercase font-heading flex items-center gap-2">
                        <i class="fas fa-store text-teal-500"></i> THÔNG TIN LIÊN HỆ
                    </h3>
                    <p class="text-sm text-slate-300 flex items-start gap-2.5 leading-relaxed">
                        <i class="fas fa-map-marker-alt text-teal-400 mt-1 flex-shrink-0"></i>
                        <span>@DoAnNoSQL.Helpers.SettingsHelper.GetValue("DiaChiCuaHang", "140 Lê Trọng Tấn, P. Tây Thạnh, TP. HCM")</span>
                    </p>
                    <p class="text-sm text-slate-300 flex items-center gap-2.5">
                        <i class="fas fa-phone-alt text-teal-400 flex-shrink-0"></i>
                        <span>Hotline: <strong class="text-white font-semibold">@DoAnNoSQL.Helpers.SettingsHelper.GetValue("Hotline", "1800.1060")</strong></span>
                    </p>
                    <p class="text-sm text-slate-300 flex items-center gap-2.5">
                        <i class="fas fa-envelope text-teal-400 flex-shrink-0"></i>
                        <span>@DoAnNoSQL.Helpers.SettingsHelper.GetValue("EmailLienHe", "hotro@khoaluancunhan.vn")</span>
                    </p>
                </div>

                <!-- About -->
                <div class="space-y-3">
                    <h3 class="text-base font-bold text-teal-400 tracking-wide uppercase font-heading">
                        VỀ CHÚNG TÔI
                    </h3>
                    <ul class="space-y-2 text-sm">
                        <li><a href="@Url.Action("About", "Home")" class="hover:text-teal-300 transition-colors flex items-center gap-1.5"><i class="fas fa-chevron-right text-[10px] text-teal-500"></i> Giới thiệu hệ thống</a></li>
                        <li><a href="@Url.Action("Index", "LienHe")" class="hover:text-teal-300 transition-colors flex items-center gap-1.5"><i class="fas fa-chevron-right text-[10px] text-teal-500"></i> Cơ hội việc làm</a></li>
                        <li><a href="@Url.Action("Index", "LienHe")" class="hover:text-teal-300 transition-colors flex items-center gap-1.5"><i class="fas fa-chevron-right text-[10px] text-teal-500"></i> Góp ý & Khiếu nại</a></li>
                        <li><a href="@Url.Action("Index", "LienHe")" class="hover:text-teal-300 transition-colors flex items-center gap-1.5"><i class="fas fa-chevron-right text-[10px] text-teal-500"></i> Chính sách bảo mật</a></li>
                    </ul>
                </div>

                <!-- Customer Support -->
                <div class="space-y-3">
                    <h3 class="text-base font-bold text-teal-400 tracking-wide uppercase font-heading">
                        HỖ TRỢ KHÁCH HÀNG
                    </h3>
                    <ul class="space-y-2 text-sm">
                        <li><a href="@Url.Action("About", "Home")#guideline" class="hover:text-teal-300 transition-colors flex items-center gap-1.5"><i class="fas fa-chevron-right text-[10px] text-teal-500"></i> Hướng dẫn mua hàng online</a></li>
                        <li><a href="@Url.Action("Index", "LienHe")" class="hover:text-teal-300 transition-colors flex items-center gap-1.5"><i class="fas fa-chevron-right text-[10px] text-teal-500"></i> Chính sách bảo hành & sửa chữa</a></li>
                        <li><a href="@Url.Action("Index", "LienHe")" class="hover:text-teal-300 transition-colors flex items-center gap-1.5"><i class="fas fa-chevron-right text-[10px] text-teal-500"></i> Chính sách đổi trả & hoàn tiền</a></li>
                        <li><a href="@Url.Action("Index", "LienHe")" class="hover:text-teal-300 transition-colors flex items-center gap-1.5"><i class="fas fa-chevron-right text-[10px] text-teal-500"></i> Câu hỏi thường gặp (FAQ)</a></li>
                    </ul>
                </div>

                <!-- Social & Newsletter -->
                <div class="space-y-4">
                    <h3 class="text-base font-bold text-teal-400 tracking-wide uppercase font-heading">
                        KẾT NỐI VỚI CHÚNG TÔI
                    </h3>
                    <div class="flex space-x-3">
                        <a href="https://www.facebook.com/share/1DaaiE7daC/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-blue-600 text-white flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-blue-500/30" aria-label="Facebook"><i class="fab fa-facebook-f text-base"></i></a>
                        <a href="https://youtube.com/&#64;dhcongthuong?si=5OOWI8E4RG9mT-bR" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-red-600 text-white flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-red-500/30" aria-label="YouTube"><i class="fab fa-youtube text-base"></i></a>
                        <a href="https://www.instagram.com/dh_congthuong?igsi=emRzMG94Y2xlb3Ux" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-pink-600 text-white flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-pink-500/30" aria-label="Instagram"><i class="fab fa-instagram text-base"></i></a>
                        <a href="https://www.tiktok.com/&#64;huit_media?_r=1&_t=ZS-99GC2bHlp7Q" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all duration-300 hover:scale-110" aria-label="TikTok"><i class="fab fa-tiktok text-base"></i></a>
                    </div>
                    
                    <h3 class="text-base font-bold text-teal-400 tracking-wide uppercase font-heading">ĐĂNG KÝ NHẬN KHUYẾN MÃI</h3>
                    <div class="flex shadow-lg rounded-full overflow-hidden border border-slate-700 bg-slate-800/80 p-1">
                        <input type="email" id="newsletterEmail" placeholder="Nhập email của bạn..." class="px-4 py-2 bg-transparent text-white w-full text-sm focus:outline-none placeholder-slate-400" aria-label="Đăng ký nhận bản tin">
                        <button id="btnSubscribe" class="bg-gradient-to-r from-teal-500 to-blue-600 hover:from-teal-600 hover:to-blue-700 text-white px-5 py-2 rounded-full transition-all duration-300 font-medium text-sm flex-shrink-0 shadow-md" aria-label="Gửi">
                            <i class="fas fa-paper-plane mr-1"></i> Gửi
                        </button>
                    </div>
                </div>
            </div>

            <!-- Copyright -->
            <div class="border-t border-slate-800/80 mt-10 pt-6 text-center text-slate-400">
                <p class="text-xs sm:text-sm mb-1.5">&copy; @DateTime.Now.Year @DoAnNoSQL.Helpers.SettingsHelper.GetValue("TenCuaHang", "Khóa Luận Cử Nhân"). GPDKKD: do Trường ĐH Công Thương TP.HCM & Phòng đào tạo cấp ngày 01/08/2026.</p>
                <p class="text-xs sm:text-sm">GP: 238/GP-BTTTT do Khoa công nghệ thông tin cấp ngày 17/08/2026.</p>
            </div>
        </div>
    </footer>

    <!-- Side Cart Drawer (1/4 screen on right) -->
    @Html.Partial("_SideCart")

    <!-- Auth Modal 3D Cyber Edition -->
    <div class="modal fade" id="authModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 480px; margin: 1.75rem auto;">
