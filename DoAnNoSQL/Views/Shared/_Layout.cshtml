    <script src="~/Scripts/Trang-Chu.js"></script>
    <script src="~/Scripts/cart.js"></script>

    <script>
      // Load cart count on page load
        $(document).ready(function() {
 $.ajax({
   url: '@Url.Action("GetCartCount", "GioHang")',
  type: 'GET',
    success: function(response) {
  if (response.count > 0) {
     $('.cart-count').text(response.count).show();
    } else {
      $('.cart-count').hide();
   }
  }
     });
  });

        // Search Autocomplete - Unified function
        var searchTimeout;

        function initSearchAutocomplete(inputSelector, dropdownSelector) {
            var $input = $(inputSelector);
            var $dropdown = $(dropdownSelector);

            $input.on('input', function() {
                clearTimeout(searchTimeout);
                var keyword = $(this).val().trim();

                if (keyword.length < 2) {
                    $dropdown.addClass('hidden').empty();
                    return;
                }

                searchTimeout = setTimeout(function() {
                    $.ajax({
                        url: '@Url.Action("QuickSearch", "Search")',
                        type: 'GET',
                        data: { q: keyword },
                        dataType: 'json',
                        success: function(response) {
                            if (response.success && response.count > 0) {
                                var html = '<div class="p-2">';

                                // Header
                                html += '<div class="px-3 py-2 text-xs font-semibold text-gray-500 border-b">';
                                html += 'Tìm thấy ' + response.count + ' sản phẩm';
                                html += '</div>';

                                // Results
                                $.each(response.data, function(index, item) {
                                    html += '<a href="' + item.url + '" class="flex items-center p-3 hover:bg-blue-50 transition-colors border-b last:border-b-0">';

                                    // Image
                                    html += '<img src="/Content/Images/' + item.image + '" alt="' + escapeHtml(item.name) + '" class="w-16 h-16 object-contain rounded border border-gray-200 mr-3" onerror="this.src=\'/Content/Images/no-image.png\'">';

                                    // Info
                                    html += '<div class="flex-1 min-w-0">';
                                    html += '<p class="text-sm font-semibold text-gray-900 truncate">' + escapeHtml(item.name) + '</p>';

                                    // Price
                                    if (item.hasDiscount) {
                                        html += '<div class="flex items-center space-x-2 mt-1">';
                                        html += '<span class="text-sm font-bold text-red-600">' + formatPrice(item.price) + ' đ</span>';
                                        html += '<span class="text-xs text-gray-500 line-through">' + formatPrice(item.oldPrice) + ' đ</span>';
                                        html += '</div>';
                                    } else {
                                        html += '<span class="text-sm font-bold text-blue-600 mt-1 block">' + formatPrice(item.price) + ' đ</span>';
                                    }

                                    html += '</div>';

                                    // Arrow
                                    html += '<i class="fas fa-chevron-right text-gray-400"></i>';
                                    html += '</a>';
                                });

                                // View All
                                html += '<div class="p-3 border-t bg-gray-50">';
                                html += '<a href="@Url.Action("Index", "Search")?q=' + encodeURIComponent(keyword) + '" class="block text-center text-blue-600 hover:text-blue-700 font-semibold text-sm">';
                                html += '<i class="fas fa-search mr-2"></i>Xem tất cả kết quả';
                                html += '</a>';
                                html += '</div>';

                                html += '</div>';

                                $dropdown.html(html).removeClass('hidden');
                            } else {
                                // No results
                                var noResultHtml = '<div class="p-6 text-center">';
                                noResultHtml += '<i class="fas fa-search text-gray-300 text-3xl mb-2"></i>';
                                noResultHtml += '<p class="text-gray-500 text-sm">Không tìm thấy sản phẩm</p>';
                                noResultHtml += '</div>';
                                $dropdown.html(noResultHtml).removeClass('hidden');
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error('Search error:', error);
                            $dropdown.addClass('hidden').empty();
                        }
                    });
                }, 300); // Debounce 300ms
            });

            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest(inputSelector).length && !$(e.target).closest(dropdownSelector).length) {
                    $dropdown.addClass('hidden');
                }
            });
        }

        // Initialize search for both desktop and mobile
        initSearchAutocomplete('#searchInput', '#searchDropdown');
        initSearchAutocomplete('#searchInputMobile', '#searchDropdownMobile');

    // User Dropdown Menu Toggle
    $('.user-dropdown-container > a').on('click', function(e) {
        e.preventDefault();
        var dropdown = $(this).siblings('div');
        dropdown.toggleClass('hidden');
    });

    // Close dropdown when clicking outside
    $(document).on('click', function(e) {
  if (!$(e.target).closest('.user-dropdown-container').length) {
            $('.user-dropdown-container > div').addClass('hidden');
        }
    });

    // Format price
 function formatPrice(price) {
        if (!price) return '0';
 return Math.round(price).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    // Escape HTML to prevent XSS
    function escapeHtml(text) {
        if (!text) return '';
  var map = {
     '&': '&amp;',
            '<': '&lt;',
'>': '&gt;',
 '"': '&quot;',
          "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, function(m) { return map[m]; });
    }
    // Auth Modal Script
    $(document).ready(function() {
        function showAuthAlert(message, isSuccess) {
            var alertDiv = $('#modal-alert');
            alertDiv.removeClass('alert-success alert-danger').addClass(isSuccess ? 'alert-success' : 'alert-danger');
            alertDiv.html(isSuccess ? '<i class="fas fa-check-circle"></i> ' + message : '<i class="fas fa-exclamation-circle"></i> ' + message);
            alertDiv.slideDown();
            setTimeout(function() { alertDiv.slideUp(); }, 5000);
        }

        function resetAuthForms() {
            $('.auth-form-modal').trigger('reset');
            $('#modal-alert').hide();
        }

        function switchAuthForm(formId) {
            $('.auth-form-modal').removeClass('active');
            $('#' + formId).addClass('active');
            resetAuthForms();

            if (formId === 'modal-login-form') {
                $('#modal-tabs-wrapper').slideDown(200);
                $('#tab-login-btn').addClass('active');
                $('#tab-register-btn').removeClass('active');
            } else if (formId === 'modal-register-form') {
                $('#modal-tabs-wrapper').slideDown(200);
                $('#tab-register-btn').addClass('active');
                $('#tab-login-btn').removeClass('active');
            } else {
                $('#modal-tabs-wrapper').slideUp(200);
            }
        }

        $('#tab-login-btn').click(function() { switchAuthForm('modal-login-form'); });
        $('#tab-register-btn').click(function() { switchAuthForm('modal-register-form'); });
        $('#show-register-form').click(function() { switchAuthForm('modal-register-form'); });
        $('.show-login-form').click(function() { switchAuthForm('modal-login-form'); });
        $('#show-forgot-form').click(function() { switchAuthForm('modal-forgot-form'); });

        $('.password-toggle-modal').on('click', function() {
            var target = $(this).data('target');
            var input = $('#' + target);
            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                $(this).removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                input.attr('type', 'password');
                $(this).removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });

        $('.close-modal-btn-3d').on('click', function () {
            $('#authModal').modal('hide');
        });

        $('#authModal').on('hidden.bs.modal', function () {
            switchAuthForm('modal-login-form');
        });

        // Submit Login
        $('#modal-login-form').submit(function(e) {
            e.preventDefault();
            var form = $(this);
            var btn = form.find('.submit-btn-modal');
            btn.prop('disabled', true).text('Đang đăng nhập...');
            $.post(form.attr('action'), form.serialize(), function(res) {
                if(res.success) {
                    window.location.href = res.redirectUrl;
                } else {
                    showAuthAlert(res.message, false);
                    btn.prop('disabled', false).text('Đăng nhập');
                }
            }).fail(function() {
                showAuthAlert("Có lỗi xảy ra, vui lòng thử lại.", false);
                btn.prop('disabled', false).text('Đăng nhập');
            });
        });

        // Submit Register
        $('#modal-register-form').submit(function(e) {
            e.preventDefault();
            var pass = $('#modal-register-password').val();
            var confirmPass = $('#modal-register-confirm').val();
            if(pass !== confirmPass) {
                showAuthAlert("Mật khẩu xác nhận không khớp.", false);
                return;
            }
            var form = $(this);
            var btn = form.find('.submit-btn-modal');
            btn.prop('disabled', true).text('Đang đăng ký...');
            $.post(form.attr('action'), form.serialize(), function(res) {
                if(res.success) {
                    showAuthAlert(res.message, true);
                    setTimeout(function() { switchAuthForm('modal-login-form'); }, 2000);
                } else {
                    showAuthAlert(res.message, false);
                }
                btn.prop('disabled', false).text('Đăng ký');
            }).fail(function() {
                showAuthAlert("Có lỗi xảy ra, vui lòng thử lại.", false);
                btn.prop('disabled', false).text('Đăng ký');
            });
        });

                // OTP Logic for Forgot Password Modal
        const modalOtpInputs = document.querySelectorAll('.otp-input-modal');
        modalOtpInputs.forEach((input, index) => {
            input.addEventListener('keyup', (e) => {
                if (e.key >= '0' && e.key <= '9') {
                    if (index < modalOtpInputs.length - 1) {
                        modalOtpInputs[index + 1].focus();
                    }
                } else if (e.key === 'Backspace') {
                    if (index > 0) {
                        modalOtpInputs[index - 1].focus();
                    }
                }
            });
        });

        let modalOtpTimerInterval;
        function startModalOtpTimer(duration) {
            let timer = duration, minutes, seconds;
            clearInterval(modalOtpTimerInterval);
            modalOtpTimerInterval = setInterval(function () {
                minutes = parseInt(timer / 60, 10);
                seconds = parseInt(timer % 60, 10);
                minutes = minutes < 10 ? "0" + minutes : minutes;
                seconds = seconds < 10 ? "0" + seconds : seconds;
                $('#modal-timer-count').text(minutes + ":" + seconds);
                if (--timer < 0) {
                    clearInterval(modalOtpTimerInterval);
                    $('#modal-timer-count').text("Hết hạn");
                }
            }, 1000);
        }

        // Show step 1 when opening forgot form
        $('#show-forgot-form').click(function() {
            $('#modal-fp-step-1').show();
            $('#modal-fp-step-2').hide();
            $('#modal-timer-count').text('05:00');
            clearInterval(modalOtpTimerInterval);
            switchAuthForm('modal-forgot-form');
        });

        // Send OTP AJAX
        $('#btn-send-otp-modal').on('click', function () {
            var email = $('#modal-forgot-email').val();
            if (!email) return;
            
            var btn = $(this);
            btn.prop('disabled', true).text('Đang gửi...');

            $.ajax({
                url: '/Account/AjaxForgotPassword',
                type: 'POST',
                data: {
                    Email: email,
                    __RequestVerificationToken: $('#modal-forgot-form input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    btn.prop('disabled', false).text('Gửi mã xác nhận OTP');
                    if (res.success) {
                        $('#modal-fp-step-1').hide();
                        $('#modal-fp-step-2').show();
                        startModalOtpTimer(300); // 5 mins
                        showAuthAlert("Mã OTP đã được gửi đến email của bạn.", true);
                    } else {
                        showAuthAlert(res.message, false);
                    }
                },
                error: function () {
                    btn.prop('disabled', false).text('Gửi mã xác nhận OTP');
                    showAuthAlert("Có lỗi xảy ra. Vui lòng thử lại.", false);
                }
            });
        });

                // Verify OTP AJAX (chuyển sang bước 3)
        $('#btn-verify-otp-modal').on('click', function () {
            var email = $('#modal-forgot-email').val();
            var otp = "";
            $('.otp-input-modal').each(function() { otp += $(this).val(); });
            
            if (otp.length !== 6) {
                showAuthAlert("Vui lòng điền đủ 6 số OTP.", false);
                return;
            }
            
            var btn = $(this);
            btn.prop('disabled', true).text('Đang xác nhận...');

            $.ajax({
                url: '/Account/AjaxVerifyOTP',
                type: 'POST',
                data: {
                    Email: email,
                    OTP: otp,
                    __RequestVerificationToken: $('#modal-forgot-form input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    btn.prop('disabled', false).text('Xác nhận OTP');
                    if (res.success) {
                        $('#modal-fp-step-2').hide();
                        $('#modal-fp-step-3').show();
                        clearInterval(modalOtpTimerInterval); // Dừng đếm ngược
                    } else {
                        showAuthAlert(res.message, false);
                    }
                },
                error: function () {
                    btn.prop('disabled', false).text('Xác nhận OTP');
                    showAuthAlert("Có lỗi xảy ra. Vui lòng thử lại.", false);
                }
            });
        });

        // Submit New Password AJAX
        $('#btn-save-password-modal').on('click', function () {
            var email = $('#modal-forgot-email').val();
            var otp = "";
            $('.otp-input-modal').each(function() { otp += $(this).val(); });
            var newPassword = $('#modal-fp-new-password').val();
            var confirmPassword = $('#modal-fp-confirm-password').val();
            
            if (!newPassword || !confirmPassword) {
                showAuthAlert("Vui lòng điền mật khẩu mới.", false);
                return;
            }
            if (newPassword !== confirmPassword) {
                showAuthAlert("Mật khẩu xác nhận không khớp.", false);
                return;
            }
            
            var btn = $(this);
            btn.prop('disabled', true).text('Đang lưu...');

            $.ajax({
                url: '/Account/AjaxResetPassword',
                type: 'POST',
                data: {
                    Email: email,
                    OTP: otp,
                    NewPassword: newPassword,
                    ConfirmNewPassword: confirmPassword,
                    __RequestVerificationToken: $('#modal-forgot-form input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    btn.prop('disabled', false).text('Lưu mật khẩu mới');
                    if (res.success) {
                        showAuthAlert(res.message, true);
                        setTimeout(function() { switchAuthForm('modal-login-form'); }, 2000);
                    } else {
                        showAuthAlert(res.message, false);
                    }
                },
                error: function () {
                    btn.prop('disabled', false).text('Lưu mật khẩu mới');
                    showAuthAlert("Có lỗi xảy ra. Vui lòng thử lại.", false);
                }
            });
        });
    });</script>

    <!-- AOS - Animate On Scroll Script & Smooth Motion Config -->
