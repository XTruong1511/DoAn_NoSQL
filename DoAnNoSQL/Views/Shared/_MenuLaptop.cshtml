@model DoAnNoSQL.Models.MenuDanhMucViewModel

@* Partial View: Menu Laptop - Submenu thương hiệu động từ database *@

@{
    var danhMuc = Model.DanhMuc;
}

<!-- Danh mục Laptop -->
<a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id })" class="toggle-category">
    <i class="fas fa-laptop"></i> @danhMuc.TenDanhMuc
    @if (Model.SoLuongSanPham > 0)
    {
        <span class="text-xs text-gray-400 ml-1">(@Model.SoLuongSanPham)</span>
    }
</a>

<ul class="category-list">
    <!-- Xem tất cả -->
    <li>
        <a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id })">
   <i class="fas fa-list mr-2"></i> Tất cả laptop
        </a>
    </li>
    
    @* Submenu thương hiệu động từ database *@
    @if (Model.DanhSachThuongHieu != null && Model.DanhSachThuongHieu.Any())
  {
  <li class="submenu-divider">
  <span class="text-xs text-gray-500 font-semibold px-3 py-1 block">Thương hiệu</span>
   </li>
        
        foreach (var thuongHieu in Model.DanhSachThuongHieu)
 {
       <li>
     <a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id, thuongHieuId = thuongHieu.Id })">
@if (!string.IsNullOrEmpty(thuongHieu.HinhAnh))
       {
    <img src="@Url.Content("~/Content/Images/" + thuongHieu.HinhAnh)" 
    alt="@thuongHieu.TenThuongHieu" 
   class="inline-block w-4 h-4 mr-2 object-contain" />
    }
     @thuongHieu.TenThuongHieu
        <span class="text-xs text-gray-400">(@thuongHieu.SoLuongSanPham)</span>
     </a>
          </li>
      }
    }
    else
{
     @* Fallback: Hiển thị thương hiệu hardcoded *@
<li class="submenu-divider">
  <span class="text-xs text-gray-500 font-semibold px-3 py-1 block">Thương hiệu</span>
        </li>
        <li><a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id, thuongHieu = "Dell" })">Dell</a></li>
    <li><a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id, thuongHieu = "HP" })">HP</a></li>
     <li><a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id, thuongHieu = "Apple" })">MacBook</a></li>
  <li><a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id, thuongHieu = "Asus" })">Asus</a></li>
    }
    
    @* Filter theo giá *@
  <li class="submenu-divider">
        <span class="text-xs text-gray-500 font-semibold px-3 py-1 block">Mức giá</span>
    </li>
    <li>
  <a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id, giaMax = 15000000 })">
   <i class="fas fa-dollar-sign text-blue-500 mr-2"></i> Dưới 15 triệu
        </a>
    </li>
    <li>
     <a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id, giaMin = 15000000, giaMax = 25000000 })">
 <i class="fas fa-dollar-sign text-blue-500 mr-2"></i> 15 - 25 triệu
        </a>
    </li>
    <li>
        <a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id, giaMin = 25000000 })">
            <i class="fas fa-dollar-sign text-blue-500 mr-2"></i> Trên 25 triệu
        </a>
    </li>
</ul>
