@model IEnumerable<DoAnNoSQL.Models.MenuDanhMucViewModel>

@* 
    Partial View: Sidebar danh mục sản phẩm bên trái 
    Hiển thị động từ database với submenu thương hiệu
*@

<!--Sidebar - Danh mục bên trái -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <h1 class="text-xl font-bold text-center font-size-3">Danh mục</h1>
    </div>
    <div class="sidebar-menu">
        @if (Model != null && Model.Any())
        {
            @* Duyệt qua từng danh mục từ database *@
            foreach (var menuItem in Model)
            {
                var danhMuc = menuItem.DanhMuc;
                
                @* Xác định Partial View phù hợp dựa trên tên danh mục *@
                string partialViewName = "_CategoryMenuItem"; // Mặc định

                @* Map tên danh mục với Partial View cụ thể (So sánh không phân biệt hoa thường) *@
                if (danhMuc.TenDanhMuc != null)
                {
                    string tenDanhMuc = danhMuc.TenDanhMuc.ToLower().Trim();

                    if (tenDanhMuc.Contains("điện thoại"))
                    {
                        partialViewName = "_MenuDienThoai";
                    }
                    else if (tenDanhMuc.Contains("laptop"))
                    {
                        partialViewName = "_MenuLaptop";
                    }
                    else if (tenDanhMuc.Contains("tablet") || tenDanhMuc.Contains("máy tính bảng"))
                    {
                        partialViewName = "_MenuTablet";
                    }
                    else if (tenDanhMuc.Contains("phụ kiện"))
                    {
                        partialViewName = "_MenuPhuKien";
                    }
                }
                
                @* Render Partial View tương ứng với MenuDanhMucViewModel *@
                @Html.Partial(partialViewName, menuItem)
            }
        }
        else
        {
            @* Hiển thị thông báo nếu không có danh mục nào *@
            <div class="text-center text-gray-500 py-8">
                <i class="fas fa-folder-open text-4xl mb-3"></i>
                <p>Chưa có danh mục nào</p>
            </div>
        }
    </div>
</div>

<!-- Lớp phủ mờ khi sidebar mở -->
<div id="sidebarOverlay" class="sidebar-overlay fixed inset-0 bg-black bg-opacity-50 z-50 hidden"></div>
