                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Xóa</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Thông báo</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body"></div>
        </div>
    </div>

    <!-- Scripts -->
    <!-- jQuery (phải load đầu tiên) -->
    @Scripts.Render("~/bundles/jquery")
    
    <!-- Bootstrap 5 JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="~/Content/Admin.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lazysizes/5.3.2/lazysizes.min.js" async></script>
    
    <script>
        // ==================== NAVIGATION ACTIVE STATE ====================
        function setActive(element) {
            // Xóa active khỏi tất cả nav-link trong sidebar
            document.querySelectorAll('.sidebar .nav-link').forEach(link => {
                link.classList.remove('active');
            });
            // Thêm active cho link vừa click
            element.classList.add('active');
            
            // Close sidebar on mobile after clicking a link
            if (window.innerWidth <= 992) {
                closeSidebar();
            }
        }
        
        // ==================== JQUERY INITIALIZATION (ALTERNATIVE) ====================
        $(document).ready(function() {
            // Set active menu item based on current URL
            const currentPath = window.location.pathname.toLowerCase();
            $('.sidebar .nav-link').each(function() {
                $(this).removeClass('active');
                const linkPath = new URL(this.href, window.location.origin).pathname.toLowerCase();
                if (linkPath === currentPath) {
                    $(this).addClass('active');
                }
            });
            
            // Mobile menu toggle with jQuery
            $('#menuToggle').on('click', function(e) {
                e.stopPropagation();
                toggleSidebar();
            });
            
            // Close sidebar when clicking overlay
            $('#sidebarOverlay').on('click', function() {
                closeSidebar();
            });
            
            // Close sidebar when clicking outside on mobile
            $(document).on('click', function(e) {
                if ($(window).width() <= 992) {
                    const $target = $(e.target);
                    if (!$target.closest('.sidebar').length && 
                        !$target.closest('#menuToggle').length && 
                        $('.sidebar').hasClass('show')) {
                        closeSidebar();
                    }
                }
            });
            
            // Close sidebar on window resize if screen becomes larger
            $(window).on('resize', function() {
                if ($(window).width() > 992) {
                    $('.sidebar').removeClass('show');
                    $('#sidebarOverlay').removeClass('show');
                    $('body').css('overflow', '');
                }
            });
            
            // Close sidebar with ESC key
            $(document).on('keydown', function(e) {
                if (e.key === 'Escape' && $('.sidebar').hasClass('show')) {
                    closeSidebar();
                }
            });
            
            // Make tables responsive
            makeTablesResponsive();

            // Khởi tạo giao diện thanh tìm kiếm bo tròn chuẩn (Admin Search Pill)
            function initSearchPills() {
                $('input[placeholder*="Tìm"]').each(function() {
                    const $parent = $(this).closest('.input-group');
                    if ($parent.length) {
                        $parent.addClass('admin-search-pill');
                    }
                });
            }
            initSearchPills();

            // Auto-search AJAX (Live Search không reload) với Event Delegation
            let searchTimeout;
            
            // Xử lý sự kiện input gõ phím
            $(document).on('input', 'input[placeholder*="Tìm kiếm"]', function() {
                const $input = $(this);
                const $form = $input.closest('form');
                
                if ($form.length) {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(function() {
                        let actionUrl = $form.attr('action');
                        if (!actionUrl) {
                            actionUrl = window.location.pathname;
                        }
                        
                        // Đảm bảo URL trỏ đúng về controller Admin nếu dùng relative path
                        if (!actionUrl.startsWith('/') && !actionUrl.startsWith('http')) {
                            actionUrl = '/Admin/' + actionUrl;
                        }

                        // Build query parameters
                        const params = new URLSearchParams();
                        $.each($form.serializeArray(), function(i, field) {
                            if (field.value.trim() !== '') {
                                params.append(field.name, field.value);
                            }
                        });
                        
                        const queryString = params.toString();
                        const finalUrl = actionUrl + (queryString ? '?' + queryString : '');

                        const $tableContainer = $('.table-container').length ? $('.table-container') : $('.table-responsive, table.table').first().parent();
                        if($tableContainer.length) {
                            $tableContainer.css('opacity', '0.5');
                        }

                        $.ajax({
                            url: finalUrl,
                            type: 'GET',
                            success: function(html) {
                                const $parsed = $($.parseHTML(html));
                                
                                // Thay thế table
                                const $newTable = $parsed.find('table.table').length ? $parsed.find('table.table').first() : $parsed.filter('table.table').first();
                                const $oldTable = $('table.table').first();
                                if ($newTable.length && $oldTable.length) {
                                    $oldTable.html($newTable.html());
                                }
                                
                                // Thay thế pagination
                                const paginationSelector = 'nav[aria-label="Pagination"], nav:has(.pagination)';
                                const $newPagination = $parsed.find(paginationSelector).length ? $parsed.find(paginationSelector).first() : $parsed.filter(paginationSelector).first();
                                const $oldPagination = $(paginationSelector).first();
                                
                                if ($newPagination.length && $oldPagination.length) {
                                    $oldPagination.replaceWith($newPagination);
                                } else if ($newPagination.length && !$oldPagination.length) {
                                    if ($tableContainer.length) {
                                        $tableContainer.append($newPagination);
                                    }
                                } else if (!$newPagination.length && $oldPagination.length) {
                                    $oldPagination.remove();
                                }
                                
                                if($tableContainer.length) {
                                    $tableContainer.css('opacity', '1');
                                }
                                
                                window.history.replaceState({}, '', finalUrl);
                                initSearchPills();
                            },
                            error: function(err) {
                                console.error('AJAX Search Error:', err);
                                if($tableContainer.length) {
                                    $tableContainer.css('opacity', '1');
                                }
                            }
                        });
                    }, 500); // Delay 500ms
                }
            });

            // Chặn tuyệt đối hành vi submit mặc định (reload trang) của các form có ô tìm kiếm
            $(document).on('submit', 'form', function(e) {
                if ($(this).find('input[placeholder*="Tìm kiếm"]').length > 0) {
                    e.preventDefault();
                    // Bạn cũng có thể trigger input event ở đây nếu muốn nút Enter lập tức tìm kiếm thay vì chờ 500ms
                    $(this).find('input[placeholder*="Tìm kiếm"]').trigger('input');
                }
            });
        });
        
        // ==================== VANILLA JS FALLBACK (FOR BROWSERS WITHOUT JQUERY) ====================
        window.addEventListener('DOMContentLoaded', () => {
            // Skip if jQuery already initialized
            if (typeof $ !== 'undefined' && $.fn.jquery) return;
            
            const currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.sidebar .nav-link').forEach(link => {
                link.classList.remove('active');
                const linkPath = new URL(link.href, window.location.origin).pathname.toLowerCase();
                if (linkPath === currentPath) {
                    link.classList.add('active');
                }
            });
            
            // Initialize mobile menu functionality
            initMobileMenu();
            
            // Make tables responsive
            makeTablesResponsive();
        });

        // ==================== MOBILE MENU FUNCTIONALITY ====================
        function initMobileMenu() {
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');

            if (!menuToggle || !sidebar) return;

            // Toggle sidebar on button click
            menuToggle.addEventListener('click', function(e) {
                e.stopPropagation();
                toggleSidebar();
            });

            // Close sidebar when clicking overlay
            if (overlay) {
                overlay.addEventListener('click', function() {
                    closeSidebar();
                });
            }

            // Close sidebar when clicking outside on mobile
            document.addEventListener('click', function(e) {
                if (window.innerWidth <= 992) {
                    if (!sidebar.contains(e.target) && !menuToggle.contains(e.target)) {
                        closeSidebar();
                    }
                }
            });

            // Close sidebar on window resize if screen becomes larger
            window.addEventListener('resize', function() {
                if (window.innerWidth > 992) {
                    sidebar.classList.remove('show');
                    if (overlay) {
                        overlay.classList.remove('show');
                    }
                    document.body.style.overflow = '';
                }
            });
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            sidebar.classList.toggle('show');
            
            if (overlay) {
                overlay.classList.toggle('show');
            }

            // Prevent body scroll when sidebar is open on mobile
            if (sidebar.classList.contains('show')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        }

        function closeSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            sidebar.classList.remove('show');
            
            if (overlay) {
                overlay.classList.remove('show');
            }
            
            document.body.style.overflow = '';
        }

        // ==================== TABLE RESPONSIVENESS ====================
        function makeTablesResponsive() {
            const tables = document.querySelectorAll('table:not(.table-responsive table)');
            
            tables.forEach(table => {
                // Check if table is not already wrapped
                if (!table.parentElement.classList.contains('table-responsive')) {
                    // Create wrapper
                    const wrapper = document.createElement('div');
                    wrapper.className = 'table-responsive';
                    
                    // Wrap the table
                    table.parentNode.insertBefore(wrapper, table);
                    wrapper.appendChild(table);
                }
            });
        }

        // ==================== KEYBOARD ACCESSIBILITY ====================
        document.addEventListener('keydown', function(e) {
            // Close sidebar with ESC key
            if (e.key === 'Escape') {
                const sidebar = document.getElementById('sidebar');
                if (sidebar && sidebar.classList.contains('show')) {
                    closeSidebar();
                }
            }
        });
    </script>

    <!-- AOS - Animate On Scroll Script for Admin -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 500,
                    easing: 'ease-out-cubic',
                    once: true,
                    offset: 20
                });
            }
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
