    <!-- Global Export and Print Functions -->
    <script>
        // Export table to Excel using SheetJS with Auto-Width
        function exportTableToExcel(tableId, filename) {
            try {
                // Get the table element
                const table = document.getElementById(tableId);
                
                if (!table) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: 'Không tìm thấy bảng dữ liệu để xuất'
                    });
                    return;
                }
                
                // Clone the table to modify it without affecting the display
                const clonedTable = table.cloneNode(true);
                
                // Remove action column (last column) if exists
                // Check header first
                const headerRows = clonedTable.querySelectorAll('thead tr');
                let actionColIndex = -1;
                
                headerRows.forEach(row => {
                    const ths = row.querySelectorAll('th');
                    ths.forEach((th, index) => {
                        if (th.textContent.trim().toLowerCase().includes('hành động') || 
                            th.textContent.trim().toLowerCase() === '') {
                            actionColIndex = index;
                            th.remove();
                        }
                    });
                });
                
                // Remove corresponding cells in body
                if (actionColIndex > -1) {
                    const bodyRows = clonedTable.querySelectorAll('tbody tr');
                    bodyRows.forEach(row => {
                        const tds = row.querySelectorAll('td');
                        if (tds[actionColIndex]) {
                            tds[actionColIndex].remove();
                        }
                    });
                } else {
                    // Fallback: Remove last column if it contains action buttons
                    const rows = clonedTable.querySelectorAll('tr');
                    rows.forEach(row => {
                        const lastCell = row.querySelector('th:last-child, td:last-child');
                        if (lastCell && (
                            lastCell.textContent.includes('Hành động') ||
                            lastCell.querySelector('.btn-group') ||
                            lastCell.querySelector('button') ||
                            lastCell.querySelector('a.btn')
                        )) {
                            lastCell.remove();
                        }
                    });
                }
                
                // Create workbook from table
                const wb = XLSX.utils.table_to_book(clonedTable, { sheet: "Sheet1" });
                const ws = wb.Sheets["Sheet1"];
                
                // --- AUTO WIDTH LOGIC ---
                // Calculate max width for each column
                const range = XLSX.utils.decode_range(ws['!ref']);
                const colWidths = [];
                
                for (let C = range.s.c; C <= range.e.c; ++C) {
                    let maxLen = 10; // Min width
                    for (let R = range.s.r; R <= range.e.r; ++R) {
                        const cellAddress = { c: C, r: R };
                        const cellRef = XLSX.utils.encode_cell(cellAddress);
                        const cell = ws[cellRef];
                        if (cell && cell.v) {
                            const len = (cell.v.toString().length + 2); // Add padding
                            if (len > maxLen) maxLen = len;
                        }
                    }
                    colWidths.push({ wch: maxLen });
                }
                ws['!cols'] = colWidths;
                // ------------------------
                
                // Generate filename with timestamp if not provided
                const defaultFilename = filename || `Export_${new Date().toISOString().slice(0,10)}.xlsx`;
                
                // Save the file
                XLSX.writeFile(wb, defaultFilename);
                
                // Show success message
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: 'Đã xuất file Excel thành công',
                    timer: 2000,
                    showConfirmButton: false
                });
            } catch (error) {
                console.error('Export error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Có lỗi xảy ra khi xuất file Excel: ' + error.message
                });
            }
        }
        
        // Print page function
        function printPage() {
            window.print();
        }
        
        // Print specific modal content
        function printModalContent(modalBodyId) {
            const modalBody = document.getElementById(modalBodyId);
            if (!modalBody) return;
            
            const printWindow = window.open('', '_blank');
            printWindow.document.write(`
                <html>
                    <head>
                        <title>In hóa đơn</title>
                        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
                        <style>
                            body { padding: 20px; }
                            table { width: 100%; border-collapse: collapse; }
                            table, th, td { border: 1px solid #000; }
                            th, td { padding: 8px; text-align: left; }
                            @@media print {
                                .no-print { display: none; }
                            }
                        </style>
                    </head>
                    <body>
                        ${modalBody.innerHTML}
                    </body>
                </html>
            `);
            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => {
                printWindow.print();
                printWindow.close();
            }, 250);
        }
    </script>
</head>
