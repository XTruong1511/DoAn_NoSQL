@model DoAnNoSQL.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập / Đăng ký 3D";
    Layout = null;
    string tenCuaHang = DoAnNoSQL.Helpers.SettingsHelper.GetValue("TenCuaHang", "TECH SHOP");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - @tenCuaHang</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/Content/web-3d.css")">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #020617;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #f8fafc;
            overflow-x: hidden;
            position: relative;
        }

        /* 3D Cyber Background Canvas */
        #bg-canvas-starlight {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }

        /* Ambient Glow Spheres */
        .ambient-glow-1 {
            position: fixed;
            top: -10%;
            left: 20%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(20, 184, 166, 0.22) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 1;
            filter: blur(40px);
            animation: floatGlow 12s ease-in-out infinite alternate;
        }

        .ambient-glow-2 {
            position: fixed;
            bottom: -15%;
            right: 10%;
            width: 550px;
            height: 550px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 1;
            filter: blur(50px);
            animation: floatGlow 15s ease-in-out infinite alternate-reverse;
        }

        @@keyframes floatGlow {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(40px, 30px) scale(1.1); }
        }

        /* Perspective Stage */
        .portal-wrapper {
            position: relative;
            z-index: 10;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        /* 3D Glass Auth Container */
        .auth-card-3d {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 28px;
            box-shadow: 
                0 30px 60px -15px rgba(0, 0, 0, 0.65),
                0 0 50px rgba(20, 184, 166, 0.18),
                inset 0 1px 1px rgba(255, 255, 255, 0.15);
            position: relative;
            transform-style: preserve-3d;
            perspective: 1000px;
            transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.3s ease;
            overflow: hidden;
        }

        /* Specular Glare Layer */
        .glare-specular {
            position: absolute;
            inset: 0;
            pointer-events: none;
            border-radius: inherit;
            background: radial-gradient(circle 280px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.18) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.3s ease;
            mix-blend-mode: overlay;
            z-index: 30;
        }

        .auth-card-3d:hover .glare-specular {
            opacity: 1;
        }

        /* Forms Switch Animation */
        .auth-form {
            display: none;
        }

        .auth-form.active {
            display: block;
            animation: fadeInSlide 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes fadeInSlide {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* 3D Modern Form Controls */
        .input-group-3d {
            position: relative;
            margin-bottom: 20px;
        }

        .input-group-3d input {
            width: 100%;
            padding: 14px 16px 14px 44px;
            background: rgba(30, 41, 59, 0.7);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            font-size: 14px;
            font-weight: 500;
            color: #ffffff;
            outline: none;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        .input-group-3d input:focus {
            background: rgba(15, 23, 42, 0.95);
            border-color: #2dd4bf;
            box-shadow: 
                0 0 0 4px rgba(45, 212, 191, 0.18),
                0 4px 12px rgba(20, 184, 166, 0.25),
                inset 0 1px 2px rgba(0, 0, 0, 0.1);
            transform: translateY(-1px);
        }

        .input-group-3d .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 14px;
            transition: color 0.25s ease;
            pointer-events: none;
        }

        .input-group-3d input:focus ~ .input-icon {
            color: #2dd4bf;
        }

        .input-group-3d label {
            position: absolute;
            left: 44px;
            top: 14px;
            color: #94a3b8;
            font-size: 13px;
            font-weight: 500;
            pointer-events: none;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            background: transparent;
            padding: 0 4px;
        }

        .input-group-3d input:focus + label,
        .input-group-3d input:not(:placeholder-shown) + label {
            top: -10px;
            left: 14px;
            font-size: 11px;
            font-weight: 700;
            color: #2dd4bf;
            background: #0f172a;
            border-radius: 6px;
            padding: 1px 8px;
            border: 1px solid rgba(45, 212, 191, 0.3);
        }

        .password-toggle {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #94a3b8;
            transition: color 0.2s;
            font-size: 14px;
            z-index: 2;
        }

        .password-toggle:hover {
            color: #2dd4bf;
        }

        /* 3D Tactile Buttons */
        .btn-3d-action {
            width: 100%;
            padding: 14px 20px;
            background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
            color: #ffffff;
            border: none;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 5px 0 #0f766e, 0 10px 20px rgba(13, 148, 136, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            transform: translateY(0);
        }

        .btn-3d-action:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, #2dd4bf 0%, #0f766e 100%);
            box-shadow: 0 7px 0 #0f766e, 0 14px 25px rgba(20, 184, 166, 0.45);
        }

        .btn-3d-action:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 #0f766e, 0 4px 10px rgba(13, 148, 136, 0.25);
        }

        /* Google 3D Button */
        .btn-google-3d {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            padding: 13px 18px;
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 14px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 0 rgba(0, 0, 0, 0.3), 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .btn-google-3d:hover {
            background: rgba(255, 255, 255, 0.14);
            border-color: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
            box-shadow: 0 6px 0 rgba(0, 0, 0, 0.3), 0 12px 20px rgba(0, 0, 0, 0.3);
        }

        .btn-google-3d:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 rgba(0, 0, 0, 0.3), 0 3px 6px rgba(0, 0, 0, 0.2);
        }

        /* 3D Tab Switcher */
        .cyber-tabs {
            display: flex;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 4px;
            margin-bottom: 24px;
            position: relative;
        }

        .cyber-tab-btn {
            flex: 1;
            padding: 10px 14px;
            font-size: 13px;
            font-weight: 700;
            color: #94a3b8;
            border-radius: 12px;
            border: none;
            background: transparent;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .cyber-tab-btn.active {
            background: linear-gradient(135deg, rgba(20, 184, 166, 0.25) 0%, rgba(13, 148, 136, 0.4) 100%);
            border: 1px solid rgba(45, 212, 191, 0.4);
            color: #2dd4bf;
            box-shadow: 0 0 20px rgba(45, 212, 191, 0.25);
        }

        /* Divider with Cyber Glow */
        .cyber-divider {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 20px 0;
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .cyber-divider::before,
        .cyber-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
        }

        /* OTP 3D Boxes */
        .otp-3d-box {
            width: 48px;
            height: 56px;
            font-size: 24px;
            font-weight: 800;
            text-align: center;
            border: 1.5px solid rgba(255, 255, 255, 0.15);
            border-radius: 14px;
            outline: none;
            background: rgba(30, 41, 59, 0.8);
            color: #2dd4bf;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .otp-3d-box:focus {
            border-color: #2dd4bf;
            background: rgba(15, 23, 42, 0.95);
            box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.25), 0 0 20px rgba(45, 212, 191, 0.3);
            transform: scale(1.06);
        }

        /* 3D Stage HUD Controls */
        .stage-hud-btn {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #94a3b8;
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .stage-hud-btn:hover,
        .stage-hud-btn.active {
            color: #2dd4bf;
            border-color: #2dd4bf;
            background: rgba(20, 184, 166, 0.2);
            box-shadow: 0 0 15px rgba(45, 212, 191, 0.3);
        }

        /* Floating 3D Badges */
        .stage-floating-badge {
            position: absolute;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 14px;
            padding: 8px 14px;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.4);
            animation: badgeFloat 4s ease-in-out infinite;
            pointer-events: none;
            z-index: 20;
        }

        @@keyframes badgeFloat {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(1deg); }
        }
    </style>
</head>
<body>
    <!-- Starlight Ambient Particle Canvas -->
    <canvas id="bg-canvas-starlight"></canvas>

    <!-- Ambient Glowing Nebulae -->
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>

    <!-- Top Floating Navigation: Return to Home -->
    <header class="fixed top-5 left-5 z-50">
        <a href="@Url.Action("Index", "Home")" class="inline-flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-white/10 hover:bg-teal-500/20 text-white hover:text-teal-300 backdrop-blur-xl border border-white/15 hover:border-teal-400/40 text-xs font-bold transition-all duration-300 shadow-xl group">
            <i class="fas fa-arrow-left text-xs transition-transform group-hover:-translate-x-1"></i>
            <span>Về Trang Chủ</span>
        </a>
    </header>

    <!-- Top Right Brand & Status Indicator -->
    <div class="fixed top-5 right-5 z-50 hidden sm:flex items-center gap-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/80 backdrop-blur-xl border border-teal-500/30 text-[11px] font-bold text-teal-300 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
            <span class="w-2 h-2 rounded-full bg-teal-400 -ml-4"></span>
            <span>HỆ THỐNG TRỰC TUYẾN</span>
        </div>
    </div>

    <!-- Main 3D Split-Screen Portal -->
    <main class="portal-wrapper">
        <div class="w-full max-w-6xl grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
            
            <!-- LEFT COLUMN (7 Cols): 3D Cyber Quantum Stage -->
            <div class="lg:col-span-7 hidden lg:block">
                <div class="space-y-4 mb-6">
                    <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-400/30 text-teal-300 text-xs font-bold tracking-wider uppercase">
                        <i class="fas fa-cube text-teal-400"></i>
                        <span>TechStore Next-Gen Ecosystem</span>
                    </div>
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight font-heading leading-tight">
                        Cổng Mua Sắm <br/>
                        <span class="bg-gradient-to-r from-teal-400 via-emerald-300 to-cyan-400 bg-clip-text text-transparent">Công Nghệ Số</span> Hiện Đại
                    </h1>
                    <p class="text-sm sm:text-base text-slate-400 max-w-xl leading-relaxed">
                        Trải nghiệm xoay đa chiều 360°, đổi màu vỏ máy Titanium theo thời gian thực và quản lý đơn hàng bằng cơ sở dữ liệu MongoDB hiệu năng cao.
                    </p>
                </div>

                <!-- 3D Three.js Interactive Stage Box -->
                <div class="auth-3d-stage-box h-[440px] relative border-beam-3d" id="auth-stage-container">
                    <div id="auth-3d-canvas-wrap" class="stage-canvas">
                        <!-- Three.js Canvas injected here -->
                    </div>

                    <!-- Floating Badges overlay in 3D Space -->
                    <div class="stage-floating-badge top-5 left-5 text-teal-300 border-teal-400/30">
                        <div class="w-7 h-7 rounded-lg bg-teal-500/20 flex items-center justify-center text-teal-300">
                            <i class="fas fa-shield-halved text-sm"></i>
                        </div>
                        <div>
                            <div class="text-[11px] uppercase tracking-wider text-slate-400">Bảo Mật NoSQL</div>
                            <div class="text-xs font-bold text-white">Mã hóa 256-Bit Chuẩn ISO</div>
                        </div>
                    </div>

                    <div class="stage-floating-badge bottom-16 left-6 text-indigo-300 border-indigo-400/30" style="animation-delay: -2s;">
                        <div class="w-7 h-7 rounded-lg bg-indigo-500/20 flex items-center justify-center text-indigo-300">
                            <i class="fas fa-bolt text-sm"></i>
                        </div>
                        <div>
                            <div class="text-[11px] uppercase tracking-wider text-slate-400">Tốc Độ Phản Hồi</div>
                            <div class="text-xs font-bold text-white">MongoDB Tức Thì &lt; 15ms</div>
                        </div>
                    </div>

                    <div class="stage-floating-badge top-6 right-6 text-amber-300 border-amber-400/30" style="animation-delay: -1s;">
                        <div class="w-7 h-7 rounded-lg bg-amber-500/20 flex items-center justify-center text-amber-300">
                            <i class="fas fa-rotate text-sm"></i>
                        </div>
                        <div>
                            <div class="text-[11px] uppercase tracking-wider text-slate-400">Trải Nghiệm</div>
                            <div class="text-xs font-bold text-white">Tương Tác 360° Studio</div>
                        </div>
                    </div>

                    <!-- Interactive HUD Bar at Bottom -->
                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 bg-slate-950/80 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10 shadow-2xl">
                        <button type="button" id="hud-toggle-spin" class="stage-hud-btn active" title="Tự động xoay">
                            <i class="fas fa-sync-alt"></i> <span>Quay 360°</span>
                        </button>
                        <button type="button" id="hud-model-cube" class="stage-hud-btn active" data-model="cube" title="Quantum Core">
                            <i class="fas fa-cube"></i> <span>Lõi Quantum</span>
                        </button>
                        <button type="button" id="hud-model-phone" class="stage-hud-btn" data-model="phone" title="Flagship Phone">
                            <i class="fas fa-mobile-alt"></i> <span>Flagship Phone</span>
                        </button>
                        <button type="button" id="hud-reset-view" class="stage-hud-btn" title="Đặt lại góc nhìn">
                            <i class="fas fa-crosshairs"></i> <span>Góc Chuẩn</span>
                        </button>
                    </div>
                </div>

                <!-- Footer Feature Pills -->
                <div class="grid grid-cols-3 gap-3 mt-4">
                    <div class="p-3 rounded-2xl bg-white/5 border border-white/10 text-center">
                        <div class="text-teal-400 text-lg mb-1"><i class="fas fa-microchip"></i></div>
                        <div class="text-xs font-bold text-slate-200">Phần Cứng</div>
                        <div class="text-[10px] text-slate-400">Chính Hãng 100%</div>
                    </div>
                    <div class="p-3 rounded-2xl bg-white/5 border border-white/10 text-center">
                        <div class="text-indigo-400 text-lg mb-1"><i class="fas fa-fingerprint"></i></div>
                        <div class="text-xs font-bold text-slate-200">Google OAuth</div>
                        <div class="text-[10px] text-slate-400">Đăng Nhập 1 Chạm</div>
                    </div>
                    <div class="p-3 rounded-2xl bg-white/5 border border-white/10 text-center">
                        <div class="text-emerald-400 text-lg mb-1"><i class="fas fa-award"></i></div>
                        <div class="text-xs font-bold text-slate-200">Bảo Hành VIP</div>
                        <div class="text-[10px] text-slate-400">Tra Cứu Trực Tuyến</div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN (5 Cols): 3D Glassmorphic Auth Deck -->
            <div class="lg:col-span-5 w-full max-w-md mx-auto">
                <div class="auth-card-3d p-6 sm:p-8 border-beam-3d" id="auth-interactive-card">
                    <!-- Specular Light Glare Element -->
                    <div class="glare-specular"></div>

                    <!-- Header Brand Logo Icon -->
                    <div class="text-center mb-6">
                        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-teal-500 to-emerald-400 text-white text-2xl shadow-xl shadow-teal-500/30 mb-3 transform hover:rotate-12 transition-transform duration-300">
                            <i class="fas fa-cube"></i>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-black text-white font-heading tracking-tight">@tenCuaHang</h2>
                        <p class="text-xs text-slate-400 mt-0.5">Hệ thống Xác Thực An Toàn Đa Lớp</p>
                    </div>

                    <!-- Alert Messages -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="p-3 mb-4 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold flex items-center gap-2">
                            <i class="fas fa-check-circle text-emerald-400"></i>
                            <span>@TempData["SuccessMessage"]</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                    {
                        <div class="p-3 mb-4 rounded-xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-bold flex items-center gap-2">
                            <i class="fas fa-exclamation-circle text-rose-400"></i>
                            <span>@ViewBag.ErrorMessage</span>
                        </div>
                    }

                    <!-- 3D Mode Tab Switcher: Đăng nhập vs Đăng ký -->
                    <div class="cyber-tabs" id="auth-tabs-group">
                        <button type="button" class="cyber-tab-btn active" id="tab-btn-login">
                            <i class="fas fa-right-to-bracket text-xs"></i>
                            <span>Đăng nhập</span>
                        </button>
                        <button type="button" class="cyber-tab-btn" id="tab-btn-register">
                            <i class="fas fa-user-plus text-xs"></i>
                            <span>Đăng ký</span>
                        </button>
                    </div>

                    <!-- ==========================================
                         FORM 1: ĐĂNG NHẬP
                         ========================================== -->
                    @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "auth-form active", id = "login-form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "p-3 mb-4 rounded-xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-semibold" })

                        <div class="input-group-3d">
                            @Html.TextBoxFor(m => m.EmailOrPhone, new
                            {
                                @class = "form-control",
                                placeholder = " ",
                                id = "login-email",
                                type = "text",
                                required = "required",
                                autocomplete = "username"
                            })
                            @Html.LabelFor(m => m.EmailOrPhone, "Email hoặc Số điện thoại", new { @class = "label" })
                            <i class="fas fa-user input-icon"></i>
                            @Html.ValidationMessageFor(m => m.EmailOrPhone, "", new { @class = "text-xs text-rose-400 font-semibold mt-1 block" })
                        </div>

                        <div class="input-group-3d">
                            @Html.PasswordFor(m => m.Password, new
                            {
                                @class = "form-control",
                                placeholder = " ",
                                id = "login-password",
                                required = "required",
                                autocomplete = "current-password"
                            })
                            @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "label" })
                            <i class="fas fa-lock input-icon"></i>
                            <i class="fas fa-eye password-toggle" data-target="login-password"></i>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-xs text-rose-400 font-semibold mt-1 block" })
                        </div>

                        <div class="flex items-center justify-between text-xs mb-5">
                            <label class="flex items-center gap-2 cursor-pointer text-slate-300 hover:text-white">
                                <input type="checkbox" name="RememberMe" class="rounded border-slate-600 bg-slate-800 text-teal-500 focus:ring-teal-400/30" />
                                <span>Ghi nhớ tôi</span>
                            </label>
                            <a href="#" id="show-forgot-form" class="font-bold text-teal-400 hover:text-teal-300 transition-colors flex items-center gap-1">
                                <i class="fas fa-key text-[10px]"></i>
                                <span>Quên mật khẩu?</span>
                            </a>
                        </div>

                        <button class="btn-3d-action mb-4" type="submit">
                            <i class="fas fa-arrow-right-to-bracket"></i>
                            <span>Đăng Nhập Ngay</span>
                        </button>

                        <!-- Google Sign-In One Tap Anchor -->
                        <div id="g_id_onload"
                             data-client_id="875214279930-h0d47gbbmvodj3mejnkb3k89dj3esalo.apps.googleusercontent.com"
                             data-context="signin"
                             data-ux_mode="popup"
                             data-callback="handleGoogleLogin"
                             data-auto_prompt="false">
                        </div>

                        <div class="cyber-divider">Hoặc tiếp tục bằng</div>

                        <button type="button" class="btn-google-3d" onclick="triggerGoogleLogin()">
                            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            <span>Đăng nhập qua Google</span>
                        </button>

                        <div class="text-center mt-5 text-xs text-slate-400">
                            Chưa có tài khoản? <a id="switch-to-register" href="javascript:void(0);" class="text-teal-400 font-bold hover:underline">Tạo tài khoản mới</a>
                        </div>
                    }

                    <!-- Form ẩn để submit Google Token -->
                    <form id="google-login-form" action="@Url.Action("GoogleLogin", "Account")" method="POST" style="display: none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="credential" id="google-credential" />
                    </form>

                    <!-- ==========================================
                         FORM 2: ĐĂNG KÝ
                         ========================================== -->
                    <form action="@Url.Action("Register", "Account")" method="post" class="auth-form" id="register-form">
                        @Html.AntiForgeryToken()

                        <div class="input-group-3d">
                            <input type="text" name="FullName" id="fullname" placeholder=" " required autocomplete="name" />
                            <label for="fullname">Họ và tên</label>
                            <i class="fas fa-id-card input-icon"></i>
                        </div>

                        <div class="input-group-3d">
                            <input type="email" name="Email" id="register-email" placeholder=" " required autocomplete="email" />
                            <label for="register-email">Địa chỉ Email</label>
                            <i class="fas fa-envelope input-icon"></i>
                        </div>

                        <div class="input-group-3d">
                            <input type="password" name="Password" id="register-password" placeholder=" " required autocomplete="new-password" />
                            <label for="register-password">Mật khẩu</label>
                            <i class="fas fa-lock input-icon"></i>
                            <i class="fas fa-eye password-toggle" data-target="register-password"></i>
                        </div>

                        <div class="input-group-3d">
                            <input type="password" name="ConfirmPassword" id="confirm-password" placeholder=" " required autocomplete="new-password" />
                            <label for="confirm-password">Xác nhận mật khẩu</label>
                            <i class="fas fa-shield-check input-icon"></i>
                            <i class="fas fa-eye password-toggle" data-target="confirm-password"></i>
                        </div>

                        <button class="btn-3d-action mb-4" type="submit">
                            <i class="fas fa-user-plus"></i>
                            <span>Tạo Tài Khoản</span>
                        </button>

                        <div class="text-center mt-5 text-xs text-slate-400">
                            Đã có tài khoản? <a id="switch-to-login" href="javascript:void(0);" class="text-teal-400 font-bold hover:underline">Đăng nhập ngay</a>
                        </div>
                    </form>

                    <!-- ==========================================
                         FORM 3: QUÊN MẬT KHẨU (AJAX OTP)
                         ========================================== -->
                    <form id="forgot-password-form" class="auth-form">
                        <div class="mb-4 text-center">
                            <h3 class="text-lg font-bold text-white">Khôi Phục Mật Khẩu</h3>
                            <p class="text-xs text-slate-400 mt-1">Xác thực mã OTP gửi về hòm thư điện tử</p>
                        </div>
                        
                        <div id="fp-alert" class="p-3 mb-4 rounded-xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-semibold" style="display: none;"></div>

                        <!-- Bước 1: Nhập Email -->
                        <div id="fp-step-1">
                            <div class="input-group-3d">
                                <input type="email" id="fp-email" name="Email" placeholder=" " required autocomplete="email" />
                                <label for="fp-email">Nhập Email tài khoản</label>
                                <i class="fas fa-envelope input-icon"></i>
                            </div>
                            <button type="button" class="btn-3d-action" id="btn-send-otp">
                                <i class="fas fa-paper-plane"></i>
                                <span>Gửi Mã Xác Nhận OTP</span>
                            </button>
                        </div>

                        <!-- Bước 2: Nhập OTP và Mật khẩu mới -->
                        <div id="fp-step-2" style="display: none;">
                            <div class="text-center mb-3">
                                <span class="text-xs text-slate-400">Nhập mã 6 chữ số vừa nhận:</span>
                            </div>
                            
                            <div class="flex items-center justify-center gap-2 mb-4" id="otp-inputs">
                                <input type="text" class="otp-3d-box" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                <input type="text" class="otp-3d-box" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                <input type="text" class="otp-3d-box" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                <input type="text" class="otp-3d-box" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                <input type="text" class="otp-3d-box" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                                <input type="text" class="otp-3d-box" maxlength="1" pattern="[0-9]*" inputmode="numeric" />
                            </div>
                            
                            <div class="text-center text-xs text-slate-400 mb-4" id="otp-timer-display">
                                Mã có hiệu lực trong: <span class="text-teal-400 font-extrabold text-sm ml-1" id="timer-count">05:00</span>
                            </div>

                            <div class="input-group-3d">
                                <input type="password" id="fp-new-password" name="NewPassword" placeholder=" " required autocomplete="new-password" />
                                <label for="fp-new-password">Mật khẩu mới</label>
                                <i class="fas fa-lock input-icon"></i>
                                <i class="fas fa-eye password-toggle" data-target="fp-new-password"></i>
                            </div>

                            <div class="input-group-3d">
                                <input type="password" id="fp-confirm-password" name="ConfirmNewPassword" placeholder=" " required autocomplete="new-password" />
                                <label for="fp-confirm-password">Xác nhận mật khẩu mới</label>
                                <i class="fas fa-shield-check input-icon"></i>
                                <i class="fas fa-eye password-toggle" data-target="fp-confirm-password"></i>
                            </div>

                            <button type="button" class="btn-3d-action" id="btn-verify-otp">
                                <i class="fas fa-check-double"></i>
                                <span>Xác Nhận Đổi Mật Khẩu</span>
                            </button>
                        </div>

                        <div class="text-center mt-5 text-xs">
                            <a id="show-login-from-fp" href="javascript:void(0);" class="text-slate-400 hover:text-white transition flex items-center justify-center gap-1">
                                <i class="fas fa-arrow-left text-[10px]"></i>
                                <span>Quay lại đăng nhập</span>
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </main>

    <!-- Three.js CDN Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- jQuery CDN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- JavaScript: Three.js Interactive Quantum Core & Card 3D Tilt -->
    <script>
        (function () {
            'use strict';

            // ===================================================================
            // 1. STARLIGHT AMBIENT BACKGROUND CANVAS
            // ===================================================================
            var bgCanvas = document.getElementById('bg-canvas-starlight');
            if (bgCanvas) {
                var bgCtx = bgCanvas.getContext('2d');
                var bgW = (bgCanvas.width = window.innerWidth);
                var bgH = (bgCanvas.height = window.innerHeight);

                var stars = [];
                var numStars = window.innerWidth > 768 ? 85 : 40;
                for (var s = 0; s < numStars; s++) {
                    stars.push({
                        x: Math.random() * bgW,
                        y: Math.random() * bgH,
                        size: Math.random() * 1.8 + 0.5,
                        speed: Math.random() * 0.35 + 0.1,
                        color: Math.random() > 0.5 ? '#14b8a6' : '#38bdf8',
                        alpha: Math.random() * 0.7 + 0.2
                    });
                }

                window.addEventListener('resize', function () {
                    bgW = bgCanvas.width = window.innerWidth;
                    bgH = bgCanvas.height = window.innerHeight;
                });

                function loopBgStars() {
                    bgCtx.clearRect(0, 0, bgW, bgH);
                    for (var i = 0; i < stars.length; i++) {
                        var st = stars[i];
                        st.y -= st.speed;
                        if (st.y < 0) st.y = bgH;

                        bgCtx.beginPath();
                        bgCtx.arc(st.x, st.y, st.size, 0, Math.PI * 2);
                        bgCtx.fillStyle = st.color;
                        bgCtx.globalAlpha = st.alpha;
                        bgCtx.shadowBlur = 6;
                        bgCtx.shadowColor = st.color;
                        bgCtx.fill();
                    }
                    requestAnimationFrame(loopBgStars);
                }
                loopBgStars();
            }

            // ===================================================================
            // 2. HARDWARE-ACCELERATED CARD 3D TILT ENGINE & SPECULAR GLARE
            // ===================================================================
            var card = document.getElementById('auth-interactive-card');
            if (card) {
                var bounds = null;

                function updateCardBounds() {
                    bounds = card.getBoundingClientRect();
                }

                card.addEventListener('mouseenter', updateCardBounds);
                window.addEventListener('resize', updateCardBounds);

                card.addEventListener('mousemove', function (e) {
                    if (!bounds) updateCardBounds();
                    var mouseX = e.clientX - bounds.left;
                    var mouseY = e.clientY - bounds.top;

                    var percentX = (mouseX / bounds.width) * 100;
                    var percentY = (mouseY / bounds.height) * 100;

                    var tiltX = ((mouseY / bounds.height) - 0.5) * -14;
                    var tiltY = ((mouseX / bounds.width) - 0.5) * 14;

                    card.style.transform = 'perspective(1000px) rotateX(' + tiltX.toFixed(2) + 'deg) rotateY(' + tiltY.toFixed(2) + 'deg) translateZ(8px)';
                    card.style.setProperty('--mouse-x', percentX.toFixed(1) + '%');
                    card.style.setProperty('--mouse-y', percentY.toFixed(1) + '%');
                });

                card.addEventListener('mouseleave', function () {
                    card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
                    card.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
                    setTimeout(function () {
                        card.style.transition = '';
                    }, 500);
                });
            }

            // ===================================================================
            // 3. THREE.JS 3D QUANTUM CYBER CORE STAGE
            // ===================================================================
            var stageContainer = document.getElementById('auth-3d-canvas-wrap');
            if (stageContainer && typeof THREE !== 'undefined') {
                var stageWidth = stageContainer.clientWidth || 550;
                var stageHeight = stageContainer.clientHeight || 440;

                var scene = new THREE.Scene();
                var camera = new THREE.PerspectiveCamera(45, stageWidth / stageHeight, 0.1, 1000);
                camera.position.set(0, 0, 8.5);

                var renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'high-performance' });
                renderer.setSize(stageWidth, stageHeight);
                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                renderer.toneMapping = THREE.ACESFilmicToneMapping;
                renderer.toneMappingExposure = 1.3;
                stageContainer.appendChild(renderer.domElement);

                // Lighting Setup
                var ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
                scene.add(ambientLight);

                var keyLight = new THREE.DirectionalLight(0x2dd4bf, 2.5); // Teal light
                keyLight.position.set(6, 6, 7);
                scene.add(keyLight);

                var rimLight = new THREE.DirectionalLight(0x6366f1, 2.2); // Indigo rim
                rimLight.position.set(-6, -4, -4);
                scene.add(rimLight);

                var centerLight = new THREE.PointLight(0x14b8a6, 2.5, 15);
                centerLight.position.set(0, 0, 2);
                scene.add(centerLight);

                // Main Core Group
                var coreGroup = new THREE.Group();
                scene.add(coreGroup);

                var ring1, ring2, ring3, innerMesh, wireCube, particlesMesh;
                var currentModelType = 'cube';
                var autoRotate = true;

                function buildQuantumCore(type) {
                    while (coreGroup.children.length > 0) {
                        coreGroup.remove(coreGroup.children[0]);
                    }

                    if (type === 'phone') {
                        // Flagship Phone 3D
                        var pGeom = new THREE.BoxGeometry(2.2, 4.4, 0.2);
                        var pMat = new THREE.MeshPhysicalMaterial({
                            color: 0x0f172a,
                            metalness: 0.9,
                            roughness: 0.15,
                            clearcoat: 1.0,
                            clearcoatRoughness: 0.1
                        });
                        var phone = new THREE.Mesh(pGeom, pMat);
                        coreGroup.add(phone);

                        // Hologram Screen
                        var scrGeom = new THREE.PlaneGeometry(2.05, 4.2);
                        var sCanvas = document.createElement('canvas');
                        sCanvas.width = 512;
                        sCanvas.height = 1024;
                        var sCtx = sCanvas.getContext('2d');
                        var grad = sCtx.createLinearGradient(0, 0, 512, 1024);
                        grad.addColorStop(0, '#090d16');
                        grad.addColorStop(0.4, '#0f766e');
                        grad.addColorStop(0.8, '#0284c7');
                        grad.addColorStop(1, '#6366f1');
                        sCtx.fillStyle = grad;
                        sCtx.fillRect(0, 0, 512, 1024);
                        sCtx.fillStyle = '#ffffff';
                        sCtx.font = 'bold 44px sans-serif';
                        sCtx.fillText('TECHSTORE 3D', 90, 420);
                        sCtx.font = '24px sans-serif';
                        sCtx.fillStyle = '#99f6e4';
                        sCtx.fillText('Quantum Auth Safe', 130, 480);

                        var scrTex = new THREE.CanvasTexture(sCanvas);
                        var scrMat = new THREE.MeshBasicMaterial({ map: scrTex });
                        var scr = new THREE.Mesh(scrGeom, scrMat);
                        scr.position.z = 0.11;
                        coreGroup.add(scr);

                        // Orbit Ring around phone
                        var rGeom = new THREE.TorusGeometry(3.2, 0.025, 16, 80);
                        var rMat = new THREE.MeshBasicMaterial({ color: 0x2dd4bf });
                        ring1 = new THREE.Mesh(rGeom, rMat);
                        ring1.rotation.x = Math.PI / 3;
                        coreGroup.add(ring1);

                    } else {
                        // Quantum Core Holographic Cube
                        var cubeGeom = new THREE.BoxGeometry(2.5, 2.5, 2.5);
                        var cubeMat = new THREE.MeshStandardMaterial({
                            color: 0x0f172a,
                            metalness: 0.9,
                            roughness: 0.2,
                            wireframe: false
                        });
                        innerMesh = new THREE.Mesh(cubeGeom, cubeMat);
                        coreGroup.add(innerMesh);

                        // Wireframe Outer Cage
                        var wireGeom = new THREE.BoxGeometry(2.9, 2.9, 2.9);
                        var wireMat = new THREE.MeshBasicMaterial({
                            color: 0x2dd4bf,
                            wireframe: true
                        });
                        wireCube = new THREE.Mesh(wireGeom, wireMat);
                        coreGroup.add(wireCube);

                        // Inner Pulsing Icosahedron Core
                        var icoGeom = new THREE.IcosahedronGeometry(1.2, 0);
                        var icoMat = new THREE.MeshPhysicalMaterial({
                            color: 0x6366f1,
                            emissive: 0x0f766e,
                            emissiveIntensity: 0.6,
                            roughness: 0.1,
                            metalness: 0.8
                        });
                        var ico = new THREE.Mesh(icoGeom, icoMat);
                        coreGroup.add(ico);

                        // Ring 1 (Teal)
                        var rGeom1 = new THREE.TorusGeometry(3.3, 0.02, 16, 90);
                        var rMat1 = new THREE.MeshBasicMaterial({ color: 0x2dd4bf });
                        ring1 = new THREE.Mesh(rGeom1, rMat1);
                        ring1.rotation.x = Math.PI / 3;
                        coreGroup.add(ring1);

                        // Ring 2 (Indigo)
                        var rGeom2 = new THREE.TorusGeometry(3.6, 0.018, 16, 90);
                        var rMat2 = new THREE.MeshBasicMaterial({ color: 0x818cf8 });
                        ring2 = new THREE.Mesh(rGeom2, rMat2);
                        ring2.rotation.y = Math.PI / 4;
                        coreGroup.add(ring2);

                        // Ring 3 (Cyan)
                        var rGeom3 = new THREE.TorusGeometry(3.9, 0.015, 16, 90);
                        var rMat3 = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
                        ring3 = new THREE.Mesh(rGeom3, rMat3);
                        ring3.rotation.z = Math.PI / 2.5;
                        coreGroup.add(ring3);
                    }

                    // Ambient Floating Particle Swarm (160 particles)
                    var pCount = 160;
                    var pGeomData = new THREE.BufferGeometry();
                    var pPositions = new Float32Array(pCount * 3);
                    for (var p = 0; p < pCount * 3; p += 3) {
                        pPositions[p] = (Math.random() - 0.5) * 14;
                        pPositions[p + 1] = (Math.random() - 0.5) * 12;
                        pPositions[p + 2] = (Math.random() - 0.5) * 10;
                    }
                    pGeomData.setAttribute('position', new THREE.BufferAttribute(pPositions, 3));
                    var pMatData = new THREE.PointsMaterial({
                        color: 0x5eead4,
                        size: 0.08,
                        transparent: true,
                        opacity: 0.7
                    });
                    particlesMesh = new THREE.Points(pGeomData, pMatData);
                    coreGroup.add(particlesMesh);
                }

                buildQuantumCore('cube');

                // Mouse Drag & Tilt Interaction
                var isDragging = false;
                var prevMouse = { x: 0, y: 0 };
                var targetRotX = 0.2;
                var targetRotY = -0.3;

                stageContainer.addEventListener('mousedown', function (e) {
                    isDragging = true;
                    prevMouse = { x: e.clientX, y: e.clientY };
                });

                window.addEventListener('mouseup', function () {
                    isDragging = false;
                });

                stageContainer.addEventListener('mousemove', function (e) {
                    if (isDragging) {
                        var deltaX = e.clientX - prevMouse.x;
                        var deltaY = e.clientY - prevMouse.y;
                        targetRotY += deltaX * 0.008;
                        targetRotX += deltaY * 0.008;
                        prevMouse = { x: e.clientX, y: e.clientY };
                    } else {
                        // Smooth parallax hover
                        var rect = stageContainer.getBoundingClientRect();
                        var relX = (e.clientX - rect.left) / rect.width - 0.5;
                        var relY = (e.clientY - rect.top) / rect.height - 0.5;
                        targetRotY = -0.3 + relX * 0.6;
                        targetRotX = 0.2 + relY * 0.4;
                    }
                });

                // Resize handler
                window.addEventListener('resize', function () {
                    if (!stageContainer || !camera || !renderer) return;
                    var w = stageContainer.clientWidth || 550;
                    var h = stageContainer.clientHeight || 440;
                    camera.aspect = w / h;
                    camera.updateProjectionMatrix();
                    renderer.setSize(w, h);
                });

                // HUD Controls
                $('#hud-toggle-spin').on('click', function () {
                    autoRotate = !autoRotate;
                    $(this).toggleClass('active', autoRotate);
                });

                $('#hud-model-cube').on('click', function () {
                    $('.stage-hud-btn[data-model]').removeClass('active');
                    $(this).addClass('active');
                    buildQuantumCore('cube');
                });

                $('#hud-model-phone').on('click', function () {
                    $('.stage-hud-btn[data-model]').removeClass('active');
                    $(this).addClass('active');
                    buildQuantumCore('phone');
                });

                $('#hud-reset-view').on('click', function () {
                    targetRotX = 0.2;
                    targetRotY = -0.3;
                });

                // Animation Render Loop
                var clock = new THREE.Clock();
                function animateStage() {
                    requestAnimationFrame(animateStage);
                    var dt = clock.getDelta();

                    if (autoRotate && !isDragging) {
                        coreGroup.rotation.y += dt * 0.4;
                    } else {
                        coreGroup.rotation.y += (targetRotY - coreGroup.rotation.y) * 0.1;
                        coreGroup.rotation.x += (targetRotX - coreGroup.rotation.x) * 0.1;
                    }

                    if (wireCube) {
                        wireCube.rotation.x += dt * 0.2;
                        wireCube.rotation.y -= dt * 0.3;
                    }

                    if (ring1) ring1.rotation.z += dt * 0.7;
                    if (ring2) ring2.rotation.z -= dt * 0.5;
                    if (ring3) ring3.rotation.x += dt * 0.6;

                    if (particlesMesh) {
                        particlesMesh.rotation.y += dt * 0.06;
                    }

                    renderer.render(scene, camera);
                }
                animateStage();
            }

            // ===================================================================
            // 4. UI TAB NAVIGATION & FORM CONTROLS
            // ===================================================================
            $(document).ready(function () {
                // Tab click handlers
                $('#tab-btn-login, #switch-to-login').on('click', function (e) {
                    e.preventDefault();
                    $('#tab-btn-register').removeClass('active');
                    $('#tab-btn-login').addClass('active');
                    $('.auth-form').removeClass('active');
                    $('#login-form').addClass('active');
                });

                $('#tab-btn-register, #switch-to-register').on('click', function (e) {
                    e.preventDefault();
                    $('#tab-btn-login').removeClass('active');
                    $('#tab-btn-register').addClass('active');
                    $('.auth-form').removeClass('active');
                    $('#register-form').addClass('active');
                });

                // Forgot Password toggle
                $('#show-forgot-form').on('click', function (e) {
                    e.preventDefault();
                    $('.cyber-tab-btn').removeClass('active');
                    $('.auth-form').removeClass('active');
                    $('#forgot-password-form').addClass('active');
                    $('#fp-step-1').show();
                    $('#fp-step-2').hide();
                    $('#fp-alert').hide();
                });

                $('#show-login-from-fp').on('click', function (e) {
                    e.preventDefault();
                    $('#tab-btn-login').click();
                });

                // Toggle Password visibility
                $('.password-toggle').on('click', function () {
                    var target = $(this).data('target');
                    var input = $('#' + target);
                    if (input.attr('type') === 'password') {
                        input.attr('type', 'text');
                        $(this).removeClass('fa-eye').addClass('fa-eye-slash text-teal-400');
                    } else {
                        input.attr('type', 'password');
                        $(this).removeClass('fa-eye-slash text-teal-400').addClass('fa-eye');
                    }
                });

                // OTP Auto-jumping logic
                const otpInputs = document.querySelectorAll('.otp-3d-box');
                otpInputs.forEach((input, index) => {
                    input.addEventListener('keyup', (e) => {
                        if (e.key >= '0' && e.key <= '9') {
                            if (index < otpInputs.length - 1) {
                                otpInputs[index + 1].focus();
                            }
                        } else if (e.key === 'Backspace') {
                            if (index > 0) {
                                otpInputs[index - 1].focus();
                            }
                        }
                    });
                });

                // OTP Countdown Timer
                let otpTimerInterval;
                function startOtpTimer(duration) {
                    let timer = duration, minutes, seconds;
                    clearInterval(otpTimerInterval);
                    otpTimerInterval = setInterval(function () {
                        minutes = parseInt(timer / 60, 10);
                        seconds = parseInt(timer % 60, 10);
                        minutes = minutes < 10 ? "0" + minutes : minutes;
                        seconds = seconds < 10 ? "0" + seconds : seconds;
                        $('#timer-count').text(minutes + ":" + seconds);
                        if (--timer < 0) {
                            clearInterval(otpTimerInterval);
                            $('#timer-count').text("Hết hạn");
                        }
                    }, 1000);
                }

                // Send OTP AJAX
                $('#btn-send-otp').on('click', function () {
                    var email = $('#fp-email').val();
                    if (!email) {
                        $('#fp-alert').text("Vui lòng nhập địa chỉ email của bạn.").show();
                        return;
                    }
                    
                    var btn = $(this);
                    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> <span>Đang gửi mã...</span>');

                    $.ajax({
                        url: '@Url.Action("AjaxForgotPassword", "Account")',
                        type: 'POST',
                        data: {
                            Email: email,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (res) {
                            btn.prop('disabled', false).html('<i class="fas fa-paper-plane"></i> <span>Gửi Mã Xác Nhận OTP</span>');
                            if (res.success) {
                                $('#fp-alert').hide();
                                $('#fp-step-1').hide();
                                $('#fp-step-2').show();
                                startOtpTimer(300); // 5 minutes
                            } else {
                                $('#fp-alert').text(res.message).show();
                            }
                        },
                        error: function () {
                            btn.prop('disabled', false).html('<i class="fas fa-paper-plane"></i> <span>Gửi Mã Xác Nhận OTP</span>');
                            $('#fp-alert').text("Có lỗi kết nối máy chủ. Vui lòng thử lại.").show();
                        }
                    });
                });

                // Verify OTP and Reset AJAX
                $('#btn-verify-otp').on('click', function () {
                    var email = $('#fp-email').val();
                    var newPassword = $('#fp-new-password').val();
                    var confirmPassword = $('#fp-confirm-password').val();
                    
                    var otp = "";
                    $('.otp-3d-box').each(function() { otp += $(this).val(); });
                    
                    if (otp.length !== 6 || !newPassword || !confirmPassword) {
                        $('#fp-alert').text("Vui lòng điền đủ mã 6 số và mật khẩu mới.").show();
                        return;
                    }

                    if (newPassword !== confirmPassword) {
                        $('#fp-alert').text("Mật khẩu xác nhận không khớp.").show();
                        return;
                    }
                    
                    var btn = $(this);
                    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> <span>Đang xử lý...</span>');

                    $.ajax({
                        url: '@Url.Action("AjaxResetPassword", "Account")',
                        type: 'POST',
                        data: {
                            Email: email,
                            OTP: otp,
                            NewPassword: newPassword,
                            ConfirmNewPassword: confirmPassword,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (res) {
                            btn.prop('disabled', false).html('<i class="fas fa-check-double"></i> <span>Xác Nhận Đổi Mật Khẩu</span>');
                            if (res.success) {
                                alert(res.message);
                                window.location.href = '@Url.Action("Login", "Account")';
                            } else {
                                $('#fp-alert').text(res.message).show();
                            }
                        },
                        error: function () {
                            btn.prop('disabled', false).html('<i class="fas fa-check-double"></i> <span>Xác Nhận Đổi Mật Khẩu</span>');
                            $('#fp-alert').text("Có lỗi xảy ra trong quá trình đổi mật khẩu.").show();
                        }
                    });
                });
            });

        })();

        // Google OAuth Handlers
        function handleGoogleLogin(response) {
            document.getElementById('google-credential').value = response.credential;
            document.getElementById('google-login-form').submit();
        }

        function triggerGoogleLogin() {
            if (typeof google !== 'undefined' && google.accounts) {
                google.accounts.id.prompt(function (notification) {
                    if (notification.isNotDisplayed() || notification.isSkippedMoment()) {
                        var clientId = '875214279930-h0d47gbbmvodj3mejnkb3k89dj3esalo.apps.googleusercontent.com';
                        var redirectUri = encodeURIComponent(window.location.origin + '/Account/GoogleLogin');
                        window.location.href = 'https://accounts.google.com/o/oauth2/v2/auth' +
                            '?client_id=' + clientId +
                            '&redirect_uri=' + redirectUri +
                            '&response_type=token' +
                            '&scope=openid%20email%20profile';
                    }
                });
            }
        }
    </script>
</body>
</html>