@model DoAnNoSQL.Models.ResetPasswordViewModel

@{
    ViewBag.Title = "Khôi phục mật khẩu 3D";
    Layout = null;
    string tenCuaHang = DoAnNoSQL.Helpers.SettingsHelper.GetValue("TenCuaHang", "TECH SHOP");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - @tenCuaHang</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/Content/web-3d.css")">
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #020617;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
        }

        #bg-canvas-starlight {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }

        .ambient-glow {
            position: fixed;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            pointer-events: none;
            z-index: 1;
            filter: blur(50px);
        }

        .glow-teal {
            top: -10%;
            left: 20%;
            background: radial-gradient(circle, rgba(20, 184, 166, 0.25) 0%, transparent 70%);
        }

        .glow-indigo {
            bottom: -10%;
            right: 20%;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, transparent 70%);
        }

        .auth-card-3d {
            background: rgba(15, 23, 42, 0.82);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 28px;
            box-shadow: 
                0 30px 60px -15px rgba(0, 0, 0, 0.65),
                0 0 50px rgba(20, 184, 166, 0.18),
                inset 0 1px 1px rgba(255, 255, 255, 0.15);
            position: relative;
            transform-style: preserve-3d;
            perspective: 1000px;
            transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1);
            overflow: hidden;
            width: 100%;
            max-width: 460px;
            padding: 36px 32px;
            z-index: 10;
        }

        .glare-specular {
            position: absolute;
            inset: 0;
            pointer-events: none;
            border-radius: inherit;
            background: radial-gradient(circle 260px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.18) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.3s ease;
            mix-blend-mode: overlay;
            z-index: 20;
        }

        .auth-card-3d:hover .glare-specular { opacity: 1; }

        .input-group-3d {
            position: relative;
            margin-bottom: 20px;
        }

        .input-group-3d input {
            width: 100%;
            padding: 14px 16px 14px 44px;
            background: rgba(30, 41, 59, 0.7);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            font-size: 14px;
            color: #ffffff;
            outline: none;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .input-group-3d input:focus {
            background: rgba(15, 23, 42, 0.95);
            border-color: #2dd4bf;
            box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.2);
            transform: translateY(-1px);
        }

        .input-group-3d .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 14px;
            pointer-events: none;
        }

        .input-group-3d input:focus ~ .input-icon { color: #2dd4bf; }

        .input-group-3d label {
            position: absolute;
            left: 44px;
            top: 14px;
            color: #94a3b8;
            font-size: 13px;
            pointer-events: none;
            transition: all 0.25s;
        }

        .input-group-3d input:focus + label,
        .input-group-3d input:not(:placeholder-shown) + label {
            top: -10px;
            left: 14px;
            font-size: 11px;
            font-weight: 700;
            color: #2dd4bf;
            background: #0f172a;
            border-radius: 6px;
            padding: 1px 8px;
            border: 1px solid rgba(45, 212, 191, 0.3);
        }

        .btn-3d-action {
            width: 100%;
            padding: 14px 20px;
            background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
            color: #ffffff;
            border: none;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 5px 0 #0f766e, 0 10px 20px rgba(13, 148, 136, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-3d-action:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, #2dd4bf 0%, #0f766e 100%);
            box-shadow: 0 7px 0 #0f766e, 0 14px 25px rgba(20, 184, 166, 0.45);
        }

        .btn-3d-action:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 #0f766e, 0 4px 10px rgba(13, 148, 136, 0.25);
        }

        #shield-3d-canvas {
            width: 100px;
            height: 100px;
            margin: 0 auto;
            cursor: grab;
        }
    </style>
</head>
<body>
    <canvas id="bg-canvas-starlight"></canvas>
    <div class="ambient-glow glow-teal"></div>
    <div class="ambient-glow glow-indigo"></div>

    <a href="@Url.Action("Login", "Account")" class="fixed top-5 left-5 z-50 inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/10 hover:bg-teal-500/20 text-white hover:text-teal-300 backdrop-blur-xl border border-white/15 text-xs font-bold transition shadow-xl">
        <i class="fas fa-arrow-left"></i>
        <span>Quay lại Đăng nhập</span>
    </a>

    <div class="auth-card-3d border-beam-3d" id="fp-card">
        <div class="glare-specular"></div>

        <!-- 3D Security Shield Three.js Canvas -->
        <div id="shield-3d-canvas"></div>

        <div class="text-center mb-6">
            <h2 class="text-xl font-black text-white font-heading">Khôi Phục Mật Khẩu</h2>
            <p class="text-xs text-slate-400 mt-1">
                @(ViewBag.Step == 2 ? "Nhập mã OTP 6 số và mật khẩu mới" : "Nhập email đã đăng ký để nhận mã xác thực đa lớp")
            </p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="p-3 mb-4 rounded-xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-semibold flex items-center gap-2">
                <i class="fas fa-exclamation-circle text-rose-400"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        @Html.ValidationSummary(true, "", new { @class = "p-3 mb-4 rounded-xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-semibold" })

        <div class="bg-teal-500/10 border border-teal-500/25 rounded-2xl p-3.5 mb-5 text-xs text-slate-300 space-y-1">
            <div class="font-bold flex items-center gap-1.5 text-teal-300">
                <i class="fas fa-info-circle"></i>
                <span>Hướng dẫn bảo mật:</span>
            </div>
            <p class="text-slate-400">• Mã OTP 6 chữ số sẽ được gửi tự động qua email.</p>
            <p class="text-slate-400">• Vui lòng kiểm tra cả hòm thư Spam hoặc Thư rác.</p>
        </div>

        @if (ViewBag.Step == 2)
        {
            using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "forgot-password-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Email)

                <div class="input-group-3d">
                    <input type="text" name="OTP" id="OTP" placeholder=" " required class="font-mono text-center tracking-widest text-teal-300 font-bold" maxlength="6" />
                    <label for="OTP">Mã OTP (6 chữ số)</label>
                    <i class="fas fa-hashtag input-icon"></i>
                </div>
                
                <div class="input-group-3d">
                    <input type="password" name="NewPassword" id="NewPassword" placeholder=" " required />
                    <label for="NewPassword">Mật khẩu mới</label>
                    <i class="fas fa-lock input-icon"></i>
                </div>

                <div class="input-group-3d">
                    <input type="password" name="ConfirmNewPassword" id="ConfirmNewPassword" placeholder=" " required />
                    <label for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                    <i class="fas fa-shield-check input-icon"></i>
                </div>

                <button class="btn-3d-action" type="submit">
                    <i class="fas fa-shield-check"></i>
                    <span>Xác nhận đổi mật khẩu</span>
                </button>
            }
        }
        else
        {
            using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "forgot-password-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="input-group-3d">
                    <input type="email" name="Email" id="email" placeholder=" " required />
                    <label for="email">Địa chỉ Email đã đăng ký</label>
                    <i class="fas fa-envelope input-icon"></i>
                </div>

                <button class="btn-3d-action" type="submit">
                    <i class="fas fa-paper-plane"></i>
                    <span>Gửi mã xác nhận OTP</span>
                </button>
            }
        }

        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs">
            <a href="@Url.Action("Login", "Account")" class="text-teal-400 hover:text-teal-300 font-bold inline-flex items-center gap-1.5 transition">
                <i class="fas fa-arrow-left"></i>
                <span>Đăng nhập</span>
            </a>
            <a href="@Url.Action("Index", "Home")" class="text-slate-400 hover:text-white inline-flex items-center gap-1.5 transition">
                <i class="fas fa-home"></i>
                <span>Trang chủ</span>
            </a>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Starlight
        var bgCanvas = document.getElementById('bg-canvas-starlight');
        if (bgCanvas) {
            var ctx = bgCanvas.getContext('2d');
            var w = bgCanvas.width = window.innerWidth;
            var h = bgCanvas.height = window.innerHeight;
            var stars = [];
            for (var i = 0; i < 50; i++) {
                stars.push({ x: Math.random() * w, y: Math.random() * h, size: Math.random() * 1.5 + 0.5, speed: Math.random() * 0.3 + 0.1 });
            }
            function draw() {
                ctx.clearRect(0, 0, w, h);
                ctx.fillStyle = '#14b8a6';
                for (var i = 0; i < stars.length; i++) {
                    var s = stars[i];
                    s.y -= s.speed;
                    if (s.y < 0) s.y = h;
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        }

        // Card Tilt
        var card = document.getElementById('fp-card');
        if (card) {
            card.addEventListener('mousemove', function(e) {
                var b = card.getBoundingClientRect();
                var px = ((e.clientX - b.left) / b.width) * 100;
                var py = ((e.clientY - b.top) / b.height) * 100;
                var rx = ((e.clientY - b.top) / b.height - 0.5) * -12;
                var ry = ((e.clientX - b.left) / b.width - 0.5) * 12;
                card.style.transform = 'perspective(1000px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg)';
                card.style.setProperty('--mouse-x', px + '%');
                card.style.setProperty('--mouse-y', py + '%');
            });
            card.addEventListener('mouseleave', function() {
                card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
            });
        }

        // Mini 3D Shield in Three.js
        var sBox = document.getElementById('shield-3d-canvas');
        if (sBox && typeof THREE !== 'undefined') {
            var scene = new THREE.Scene();
            var camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
            camera.position.z = 4.2;
            var renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            renderer.setSize(100, 100);
            sBox.appendChild(renderer.domElement);

            var keyMat = new THREE.MeshPhysicalMaterial({ color: 0x2dd4bf, metalness: 0.9, roughness: 0.1, clearcoat: 1 });
            var keyGeom = new THREE.TorusGeometry(0.9, 0.08, 16, 48);
            var ring = new THREE.Mesh(keyGeom, keyMat);
            scene.add(ring);

            var icoGeom = new THREE.IcosahedronGeometry(0.5, 0);
            var icoMat = new THREE.MeshStandardMaterial({ color: 0x6366f1, wireframe: true });
            var ico = new THREE.Mesh(icoGeom, icoMat);
            scene.add(ico);

            var light = new THREE.DirectionalLight(0xffffff, 2);
            light.position.set(2, 2, 3);
            scene.add(light);
            scene.add(new THREE.AmbientLight(0xffffff, 0.8));

            function anim() {
                requestAnimationFrame(anim);
                ring.rotation.x += 0.02;
                ring.rotation.y += 0.02;
                ico.rotation.y -= 0.03;
                renderer.render(scene, camera);
            }
            anim();
        }
    </script>
</body>
</html>