@model DoAnNoSQL.tb_DonHang

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.MaDonHang;
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3 text-xs sm:text-sm">
        <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center font-medium text-slate-600 hover:text-teal-600 transition-colors">
                <i class="fas fa-home mr-1.5 text-teal-600"></i>
                Trang chủ
            </a>
        </li>
        <li>
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-slate-300 mx-1.5 text-[10px]"></i>
                <span class="font-semibold text-teal-700">Chi tiết đơn hàng</span>
            </div>
        </li>
    </ol>
</nav>

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 bg-white/80 backdrop-blur-md rounded-3xl p-6 border border-slate-200/80 shadow-sm" data-aos="fade-down">
    <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-teal-600 to-emerald-500 text-white flex items-center justify-center text-xl shadow-md shadow-teal-500/20">
            <i class="fas fa-file-invoice"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-black text-slate-900 font-heading">
                Đơn hàng #@Model.MaDonHang
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">Đặt lúc: @(Model.NgayTao?.ToString("HH:mm - dd/MM/yyyy") ?? "N/A")</p>
        </div>
    </div>
    
    @{
        string statusClass = "bg-amber-100 text-amber-800 border-amber-200";
        string statusText = "Chờ xác nhận";
        string statusIcon = "fa-clock";
        
        switch (Model.TrangThai)
        {
            case 1: statusClass = "bg-amber-100 text-amber-800 border-amber-200"; statusText = "Chờ xác nhận"; statusIcon = "fa-clock"; break;
            case 2: statusClass = "bg-blue-100 text-blue-800 border-blue-200"; statusText = "Đã xác nhận"; statusIcon = "fa-check"; break;
            case 3: statusClass = "bg-purple-100 text-purple-800 border-purple-200"; statusText = "Đang giao hàng"; statusIcon = "fa-shipping-fast"; break;
            case 4: statusClass = "bg-emerald-100 text-emerald-800 border-emerald-200"; statusText = "Đã giao hàng"; statusIcon = "fa-badge-check"; break;
            case 5: statusClass = "bg-rose-100 text-rose-800 border-rose-200"; statusText = "Đã hủy"; statusIcon = "fa-times-circle"; break;
        }
    }
    
    <div>
        <span class="@statusClass px-4 py-2 rounded-full text-xs font-bold border flex items-center gap-2 w-fit">
            <i class="fas @statusIcon"></i>
            @statusText
        </span>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Order Items -->
        <div class="bg-white rounded-3xl shadow-card border border-slate-200/80 p-6 sm:p-8" data-aos="fade-up">
            <h2 class="text-lg font-bold text-slate-900 mb-5 pb-4 border-b border-slate-100 flex items-center gap-3 font-heading">
                <i class="fas fa-shopping-bag text-teal-600"></i>
                Danh sách sản phẩm đã đặt
            </h2>

            <div class="space-y-4 divide-y divide-slate-100">
                @foreach (var item in Model.tb_ChiTietDonHang)
                {
                    var sanPham = item.tb_SanPham;
                    <div class="pt-4 first:pt-0 flex items-center gap-4">
                        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-slate-50 border border-slate-200 p-1 flex items-center justify-center flex-shrink-0">
                            @if (sanPham != null && !string.IsNullOrEmpty(sanPham.HinhAnh))
                            {
                                <img src="@Url.Content("~/Content/Images/" + sanPham.HinhAnh)" 
                                     alt="@sanPham.TenSanPham" 
                                     class="w-full h-full object-contain" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/Content/Images/no-image.png")" 
                                     alt="No Image" 
                                     class="w-full h-full object-contain" />
                            }
                        </div>

                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm sm:text-base truncate">
                                @(sanPham?.TenSanPham ?? "Sản phẩm")
                            </h3>
                            <div class="flex items-center justify-between mt-1 text-xs">
                                <span class="text-slate-500">
                                    Đơn giá: <strong class="text-slate-700">@String.Format("{0:0,0}", item.Gia) đ</strong> &times; @item.SoLuong
                                </span>
                                <span class="font-black text-rose-600 font-heading text-sm sm:text-base">
                                    @String.Format("{0:0,0}", item.Gia * item.SoLuong) đ
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Order Timeline -->
        <div class="bg-white rounded-3xl shadow-card border border-slate-200/80 p-6 sm:p-8" data-aos="fade-up">
            <h2 class="text-lg font-bold text-slate-900 mb-5 pb-4 border-b border-slate-100 flex items-center gap-3 font-heading">
                <i class="fas fa-history text-indigo-600"></i>
                Hành trình đơn hàng
            </h2>

            <div class="relative pl-6 space-y-6 before:absolute before:left-3 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200">
                <!-- Created -->
                <div class="relative flex items-start gap-4">
                    <div class="absolute -left-6 top-0 w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] ring-4 ring-white shadow">
                        <i class="fas fa-check"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-slate-900 text-sm">Đơn hàng đã được đặt thành công</h4>
                        <p class="text-xs text-slate-500 mt-0.5">@(Model.NgayTao?.ToString("HH:mm:ss - dd/MM/yyyy") ?? "N/A")</p>
                    </div>
                </div>

                <!-- Confirmed -->
                @if (Model.TrangThai >= 2)
                {
                    <div class="relative flex items-start gap-4">
                        <div class="absolute -left-6 top-0 w-6 h-6 rounded-full bg-blue-500 text-white flex items-center justify-center text-[10px] ring-4 ring-white shadow">
                            <i class="fas fa-check"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-900 text-sm">Đơn hàng đã được xác nhận</h4>
                            <p class="text-xs text-slate-500 mt-0.5">@(Model.NgayCapNhat?.ToString("HH:mm:ss - dd/MM/yyyy") ?? "Hệ thống tự động xác nhận")</p>
                        </div>
                    </div>
                }

                <!-- Shipping -->
                @if (Model.TrangThai >= 3)
                {
                    <div class="relative flex items-start gap-4">
                        <div class="absolute -left-6 top-0 w-6 h-6 rounded-full bg-purple-500 text-white flex items-center justify-center text-[10px] ring-4 ring-white shadow">
                            <i class="fas fa-truck"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-900 text-sm">Đang vận chuyển giao hàng</h4>
                            <p class="text-xs text-slate-500 mt-0.5">Shipper đang trên đường giao tận nơi</p>
                        </div>
                    </div>
                }

                <!-- Delivered -->
                @if (Model.TrangThai == 4)
                {
                    <div class="relative flex items-start gap-4">
                        <div class="absolute -left-6 top-0 w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[10px] ring-4 ring-white shadow">
                            <i class="fas fa-box-check"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-emerald-700 text-sm">Đã giao hàng thành công</h4>
                            <p class="text-xs text-slate-500 mt-0.5">Khách hàng đã nhận kiện hàng hoàn tất</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="space-y-6">
        <!-- Customer Information -->
        <div class="bg-white rounded-3xl shadow-card border border-slate-200/80 p-6" data-aos="fade-left">
            <h2 class="text-base font-bold text-slate-900 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2.5 font-heading">
                <i class="fas fa-user-circle text-teal-600"></i>
                Thông tin người nhận
            </h2>

            <div class="space-y-3 text-xs text-slate-600">
                <div class="flex items-start gap-3">
                    <i class="fas fa-user text-slate-400 mt-0.5 w-4 text-center"></i>
                    <div>
                        <span class="text-slate-400 block text-[11px]">Họ và tên:</span>
                        <strong class="text-slate-800 text-sm">@Model.TenKhachHang</strong>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <i class="fas fa-phone text-slate-400 mt-0.5 w-4 text-center"></i>
                    <div>
                        <span class="text-slate-400 block text-[11px]">Số điện thoại:</span>
                        <strong class="text-slate-800 font-mono text-sm">@Model.SoDienThoai</strong>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <i class="fas fa-envelope text-slate-400 mt-0.5 w-4 text-center"></i>
                    <div>
                        <span class="text-slate-400 block text-[11px]">Email:</span>
                        <span class="text-slate-700">@(string.IsNullOrEmpty(Model.Email) ? "Không có" : Model.Email)</span>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <i class="fas fa-map-marker-alt text-slate-400 mt-0.5 w-4 text-center"></i>
                    <div>
                        <span class="text-slate-400 block text-[11px]">Địa chỉ giao hàng:</span>
                        <span class="text-slate-800 font-medium leading-relaxed">@Model.DiaChi</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary & Payment -->
        <div class="bg-white rounded-3xl shadow-card border border-slate-200/80 p-6 space-y-4" data-aos="fade-left">
            <h2 class="text-base font-bold text-slate-900 pb-3 border-b border-slate-100 flex items-center gap-2.5 font-heading">
                <i class="fas fa-receipt text-teal-600"></i>
                Chi phí thanh toán
            </h2>

            <div class="space-y-2 text-xs">
                <div class="flex justify-between text-slate-600">
                    <span>Tạm tính tiền hàng:</span>
                    <span class="font-semibold text-slate-800">@String.Format("{0:0,0}", Model.TongTien) đ</span>
                </div>

                <div class="flex justify-between text-slate-600">
                    <span>Phí vận chuyển:</span>
                    <span class="font-bold text-emerald-600">Miễn phí</span>
                </div>

                <div class="pt-3 border-t border-slate-100 flex justify-between items-baseline">
                    <span class="text-sm font-bold text-slate-900">Tổng thanh toán:</span>
                    <span class="text-xl font-black text-rose-600 font-heading">
                        @String.Format("{0:0,0}", Model.TongTien) đ
                    </span>
                </div>
            </div>

            <div class="pt-3 border-t border-slate-100 text-xs">
                <span class="text-slate-400 block text-[11px] mb-1">Phương thức thanh toán:</span>
                @{
                    var paymentMethod = "Thanh toán khi nhận hàng (COD)";
                    switch(Model.LoaiThanhToan)
                    {
                        case "1": paymentMethod = "Thanh toán khi nhận hàng (COD)"; break;
                        case "2": paymentMethod = "Chuyển khoản ngân hàng (VietQR)"; break;
                        case "3": paymentMethod = "Ví điện tử MoMo"; break;
                        case "4": paymentMethod = "Ví điện tử ZaloPay"; break;
                        case "5": paymentMethod = "Thẻ tín dụng / Ghi nợ quốc tế"; break;
                    }
                }
                <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800 flex items-center gap-2">
                    <i class="fas fa-wallet text-teal-600"></i>
                    <span>@paymentMethod</span>
                </div>
            </div>

            @if (Model.TrangThai == 1)
            {
                <div class="pt-2">
                    <button type="button" onclick="cancelOrder('@Model.Id')" 
                            class="w-full py-3 px-4 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold rounded-2xl border border-rose-200 transition-all text-xs flex items-center justify-center gap-2 shadow-sm">
                        <i class="fas fa-times-circle"></i>
                        Hủy đơn hàng này
                    </button>
                </div>
            }

            <a href="@Url.Action("Index", "Home")" 
               class="w-full py-3 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-2xl transition-all text-xs flex items-center justify-center gap-2 block text-center">
                <i class="fas fa-arrow-left"></i> Quay lại trang chủ
            </a>
        </div>
    </div>
</div>

@section scripts {
<script>
    function cancelOrder(orderId) {
        Swal.fire({
            title: 'Hủy đơn hàng?',
            text: 'Bạn có chắc chắn muốn yêu cầu hủy đơn hàng này không?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            cancelButtonColor: '#94a3b8',
            confirmButtonText: 'Xác nhận hủy',
            cancelButtonText: 'Không',
            customClass: {
                popup: 'rounded-3xl p-6',
                confirmButton: 'rounded-xl font-bold px-4 py-2.5',
                cancelButton: 'rounded-xl font-semibold px-4 py-2.5'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    icon: 'info',
                    title: 'Đang xử lý',
                    text: 'Yêu cầu hủy đơn đã được ghi nhận. Nhân viên CSKH sẽ liên hệ với bạn sớm nhất!',
                    confirmButtonColor: '#0d9488',
                    customClass: {
                        popup: 'rounded-3xl p-6',
                        confirmButton: 'rounded-xl font-bold px-5 py-2.5'
                    }
                });
            }
        });
    }
</script>
}
