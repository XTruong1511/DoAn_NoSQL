@model DoAnNoSQL.Models.ShoppingCart

@{
    ViewBag.Title = "Giỏ hàng";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                <i class="fas fa-home mr-2"></i>
                Trang chủ
            </a>
        </li>
        <li aria-current="page">
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <span class="text-sm font-medium text-gray-500">Giỏ hàng</span>
            </div>
        </li>
    </ol>
</nav>

<!-- 3D Page Header -->
<div class="page-header-3d" data-aos="fade-down">
    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-teal-500/20 border border-teal-400/40 text-teal-300 flex items-center justify-center shadow-lg shadow-teal-500/20">
                <i class="fas fa-cart-shopping text-2xl"></i>
            </div>
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-teal-400/20 border border-teal-400/30 text-teal-200 text-[11px] font-bold tracking-wider uppercase mb-1">
                    <span>GIỎ HÀNG THÔNG MINH</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-black font-heading text-white">
                    Giỏ Hàng Của Bạn
                </h1>
            </div>
        </div>
        @if (Model != null && !Model.IsEmpty())
        {
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/15 px-4 py-2 rounded-xl text-teal-200 text-sm font-bold">
                <i class="fas fa-cubes"></i>
                <span>@Model.GetTotalQuantity() sản phẩm đã chọn</span>
            </div>
        }
    </div>
</div>

@if (Model != null && !Model.IsEmpty())
{
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Cart Items (Left - 2/3 width) -->
        <div class="lg:col-span-2 space-y-4">
            @foreach (var item in Model.Items)
            {
                <div class="cart-item card-glass-3d p-5 sm:p-6"
                     data-product-id="@item.ProductId"
                     data-color="@item.Color">
                    <div class="flex items-center space-x-6">
                        <!-- Product Image -->
                        <div class="flex-shrink-0">
                            <a href="@Url.Action("ChiTietSP", "SanPham", new { id = item.ProductId })">
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@Url.Content("~/Content/Images/" + item.ProductImage)"
                                         alt="@item.ProductName"
                                         class="w-24 h-24 object-contain rounded border border-gray-200" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/Content/Images/no-image.png")"
                                         alt="No Image"
                                         class="w-24 h-24 object-contain rounded border border-gray-200" />
                                }
                            </a>
                        </div>

                        <!-- Product Info -->
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-gray-900 mb-2">
                                <a href="@Url.Action("ChiTietSP", "SanPham", new { id = item.ProductId })"
                                   class="hover:text-blue-600">
                                    @item.ProductName
                                </a>
                            </h3>

                            @if (!string.IsNullOrEmpty(item.Color))
                            {
                                <p class="text-sm text-gray-600 mb-2">
                                    <span class="font-medium">Màu:</span> @item.Color
                                </p>
                            }

                            <div class="flex items-center space-x-4">
                                <!-- Price -->
                                <p class="text-lg font-bold text-blue-600">
                                    @String.Format("{0:0,0}", item.Price) đ
                                </p>

                                <!-- Quantity Selector -->
                                <div class="flex items-center border border-gray-300 rounded">
                                    <button type="button"
                                            class="btn-decrease px-3 py-1 hover:bg-gray-100 transition-colors border-r"
                                            onclick="changeCartQty(this, -1, @item.ProductId, '@item.Color')">
                                        <i class="fas fa-minus text-gray-600"></i>
                                    </button>
                                    <input type="number"
                                           class="quantity-input w-16 text-center border-none py-1 font-semibold text-gray-900 focus:outline-none"
                                           value="@item.Quantity"
                                           min="1"
                                           onchange="manualCartUpdate(this, @item.ProductId, '@item.Color')" />
                                    <button type="button"
                                            class="btn-increase px-3 py-1 hover:bg-gray-100 transition-colors border-l"
                                            onclick="changeCartQty(this, 1, @item.ProductId, '@item.Color')">
                                        <i class="fas fa-plus text-gray-600"></i>
                                    </button>
                                </div>

                                <!-- Item Total -->
                                <p class="item-total text-lg font-bold text-gray-900">
                                    @String.Format("{0:0,0}", item.TotalPrice) đ
                                </p>
                            </div>
                        </div>

                        <!-- Remove Button -->
                        <div class="flex-shrink-0">
                            <button type="button"
                                    class="btn-remove text-red-500 hover:text-red-700 hover:bg-red-50 p-2 rounded transition-colors"
                                    onclick="removeItem(@item.ProductId, '@item.Color')"
                                    title="Xóa sản phẩm">
                                <i class="fas fa-trash-alt text-xl"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Order Summary (Right - 1/3 width) -->
        <div class="lg:col-span-1">
            <div class="summary-sticky-3d border-beam-3d p-6 sm:p-7">
                <div class="flex items-center gap-2 mb-5 pb-3 border-b border-slate-200">
                    <span class="w-2.5 h-2.5 rounded-full bg-teal-500 animate-pulse"></span>
                    <h2 class="text-lg font-black text-slate-900 font-heading uppercase tracking-wide">
                        Thông tin đơn hàng
                    </h2>
                </div>

                <div class="space-y-4 mb-6">
                    <div class="flex justify-between text-slate-600 text-sm">
                        <span>Tạm tính:</span>
                        <span id="subtotal" class="font-bold text-slate-900">@String.Format("{0:0,0}", Model.GetTotal()) đ</span>
                    </div>

                    <div class="flex justify-between text-slate-600 text-sm">
                        <span>Phí vận chuyển:</span>
                        <span class="font-bold text-teal-600">Miễn phí toàn quốc</span>
                    </div>

                    <!-- Discount Section -->
                    <div id="discountSection" class="border-t border-slate-100 pt-3" style="display: @(Session["DiscountAmount"] != null ? "block" : "none")">
                        <div class="flex justify-between items-center text-teal-600 text-sm font-semibold">
                            <div class="flex items-center">
                                <i class="fas fa-tag mr-2"></i>
                                <span>Giảm giá (<span id="discountCodeDisplay">@Session["DiscountCode"]</span>):</span>
                            </div>
                            <div class="flex items-center space-x-2">
                                <span id="discountAmount" class="font-bold text-rose-600">
                                    @(Session["DiscountAmount"] != null ? String.Format("-{0:0,0} đ", Session["DiscountAmount"]) : "")
                                </span>
                                <button type="button" onclick="removeDiscount()" class="text-rose-500 hover:text-rose-700 p-1" title="Xóa mã giảm giá">
                                    <i class="fas fa-times-circle"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="border-t border-slate-200 pt-4">
                        <div class="flex justify-between items-baseline">
                            <span class="text-base font-extrabold text-slate-900 font-heading">Tổng cộng:</span>
                            <span id="total" class="text-2xl sm:text-3xl font-black text-rose-600 font-heading">
                                @{
                                    var discountAmount = Session["DiscountAmount"] != null ? Convert.ToDecimal(Session["DiscountAmount"]) : 0;
                                    var finalTotal = Model.GetTotal() - discountAmount;
                                }
                                @String.Format("{0:0,0}", finalTotal) đ
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Checkout Button -->
                <a href="@Url.Action("Index", "ThanhToan")"
                   class="btn-3d btn-3d-primary w-full py-4 px-6 rounded-xl transition-all duration-200 text-center flex items-center justify-center gap-2 cursor-pointer shadow-lg mb-3">
                    <i class="fas fa-credit-card text-base"></i>
                    <span class="font-extrabold uppercase tracking-wider text-sm sm:text-base">Tiến hành thanh toán</span>
                </a>

                <a href="@Url.Action("Index", "SanPham")"
                   class="w-full py-3 px-4 rounded-xl text-center block text-xs font-bold text-slate-500 hover:text-teal-600 transition-colors">
                    <i class="fas fa-arrow-left mr-1.5"></i> Tiếp tục mua sắm
                </a>

                <!-- Promo Code (3D Voucher Input) -->
                <div class="mt-6 pt-5 border-t border-slate-100">
                    <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider mb-2.5 flex items-center gap-1.5 font-heading">
                        <i class="fas fa-ticket-simple text-teal-600"></i>
                        <span>Mã giảm giá / Voucher</span>
                    </h3>
                    <div class="flex gap-2">
                        <input type="text"
                               id="discountCodeInput"
                               placeholder="Nhập mã ưu đãi (VD: GIAM10)"
                               class="input-3d flex-1 text-xs"
                               value="@Session["DiscountCode"]" />
                        <button type="button"
                                id="btnApplyDiscount"
                                onclick="applyDiscount()"
                                class="btn-tactile-3d bg-teal-600 hover:bg-teal-700 text-white text-xs px-4 py-2 rounded-xl flex items-center gap-1 whitespace-nowrap">
                            <i class="fas fa-check text-[11px]"></i>
                            <span>Áp dụng</span>
                        </button>
                    </div>
                    <div id="discountMessage" class="mt-2 text-sm"></div>

                    <!-- Discount Applied Display -->
                    <div id="discountApplied" style="display: @(Session["DiscountAmount"] != null ? "flex" : "none")" class="mt-4 p-3 bg-green-50 border border-green-200 rounded-lg items-center justify-between">
                        <div class="flex items-center text-green-700 text-sm">
                            <i class="fas fa-check-circle mr-2"></i>
                            <span class="font-medium">Mã <strong id="appliedCode">@Session["DiscountCode"]</strong> đã được áp dụng!</span>
                        </div>
                        <button type="button" onclick="removeDiscount()" class="text-red-500 hover:text-red-700 ml-2 p-1" title="Xóa mã">
                            <i class="fas fa-times-circle text-lg"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Empty Cart -->
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <div class="mb-6">
            <i class="fas fa-shopping-cart text-gray-300 text-8xl"></i>
        </div>
        <h2 class="text-2xl font-bold text-gray-700 mb-4">Giỏ hàng trống</h2>
        <p class="text-gray-500 mb-6">
            Bạn chưa có sản phẩm nào trong giỏ hàng
        </p>
        <a href="@Url.Action("Index", "Home")"
           class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors">
            <i class="fas fa-arrow-left mr-2"></i>
            Tiếp tục mua sắm
        </a>
    </div>
}

@section scripts {
<script>
// Handle +/- buttons
function changeCartQty(btn, delta, productId, color) {
    var $input = $(btn).siblings('input.quantity-input');
    var currentVal = parseInt($input.val()) || 1;
    var newVal = currentVal + delta;
        
    if (newVal < 1) {
        // Don't allow going below 1 via buttons - use trash icon to remove
        return;
    }
        
    $input.val(newVal); // Optimistic update
    updateQuantity(productId, newVal, color);
}

// Handle manual input
function manualCartUpdate(input, productId, color) {
    var val = parseInt($(input).val());
        
    if (isNaN(val) || val < 1) {
        $(input).val(1);
        val = 1;
    }
        
    updateQuantity(productId, val, color);
}

// Update quantity (AJAX call)
function updateQuantity(productId, quantity, color) {
    $.ajax({
        url: '@Url.Action("UpdateQuantity", "GioHang")',
        type: 'POST',
        data: {
            productId: productId,
            quantity: quantity,
            color: color
        },
        success: function (response) {
            if (response.success) {
                // Update quantity input (in case server changed it)
                var $item = $('[data-product-id="' + productId + '"][data-color="' + color + '"]');
                $item.find('.quantity-input').val(response.quantity || quantity);

                // Update item total
                $item.find('.item-total').text(formatCurrency(response.itemTotal));

                // Update cart totals
                updateCartTotals(response.cartTotal, response.cartCount);

                // Show notification
                showNotification(response.message, 'success');
            } else {
                // Revert on error
                location.reload();
                showNotification(response.message, 'error');
            }
        },
        error: function () {
            // Revert on error
            location.reload();
            showNotification('Có lỗi xảy ra, vui lòng thử lại', 'error');
        }
    });
}

    // Remove item
    function removeItem(productId, color) {
        Swal.fire({
            title: 'Xác nhận xóa',
            text: 'Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Remove", "GioHang")',
                    type: 'POST',
                    data: {
                        productId: productId,
                        color: color
                    },
                    success: function (response) {
                        if (response.success) {
                            // Remove item from DOM
                            $('[data-product-id="' + productId + '"][data-color="' + color + '"]').fadeOut(300, function() {
                                $(this).remove();
                                checkEmptyCart();
                            });

                            // Update cart totals
                            updateCartTotals(response.cartTotal, response.cartCount);

                            // Show notification
                            showNotification(response.message, 'success');
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function () {
                        showNotification('Có lỗi xảy ra, vui lòng thử lại', 'error');
                    }
                });
            }
        });
    }

    // Update cart totals
    function updateCartTotals(total, count) {
        $('#subtotal').text(formatCurrency(total));
        $('#total').text(formatCurrency(total));

        // Update header cart count (if exists)
        $('.cart-count').text(count);
    }

    // Format currency
    function formatCurrency(amount) {
        return new Intl.NumberFormat('vi-VN').format(amount) + ' đ';
    }

    // Check if cart is empty
    function checkEmptyCart() {
        if ($('.cart-item').length === 0) {
            location.reload();
        }
    }

    // Show notification
    function showNotification(message, type) {
        var bgColor = type === 'success' ? 'bg-green-500' : 'bg-red-500';
        var notification = $('<div class="fixed top-4 right-4 ' + bgColor + ' text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in">' +
            '<i class="fas fa-' + (type === 'success' ? 'check' : 'exclamation') + '-circle mr-2"></i>' +
            message +
            '</div>');

        $('body').append(notification);

        setTimeout(function() {
            notification.fadeOut(300, function() {
                $(this).remove();
            });
        }, 3000);
    }

    // Apply discount code
    function applyDiscount() {
        var discountCode = $('#discountCodeInput').val().trim();
        var messageDiv = $('#discountMessage');
        var btnApply = $('#btnApplyDiscount');

        if (!discountCode) {
            showDiscountMessage('Vui lòng nhập mã giảm giá', 'error');
            return;
        }

        // Disable button và hiển thị loading
        btnApply.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang xử lý...');

        $.ajax({
            url: '@Url.Action("ApplyDiscount", "GioHang")',
            type: 'POST',
            data: { discountCode: discountCode },
            success: function(response) {
                if (response.success) {
                    // Hiển thị section giảm giá
                    $('#discountSection').show();
                    $('#discountCodeDisplay').text(response.discountCode);
                    $('#discountAmount').text('-' + formatCurrency(response.discountAmount));

                    // Cập nhật tổng tiền
                    $('#total').text(formatCurrency(response.finalTotal));

                    // Hiển thị thông báo đã áp dụng
                    $('#discountApplied').show();
                    $('#appliedCode').text(response.discountCode);

                    // Hiển thị message thành công
                    showDiscountMessage(response.message, 'success');

                    // Disable input
                    $('#discountCodeInput').prop('readonly', true);
                } else {
                    showDiscountMessage(response.message, 'error');
                }
            },
            error: function() {
                showDiscountMessage('Có lỗi xảy ra, vui lòng thử lại', 'error');
            },
            complete: function() {
                // Enable button trở lại
                btnApply.prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Áp dụng');
            }
        });
    }

    // Remove discount code
    function removeDiscount() {
        Swal.fire({
            title: 'Xác nhận xóa',
            text: 'Bạn có chắc muốn xóa mã giảm giá?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("RemoveDiscount", "GioHang")',
                    type: 'POST',
                    success: function(response) {
                        if (response.success) {
                            // Ẩn section giảm giá
                            $('#discountSection').hide();
                            $('#discountApplied').hide();

                            // Clear input
                            $('#discountCodeInput').val('').prop('readonly', false);

                            // Cập nhật tổng tiền
                            $('#total').text(formatCurrency(response.finalTotal));

                            // Hiển thị thông báo
                            showDiscountMessage(response.message, 'success');
                        } else {
                            showDiscountMessage(response.message, 'error');
                        }
                    },
                    error: function() {
                        showDiscountMessage('Có lỗi xảy ra, vui lòng thử lại', 'error');
                    }
                });
            }
        });
    }

    // Show discount message
    function showDiscountMessage(message, type) {
        var messageDiv = $('#discountMessage');
        var colorClass = type === 'success' ? 'text-green-600' : 'text-red-600';
        var icon = type === 'success' ? 'check-circle' : 'exclamation-circle';

        messageDiv.html('<i class="fas fa-' + icon + ' mr-1"></i>' + message)
                  .removeClass('text-green-600 text-red-600')
                  .addClass(colorClass);

        // Auto hide sau 5 giây
        setTimeout(function() {
            messageDiv.fadeOut(function() {
                $(this).html('').show();
            });
        }, 5000);
    }

    // Allow enter key to apply discount
    $('#discountCodeInput').on('keypress', function(e) {
        if (e.which === 13) { // Enter key
            e.preventDefault();
            applyDiscount();
        }
    });
    </script>

    <style>
        /* Hide browser spinner arrows for quantity input */
        input[type=number].quantity-input::-webkit-inner-spin-button,
        input[type=number].quantity-input::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type=number].quantity-input {
            -moz-appearance: textfield; /* Firefox */
            appearance: textfield;
        }
    </style>
}