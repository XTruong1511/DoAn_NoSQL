@model DoAnNoSQL.tb_TinTuc
@{
    ViewBag.Title = "Thêm Tin Tức Mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .form-section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .sticky-actions {
        padding: 1rem 0;
        margin-top: 1rem;
    }
    .file-upload-wrapper {
        border: 2px dashed #cbd5e1;
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        background: #f8fafc;
        transition: all 0.25s ease;
        cursor: pointer;
    }
    .file-upload-wrapper:hover {
        border-color: #3b82f6;
        background: #eff6ff;
    }
</style>

@using (Html.BeginForm("ThemTinTuc", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", id = "formAddTinTuc" }))
{
    @Html.AntiForgeryToken()
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0 text-gray-800 fw-bold"><i class="fas fa-newspaper text-primary me-2"></i>Thêm Bài Viết Mới</h2>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("TinTuc", "Admin")" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center shadow-sm">
                <i class="fas fa-arrow-left me-2"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 d-inline-flex align-items-center shadow-sm fw-bold">
                <i class="fas fa-save me-2"></i> Lưu bài viết
            </button>
        </div>
    </div>

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 shadow-sm" })

    <div class="row g-4">
        <!-- Cột trái: Nội dung chính -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-pen-nib text-primary me-2"></i>Nội dung bài viết</h5>
                    
                    <div class="form-floating mb-3">
                        @Html.EditorFor(model => model.TieuDe, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "Tiêu đề bài viết...", id = "TieuDe", required = "required" } })
                        @Html.Label("TieuDe", "Tiêu đề bài viết *")
                        @Html.ValidationMessageFor(model => model.TieuDe, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-floating mb-3">
                        @Html.EditorFor(model => model.BiDanh, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "vd: cong-nghe-moi-2026", id = "BiDanh" } })
                        @Html.Label("BiDanh", "Bí danh URL (Slug)")
                        @Html.ValidationMessageFor(model => model.BiDanh, "", new { @class = "text-danger small" })
                        <div class="form-text small text-muted"><i class="fas fa-magic me-1 text-primary"></i>Tự động sinh từ tiêu đề nếu để trống.</div>
                    </div>

                    <div class="form-floating mb-4">
                        @Html.TextAreaFor(model => model.MoTa, new { @class = "form-control rounded-3", style = "height: 100px", placeholder = "Tóm tắt bài viết..." })
                        @Html.Label("MoTa", "Tóm tắt ngắn (Hiển thị ở trang danh sách bài viết)")
                        @Html.ValidationMessageFor(model => model.MoTa, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold text-dark mb-2"><i class="fas fa-align-left text-primary me-2"></i>Nội dung chi tiết *</label>
                        @Html.TextAreaFor(model => model.ChiTiet, new { @class = "form-control rounded-3", rows = 12, id = "editor" })
                        @Html.ValidationMessageFor(model => model.ChiTiet, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Phân loại, Ảnh bìa & Trạng thái -->
        <div class="col-lg-4">
            <!-- Danh mục bài viết -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-folder text-primary me-2"></i>Chuyên mục & Tác giả</h5>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark mb-1">Chuyên mục tin *</label>
                        @Html.DropDownList("DanhMucTinId", (SelectList)ViewBag.DanhMucTinList, "-- Chọn chuyên mục --", new { @class = "form-select form-select-lg rounded-3 fs-6", required = "required" })
                        @Html.ValidationMessageFor(model => model.DanhMucTinId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-floating">
                        @Html.EditorFor(model => model.NguoiTao, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "Tác giả..." } })
                        @Html.Label("NguoiTao", "Tên tác giả bài viết")
                    </div>
                </div>
            </div>

            <!-- Ảnh đại diện -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-image text-primary me-2"></i>Ảnh bìa bài viết</h5>
                    
                    <div class="file-upload-wrapper mb-3" onclick="document.getElementById('hinhAnhFile').click();">
                        <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">Tải ảnh bìa bài viết</h6>
                        <span class="text-muted small">PNG, JPG, WEBP (Khuyến nghị 800x450px)</span>
                        <input type="file" name="hinhAnhFile" id="hinhAnhFile" class="d-none" accept="image/*">
                    </div>

                    <div id="imagePreview" class="text-center p-3 rounded-4 bg-light border" style="display: none;">
                        <span class="badge bg-success-subtle text-success border border-success-subtle mb-2">Ảnh bìa đã chọn</span>
                        <div class="rounded-3 overflow-hidden border shadow-sm">
                            <img id="previewImg" src="" alt="Preview" class="img-fluid w-100" style="max-height: 180px; object-fit: cover;">
                        </div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" id="clearImage">
                                <i class="fas fa-times me-1"></i> Bỏ chọn ảnh
                            </button>
                        </div>
                    </div>

                    @Html.ValidationMessageFor(model => model.HinhAnh, "", new { @class = "text-danger small" })
                </div>
            </div>

            <!-- Trạng thái -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-toggle-on text-primary me-2"></i>Xuất bản bài viết</h5>
                    
                    <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-check-label fw-bold text-dark d-block mb-1" for="HienThiSwitch">Hiển thị công khai</label>
                            <small class="text-muted">Đăng bài viết lên trang tin tức website</small>
                        </div>
                        @Html.CheckBox("HienThi", Model?.HienThi ?? true, new { @class = "form-check-input ms-0 fs-4", id = "HienThiSwitch", role = "switch" })
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
<script src="https://cdn.ckeditor.com/4.25.1/standard/ckeditor.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof CKEDITOR !== 'undefined') {
            CKEDITOR.replace('editor', {
                height: 380,
                removeButtons: 'About',
                toolbarGroups: [
                    { name: 'document', groups: [ 'mode', 'document', 'doctools' ] },
                    { name: 'clipboard', groups: [ 'clipboard', 'undo' ] },
                    { name: 'editing', groups: [ 'find', 'selection', 'spellchecker' ] },
                    { name: 'basicstyles', groups: [ 'basicstyles', 'cleanup' ] },
                    { name: 'paragraph', groups: [ 'list', 'indent', 'blocks', 'align' ] },
                    { name: 'links' },
                    { name: 'insert' },
                    { name: 'styles' },
                    { name: 'colors' }
                ]
            });
        }

        const tieuDeInput = document.getElementById('TieuDe');
        const biDanhInput = document.getElementById('BiDanh');

        if (tieuDeInput && biDanhInput) {
            tieuDeInput.addEventListener('input', function() {
                if (!biDanhInput.dataset.manual) {
                    biDanhInput.value = generateSlug(this.value);
                }
            });
            biDanhInput.addEventListener('input', function() {
                this.dataset.manual = "true";
            });
        }

        function generateSlug(str) {
            return str.toLowerCase()
                .replace(/á|à|ả|ã|ạ|ă|ắ|ằ|ẳ|ẵ|ặ|â|ấ|ầ|ẩ|ẫ|ậ/gi, 'a')
                .replace(/é|è|ẻ|ẽ|ẹ|ê|ế|ề|ể|ễ|ệ/gi, 'e')
                .replace(/i|í|ì|ỉ|ĩ|ị/gi, 'i')
                .replace(/ó|ò|ỏ|õ|ọ|ô|ố|ồ|ổ|ỗ|ộ|ơ|ớ|ờ|ở|ỡ|ợ/gi, 'o')
                .replace(/ú|ù|ủ|ũ|ụ|ư|ứ|ừ|ử|ữ|ự/gi, 'u')
                .replace(/ý|ỳ|ỷ|ỹ|ỵ/gi, 'y')
                .replace(/đ/gi, 'd')
                .replace(/\s+/g, '-')
                .replace(/[^\w\-]+/g, '')
                .replace(/\-\-+/g, '-')
                .replace(/^-+/, '')
                .replace(/-+$/, '');
        }

        const fileInput = document.getElementById('hinhAnhFile');
        const previewContainer = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');
        const clearBtn = document.getElementById('clearImage');

        if (fileInput) {
            fileInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Định dạng không hợp lệ',
                            text: 'Vui lòng chọn file ảnh (JPG, PNG, GIF, WEBP)',
                            confirmButtonColor: '#3b82f6'
                        });
                        this.value = '';
                        previewContainer.style.display = 'none';
                        return;
                    }
                    
                    if (file.size > 5 * 1024 * 1024) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Dung lượng quá lớn',
                            text: 'Kích thước file không được vượt quá 5MB',
                            confirmButtonColor: '#3b82f6'
                        });
                        this.value = '';
                        previewContainer.style.display = 'none';
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        previewImg.src = e.target.result;
                        previewContainer.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                } else {
                    previewContainer.style.display = 'none';
                }
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                fileInput.value = '';
                previewContainer.style.display = 'none';
                previewImg.src = '';
            });
        }
    });
</script>
}

