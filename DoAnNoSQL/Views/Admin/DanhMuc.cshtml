@model List<tb_DanhMuc>

@{
    ViewBag.Title = "DanhMuc";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string TuKhoa = ViewBag.TuKhoa;
}

<div id="categories" class="tab-content active">
    <h1 class="mb-4"><i class="fas fa-folder text-primary me-2"></i>Quản lý danh mục</h1>
    <div class="table-container">
        <div class="d-flex justify-content-between mb-3">
            <form action="TimDanhMuc" method="get" class="input-group w-50">
                <input type="text" class="form-control" id="timdm" name="timdm" placeholder="Tìm kiếm danh mục...">
                <button class="btn btn-outline-secondary btn-icon" type="submit" title="Tìm kiếm"><i class="fas fa-search"></i></button>
            </form>
            <div class="d-flex gap-2">
                <button class="btn btn-success btn-icon" onclick="exportTableToExcel('categoryTable', 'DanhSachDanhMuc_' + new Date().toISOString().slice(0,10) + '.xlsx')" title="Xuất Excel">
                    <i class="fas fa-file-excel"></i>
                </button>
                <a href="@Url.Action("formThemDM", "Admin")" class="btn btn-primary btn-icon" title="Thêm danh mục">
                    <i class="fas fa-plus"></i>
                </a>
            </div>
        </div>
        <table class="table table-bordered table-hover" id="categoryTable">
            <thead>
                <tr>
                    <th class="text-center">ID</th>
                    <th>Tên danh mục</th>
                    <th>Bí danh</th>
                    <th>Icon</th>
                    <th>Thứ tự</th>
                    <th>Ngày tạo</th>
                    <th>Ngày cập nhật</th>
                    <th>Hiển thị</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody id="categoryTableBody">
                @foreach (var item in Model)
                {
                    <tr id="category-1">
                        <td class="text-center align-middle">@item.Id</td>
                        <td class="align-middle">@item.TenDanhMuc</td>
                        <td>@item.BiDanh</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <img src="~/Content/Images/@item.Icon" alt="@item.TenDanhMuc" style="width: 50px; height: 50px; object-fit: contain;" class="img-thumbnail">
                            }
                            else
                            {
                                <span class="text-muted"><i class="fas fa-image fa-2x"></i></span>
                            }
                        </td>
                        <td>@item.ThuTu</td>
                        <td>@item.NgayTao</td>
                        <td>@item.NgayCapNhat</td>
                        <td>
                            <div class="form-check form-switch d-flex justify-content-center">
                                <input class="form-check-input" type="checkbox" @(item.HienThi == true ? "checked" : "") disabled>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="btn-group justify-content-center" role="group">
                                <a href="@Url.Action("formSuaDM", "Admin", new { id = item.Id })" class="btn btn-sm btn-warning" title="Sửa danh mục">
                                    <i class="fas fa-pen-to-square"></i>
                                </a>
                                <a href="javascript:void(0);" class="btn btn-sm btn-danger" onclick="confirmDeleteCategory(@item.Id, '@item.TenDanhMuc')" title="Xóa danh mục">
                                    <i class="fas fa-trash-can"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
        
        <script>
        function confirmDeleteCategory(id, categoryName) {
            Swal.fire({
                title: 'Xác nhận xóa',
                html: `Bạn có chắc chắn muốn xóa danh mục <strong>"${categoryName}"</strong>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash-can"></i> Xóa',
                cancelButtonText: '<i class="fas fa-times"></i> Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("XoaDM", "Admin")' + '?id=' + id;
                }
            });
        }
        </script>
        
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DanhMuc" : "TimDanhMuc",
                    new { timdm = ViewBag.TuKhoa, page = currentPage - 1 })">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action(
                        String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DanhMuc" : "TimDanhMuc",
                        new { timdm = ViewBag.TuKhoa, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DanhMuc" : "TimDanhMuc",
                    new { timdm = ViewBag.TuKhoa, page = currentPage + 1 })">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>