@model DoAnNoSQL.tb_QuangCao
@{
    ViewBag.Title = "Thêm Banner Mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .form-section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .sticky-actions {
        padding: 1rem 0;
        margin-top: 1rem;
    }
    .file-upload-wrapper {
        border: 2px dashed #cbd5e1;
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        background: #f8fafc;
        transition: all 0.25s ease;
        cursor: pointer;
    }
    .file-upload-wrapper:hover {
        border-color: #3b82f6;
        background: #eff6ff;
    }
</style>

@using (Html.BeginForm("ThemBanner", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", id = "formAddBanner" }))
{
    @Html.AntiForgeryToken()
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0 text-gray-800 fw-bold"><i class="fas fa-images text-primary me-2"></i>Thêm Banner Quảng Cáo</h2>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Banner", "Admin")" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center shadow-sm">
                <i class="fas fa-arrow-left me-2"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 d-inline-flex align-items-center shadow-sm fw-bold">
                <i class="fas fa-save me-2"></i> Lưu banner
            </button>
        </div>
    </div>

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 shadow-sm" })

    <div class="row g-4">
        <!-- Cột trái: Thông tin banner -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-info-circle text-primary me-2"></i>Thông tin quảng cáo</h5>
                    
                    <div class="form-floating mb-3">
                        @Html.EditorFor(model => model.TieuDe, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "Tiêu đề banner...", id = "TieuDe", required = "required" } })
                        @Html.Label("TieuDe", "Tiêu đề Banner *")
                        @Html.ValidationMessageFor(model => model.TieuDe, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-floating mb-3">
                        @Html.TextAreaFor(model => model.MoTa, new { @class = "form-control rounded-3", style = "height: 100px", placeholder = "Mô tả ngắn..." })
                        @Html.Label("MoTa", "Mô tả ngắn hoặc thông điệp")
                        @Html.ValidationMessageFor(model => model.MoTa, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-floating mb-3">
                        @Html.EditorFor(model => model.LienKet, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "https://...", type = "url" } })
                        @Html.Label("LienKet", "Đường dẫn liên kết khi nhấp (URL)")
                        @Html.ValidationMessageFor(model => model.LienKet, "", new { @class = "text-danger small" })
                        <div class="form-text small text-muted">Ví dụ: /SanPhams/ChiTiet/... hoặc link chương trình khuyến mãi</div>
                    </div>

                    <div class="form-floating mb-2">
                        @Html.EditorFor(model => model.ThuTu, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "Thứ tự...", type = "number", min = "0" } })
                        @Html.Label("ThuTu", "Thứ tự ưu tiên hiển thị (Số nhỏ xếp trước)")
                        @Html.ValidationMessageFor(model => model.ThuTu, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Hình ảnh & Trạng thái -->
        <div class="col-lg-5">
            <!-- Upload Banner -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-image text-primary me-2"></i>Hình ảnh Banner *</h5>
                    
                    <div class="file-upload-wrapper mb-3" onclick="document.getElementById('hinhAnhFile').click();">
                        <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">Chọn ảnh Banner</h6>
                        <span class="text-muted small">JPG, PNG, GIF, WEBP (Khuyến nghị 1920x600px - Tỷ lệ 16:5)</span>
                        <input type="file" name="hinhAnhFile" id="hinhAnhFile" class="d-none" accept="image/*" required>
                    </div>

                    <div id="imagePreview" class="text-center p-3 rounded-4 bg-light border" style="display: none;">
                        <span class="badge bg-success-subtle text-success border border-success-subtle mb-2">Xem trước Banner</span>
                        <div class="rounded-3 overflow-hidden border shadow-sm">
                            <img id="previewImg" src="" alt="Preview" class="img-fluid w-100" style="max-height: 180px; object-fit: cover;">
                        </div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" id="clearImage">
                                <i class="fas fa-times me-1"></i> Bỏ chọn ảnh
                            </button>
                        </div>
                    </div>

                    @Html.ValidationMessageFor(model => model.HinhAnh, "", new { @class = "text-danger small" })
                </div>
            </div>

            <!-- Trạng thái -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-toggle-on text-primary me-2"></i>Trạng thái hiển thị</h5>
                    
                    <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-check-label fw-bold text-dark d-block mb-1" for="HienThiSwitch">Hiển thị trên Slider</label>
                            <small class="text-muted">Kích hoạt banner xuất hiện trên slider trang chủ</small>
                        </div>
                        @Html.CheckBox("HienThi", Model?.HienThi ?? true, new { @class = "form-check-input ms-0 fs-4", id = "HienThiSwitch", role = "switch" })
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const fileInput = document.getElementById('hinhAnhFile');
        const previewContainer = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');
        const clearBtn = document.getElementById('clearImage');

        if (fileInput) {
            fileInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Định dạng không hợp lệ',
                            text: 'Vui lòng chọn file ảnh (JPG, PNG, GIF, WEBP)',
                            confirmButtonColor: '#3b82f6'
                        });
                        this.value = '';
                        previewContainer.style.display = 'none';
                        return;
                    }
                    
                    if (file.size > 5 * 1024 * 1024) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Dung lượng quá lớn',
                            text: 'Kích thước file không được vượt quá 5MB',
                            confirmButtonColor: '#3b82f6'
                        });
                        this.value = '';
                        previewContainer.style.display = 'none';
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        previewImg.src = e.target.result;
                        previewContainer.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                } else {
                    previewContainer.style.display = 'none';
                }
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                fileInput.value = '';
                previewContainer.style.display = 'none';
                previewImg.src = '';
            });
        }
    });
</script>
}

