@model List<tb_TinTuc>
@{
    ViewBag.Title = "Quản lý Tin tức";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string TuKhoa = ViewBag.TuKhoa;
}

<div id="news" class="tab-content active" >
    <h1 class="mb-4"><i class="fas fa-newspaper text-primary me-2"></i>Quản lý Tin tức</h1>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <div class="table-container">
        <div class="d-flex justify-content-between mb-3">
            <form action="TimTinTuc" method="get" class="input-group w-50">
                <input type="text" class="form-control" id="timtt" name="timtt" value="@TuKhoa" placeholder="Tìm kiếm tin tức...">
                <button class="btn btn-outline-secondary btn-icon" type="submit" title="Tìm kiếm"><i class="fas fa-search"></i></button>
            </form>
            <div class="d-flex gap-2">
                <button class="btn btn-success btn-icon" onclick="exportTableToExcel('newsTable', 'DanhSachTinTuc_' + new Date().toISOString().slice(0,10) + '.xlsx')" title="Xuất Excel">
                    <i class="fas fa-file-excel"></i>
                </button>
                <a href="@Url.Action("formThemTinTuc", "Admin")" class="btn btn-primary btn-icon" title="Thêm tin tức">
                    <i class="fas fa-plus"></i>
                </a>
            </div>
        </div>
        
        <table class="table table-bordered table-hover" id="newsTable">
            <thead>
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th style="width: 120px;">Hình ảnh</th>
                    <th>Tiêu đề</th>
                    <th style="width: 150px;">Danh mục</th>
                    <th style="width: 120px;">Ngày tạo</th>
                    <th style="width: 100px;">Hiển thị</th>
                    <th style="width: 150px;" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr id="news-@item.Id">
                            <td class="text-center">@item.Id</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <img src="@Url.Content("~/Content/Images/" + item.HinhAnh)" 
                                         alt="@item.TieuDe" 
                                         class="img-thumbnail"
                                         style="max-width: 100px; max-height: 60px; object-fit: cover;"
                                         onerror="this.src='@Url.Content("~/Content/Images/no-image.png")'; this.onerror=null;">
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-image"></i> Chưa có ảnh
                                    </span>
                                }
                            </td>
                            <td>
                                <strong>@item.TieuDe</strong>
                                @if (!string.IsNullOrEmpty(item.MoTa))
                                {
                                    <br>
                                    <small class="text-muted">@(item.MoTa.Length > 100 ? item.MoTa.Substring(0, 100) + "..." : item.MoTa)</small>
                                }
                            </td>
                            <td>
                                @if (item.tb_DanhMucTin != null)
                                {
                                    <span class="badge bg-info">@item.tb_DanhMucTin.TenDanhMuc</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa phân loại</span>
                                }
                            </td>
                            <td>@(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" @(item.HienThi == true ? "checked" : "") disabled>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group justify-content-center" role="group">
                                    <a href="@Url.Action("formSuaTinTuc", "Admin", new { id = item.Id })" class="btn btn-sm btn-warning" title="Sửa tin tức">
                                        <i class="fas fa-pen-to-square"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="btn btn-sm btn-danger" onclick="confirmDeleteNews('@item.Id', '@Html.Raw(item.TieuDe.Replace("'", "\\'"))')" title="Xóa tin tức">
                                        <i class="fas fa-trash-can"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            <i class="fas fa-inbox text-muted" style="font-size: 48px;"></i>
                            <p class="mt-3 text-muted">Chưa có tin tức nào</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <script>
        function confirmDeleteNews(id, newsTitle) {
            Swal.fire({
                title: 'Xác nhận xóa',
                html: `Bạn có chắc chắn muốn xóa tin tức <strong>"${newsTitle}"</strong>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash-can"></i> Xóa',
                cancelButtonText: '<i class="fas fa-times"></i> Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("XoaTinTuc", "Admin")' + '?id=' + id;
                }
            });
        }
        </script>
        
        @if (totalPages > 1)
        {
            <nav aria-label="Pagination">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action(
                            String.IsNullOrEmpty(TuKhoa) ? "TinTuc" : "TimTinTuc",
                            new { timtt = TuKhoa, page = currentPage - 1 })">Trước</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action(
                                String.IsNullOrEmpty(TuKhoa) ? "TinTuc" : "TimTinTuc",
                                new { timtt = TuKhoa, page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action(
                            String.IsNullOrEmpty(TuKhoa) ? "TinTuc" : "TimTinTuc",
                            new { timtt = TuKhoa, page = currentPage + 1 })">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>



