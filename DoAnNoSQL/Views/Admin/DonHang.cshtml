            showCancelButton: true,
            confirmButtonColor: '#10b981',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Xác nhận hoàn thành',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("HoanThanhDonHang", "Admin")',
                    type: 'POST',
                    data: { id: orderId },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Thành công!', response.message, 'success')
                                .then(() => {
                                    window.location.reload();
                                });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi cập nhật trạng thái', 'error');
                    }
                });
            }
        });
    }

    function capNhatTrangThai(orderId, currentStatus) {
        var userRole = @(Session["Role"] ?? 0);
        
        const statusOptions = {
            1: { next: 2, text: 'Xác nhận đơn hàng' },
            2: { next: 3, text: 'Chuyển sang đang giao' },
            3: { next: 4, text: 'Xác nhận đã giao' }
        };

        const option = statusOptions[currentStatus];
        if (!option) {
            Swal.fire('Thông báo', 'Không thể cập nhật trạng thái này', 'info');
            return;
        }
        
        // Nhân viên kho (Role 4) không được xác nhận đơn (trạng thái 1->2)
        if (userRole === 4 && currentStatus === 1) {
            Swal.fire('Truy cập bị từ chối', 'Nhân viên kho không có quyền xác nhận đơn hàng mới. Vui lòng đợi Sales xác nhận.', 'error');
            return;
        }

        Swal.fire({
            title: 'Cập nhật trạng thái?',
            text: option.text + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3b82f6',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Xác nhận',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CapNhatTrangThaiDonHang", "Admin")',
                    type: 'POST',
                    data: {
                        id: orderId,
                        trangThaiMoi: option.next
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Thành công!', response.message, 'success')
                                .then(() => {
                                    window.location.reload();
                                });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi cập nhật trạng thái', 'error');
                    }
                });
            }
        });
    }

