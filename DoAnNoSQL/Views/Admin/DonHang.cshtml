@model List<DoAnNoSQL.Models.QLDonHangViewModel>

@{
    ViewBag.Title = "DonHang";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string TuKhoa = ViewBag.TuKhoa;
}

<div id="orders" class="tab-content active">
    <h1 class="mb-4"> <i class="fas fa-shopping-cart text-primary me-2"></i>Quản lý đơn hàng</h1>
    <div class="table-container">
        <div class="d-flex justify-content-between mb-3">
            <form action="TimDonHang" method="get" class="input-group w-50">
                <input type="text" class="form-control" id="timdh" name="timdh" placeholder="Tìm kiếm đơn hàng...">
                <button class="btn btn-outline-secondary btn-icon" type="submit" title="Tìm kiếm"><i class="fas fa-search"></i></button>
            </form>
            <div class="d-flex gap-2">
                <select class="form-select" style="width: auto;" id="filterOrder" onchange="location = this.value;">
                    <option value="@Url.Action("DonHang", "Admin")" @(string.IsNullOrEmpty(ViewBag.TuKhoa) ? "selected" : "")>Tất cả</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = 1 })" @(ViewBag.TuKhoa == "1" ? "selected" : "")>Chờ xác nhận</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = 2 })" @(ViewBag.TuKhoa == "2" ? "selected" : "")>Đã xác nhận</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = 3 })" @(ViewBag.TuKhoa == "3" ? "selected" : "")>Đang giao</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = 4 })" @(ViewBag.TuKhoa == "4" ? "selected" : "")>Đã giao</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = 5 })" @(ViewBag.TuKhoa == "5" ? "selected" : "")>Hoàn thành</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = -1 })" @(ViewBag.TuKhoa == "-1" ? "selected" : "")>Đã hủy</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = 6 })" @(ViewBag.TuKhoa == "6" ? "selected" : "")>Yêu cầu trả hàng</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = 7 })" @(ViewBag.TuKhoa == "7" ? "selected" : "")>Đã trả hàng</option>
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = "store" })" @(ViewBag.TuKhoa == "store" ? "selected" : "")>Mua tại cửa hàng</option>
                </select>
                <button class="btn btn-success btn-icon" onclick="exportAllOrders()" title="Xuất Excel">
                    <i class="fas fa-file-excel"></i>
                </button>
                <button class="btn btn-secondary btn-icon" onclick="printPage()" title="In danh sách">
                    <i class="fas fa-print"></i>
                </button>
            </div>
        </div>
        <table class="table table-bordered table-hover" id="orderTable">
            <thead>
                <tr>
                    <th class="text-center">ID</th>
                    <th>Mã đơn hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody id="orderTableBody">
                @foreach (var item in Model)
                {
                    <tr id="order-@item.Id" onclick="toggleOrderRow(@item.Id)" style="cursor: pointer;" title="Nhấn để xem chi tiết">
                        <td class="text-center align-middle">@item.Id</td>
                        <td>@item.MaDonHang</td>
                        <td>@item.TenKhachHang</td>
                        <td>@item.TongTien</td>
                        <td>
                            @{
                                string statusBadge = "";
                                string statusText = "";
                                switch (item.TrangThai)
                                {
                                    case 1:
                                        statusBadge = "bg-warning";
                                        statusText = "Chờ xác nhận";
                                        break;
                                    case 2:
                                        statusBadge = "bg-info";
                                        statusText = "Đã xác nhận";
                                        break;
                                    case 3:
                                        statusBadge = "bg-primary";
                                        statusText = "Đang giao";
                                        break;
                                    case 4:
                                        statusBadge = "bg-success";
                                        statusText = "Đã giao";
                                        break;
                                    case 5:
                                        statusBadge = "bg-dark";
                                        statusText = "Hoàn thành";
                                        break;
                                    case 6:
                                        statusBadge = "bg-warning text-dark";
                                        statusText = "Yêu cầu trả hàng";
                                        break;
                                    case 7:
                                        statusBadge = "bg-secondary";
                                        statusText = "Đã trả hàng";
                                        break;
                                    case -1:
                                        statusBadge = "bg-danger";
                                        statusText = "Đã hủy";
                                        break;
                                    default:
                                        statusBadge = "bg-secondary";
                                        statusText = "Không xác định";
                                        break;
                                }
                            }
                            <span class="badge @statusBadge">@statusText</span>
                        </td>
                        <td>@item.NgayTao</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-info text-white me-1" onclick="inHoaDon(@item.Id)" title="In hóa đơn">
                                <i class="fas fa-print"></i>
                            </button>
                            @if (item.TrangThai == -1)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle"></i> Đã hoàn tiền
                                </span>
                            }
                            else if (item.TrangThai == 4)
                            {
                                <button type="button" class="btn btn-sm btn-success" onclick="hoanThanhDonHang(@item.Id)" title="Hoàn thành đơn hàng">
                                    <i class="fas fa-check-double"></i>
                                </button>
                            }
                            else if (item.TrangThai == 5)
                            {
                                <span class="badge bg-success">Đã hoàn thành</span>
                            }
                            else if (item.TrangThai == 6)
                            {
                                <button class="btn btn-sm btn-success" onclick="xacNhanTraHang(@item.Id)" title="Xác nhận đã nhận hàng trả lại">
                                    <i class="fas fa-check-circle"></i>
                                </button>
                            }
                            else if (item.TrangThai == 7)
                            {
                                <span class="badge bg-secondary">
                                    <i class="fas fa-box-open"></i> Đã trả hàng
                                </span>
                            }
                            else if (item.TrangThai < 4)
                            {
                                if (Session["Role"] != null && Convert.ToInt32(Session["Role"]) == 4 && item.TrangThai == 1)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Đợi duyệt</span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-primary" onclick="capNhatTrangThai(@item.Id, @item.TrangThai)" title="Cập nhật trạng thái">
                                        <i class="fas fa-sync"></i>
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                    <tr style="padding: 0; border: 0;">
                        <td colspan="7" class="p-0" style="border: 0;">
                            <div id="collapse-@item.Id" style="display: none; background-color: #f8f9fa;">
                                <div class="p-3">
                                    <strong>Thông tin liên hệ & Thanh toán:</strong>
                                    <ul class="mb-0 mt-2">
                                        <li><strong>Số điện thoại:</strong> @item.SoDienThoai</li>
                                        <li><strong>Email:</strong> @item.Email</li>
                                        <li><strong>Địa chỉ giao hàng:</strong> @item.DiaChi</li>
                                        <li><strong>Loại thanh toán:</strong> @item.PhuongThucThanhToan</li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DonHang" : "TimDonHang",
                    new { timdh = ViewBag.TuKhoa, page = currentPage - 1 })">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action(
                        String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DonHang" : "TimDonHang",
                        new { timdh = ViewBag.TuKhoa, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DonHang" : "TimDonHang",
                    new { timdh = ViewBag.TuKhoa, page = currentPage + 1 })">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

    <script>
        function toggleOrderRow(id) {
            var target = document.getElementById('collapse-' + id);
            if (target) {
                // Tắt hoàn toàn hiệu ứng Collapse của Bootstrap, chuyển sang dùng style display cơ bản
                // Để khắc phục triệt để lỗi "bấm vào hiện ra 1 giây rồi mất để lại khoảng trống" do Bootstrap tính toán sai chiều cao TR
                if (target.style.display === 'none' || target.style.display === '') {
                    target.style.display = 'block';
                } else {
                    target.style.display = 'none';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
        // Ngăn chặn sự kiện click lan truyền từ các nút chức năng để không mở/đóng dòng ẩn
        const actionButtons = document.querySelectorAll('#orderTable tbody tr .btn');
        actionButtons.forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        });
    });
</script>

<!-- Modal In Hóa Đơn -->
