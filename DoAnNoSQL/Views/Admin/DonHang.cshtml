    // ===== CẤU HÌNH NGÂN HÀNG CHO QR CODE =====
    // Thay đổi thông tin bên dưới thành thông tin ngân hàng thực tế của bạn
    var BANK_CONFIG = {
        BANK_ID: 'TECHCOMBANK',              // Mã ngân hàng (VD: MB, VCB, TCB, ACB, BIDV, VPB, TPB...)
        ACCOUNT_NO: '8939796898',   // Số tài khoản ngân hàng
        ACCOUNT_NAME: 'KHOA LUAN CU NHAN', // Tên chủ tài khoản (viết HOA, không dấu)
        BANK_NAME: 'Techcombank',       // Tên hiển thị ngân hàng
        TEMPLATE: 'qr_only'        // Template QR: compact, compact2, qr_only, print
    };
    // ============================================

    /**
     * Tạo URL ảnh QR VietQR
     * @@param {number} amount - Số tiền cần thanh toán
     * @@param {string} addInfo - Nội dung chuyển khoản
     * @@returns {string} URL ảnh QR
     */
    function buildVietQRUrl(amount, addInfo) {
        var baseUrl = 'https://img.vietqr.io/image/';
        var url = baseUrl + BANK_CONFIG.BANK_ID + '-' + BANK_CONFIG.ACCOUNT_NO + '-' + BANK_CONFIG.TEMPLATE + '.png';
        url += '?amount=' + amount;
        url += '&addInfo=' + encodeURIComponent(addInfo);
        url += '&accountName=' + encodeURIComponent(BANK_CONFIG.ACCOUNT_NAME);
        return url;
    }

    function inHoaDon(orderId) {
        $.ajax({
            url: '@Url.Action("GetOrderDetails", "Admin")',
            type: 'GET',
            data: { id: orderId },
            success: function (res) {
                if (res.success) {
                    $('#invMaDon').text('#' + res.MaDonHang);
                    $('#invTenKhach').text(res.TenKhachHang);
                    $('#invTenKhachKy').text(res.TenKhachHang);
                    $('#invEmailKhach').text(res.Email || '');
                    $('#invSdtKhach').text(res.SoDienThoai || '');
                    $('#invNgayDat').text(res.NgayTao);
                    $('#invTrangThai').text(res.TrangThaiText);
                    $('#invPTTT').text(res.PhuongThucThanhToan);
                    $('#invTongTien').text(res.TongTien.toLocaleString('vi-VN') + ' VNĐ');

                    var tbody = '';
                    if (res.ChiTiet && res.ChiTiet.length > 0) {
                        res.ChiTiet.forEach(function(item, index) {
                            tbody += `
                                <tr>
                                    <td class="text-center">${index + 1}</td>
                                    <td>${item.TenSanPham}</td>
                                    <td class="text-center">${item.SoLuong}</td>
                                    <td class="text-end">${item.Gia.toLocaleString('vi-VN')} VNĐ</td>
                                    <td class="text-end">${item.ThanhTien.toLocaleString('vi-VN')} VNĐ</td>
                                </tr>
                            `;
                        });
                    } else {
                        tbody = `<tr><td colspan="5" class="text-center">Không có sản phẩm nào</td></tr>`;
                    }
                    $('#invChiTietBody').html(tbody);

                    // ===== TẠO QR CODE CHUYỂN KHOẢN =====
                    var tongTienRaw = res.TongTien; // Số tiền dạng số nguyên
                    var maDon = res.MaDonHang || orderId;
                    var noiDungCK = 'Thanh toan DH ' + maDon; // Nội dung chuyển khoản
                    var qrUrl = buildVietQRUrl(tongTienRaw, noiDungCK);

                    // Cập nhật ảnh QR và thông tin ngân hàng
                    $('#invQRCode').attr('src', qrUrl);
                    $('#invBankName').text(BANK_CONFIG.BANK_NAME);
                    $('#invAccountName').text(BANK_CONFIG.ACCOUNT_NAME);
                    $('#invAccountNo').text(BANK_CONFIG.ACCOUNT_NO);
                    $('#invQRAmount').text(tongTienRaw.toLocaleString('vi-VN') + ' VNĐ');
                    $('#invTransferNote').text(noiDungCK);
                    // ====================================
                    
                    // Sử dụng getInstance hoặc khởi tạo mới để tránh lỗi modal hiện ra rồi tắt liền
                    var modalEl = document.getElementById('printInvoiceModal');
                    var printModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    printModal.show();
                } else {
                    Swal.fire('Lỗi!', res.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Lỗi!', 'Không thể tải thông tin hóa đơn', 'error');
            }
        });
    }

    // Sync edited customer name to signature area (with null check)
    var invTenKhachInput = document.getElementById('invTenKhach');
    if (invTenKhachInput) {
        invTenKhachInput.addEventListener('input', function() {
            var kyElem = document.getElementById('invTenKhachKy');
            if (kyElem) kyElem.textContent = this.textContent;
        });
    }

    function printInvoice() {
        var printContent = document.getElementById('invoicePrintArea').innerHTML;
        var printWindow = window.open('', '_blank');
        
        printWindow.document.write('<html><head><title>In Hóa Đơn</title>');
        
        // Lấy tất cả các thẻ link css từ trang hiện tại (Bootstrap, FontAwesome...)
        var styles = document.querySelectorAll('link[rel="stylesheet"]');
        styles.forEach(function(style) {
            printWindow.document.write('<link rel="stylesheet" href="' + style.href + '">');
        });
        
        // Copy các thẻ style để nhận CSS logo chìm
        var styleTags = document.querySelectorAll('style');
        styleTags.forEach(function(s) {
            printWindow.document.write('<style>' + s.innerHTML + '</style>');
        });
        
        printWindow.document.write('<style>@@page { margin: 10mm 15mm; } body { padding: 0; margin: 0; background-color: white; } .invoice-container { max-width: 800px; margin: 0 auto; page-break-after: avoid; } .editable-field { border: none !important; background: transparent !important; padding: 0 !important; } .qr-payment-section { width: 100% !important; text-align: center !important; margin: 16px auto !important; } .qr-payment-section * { text-align: center !important; } #invQRCode { display: block !important; margin: 0 auto !important; margin-left: auto !important; margin-right: auto !important; width: 220px !important; height: 220px !important; }</style>');
        printWindow.document.write('</head><body>');
        printWindow.document.write(printContent);
        printWindow.document.write('</body></html>');
        
        printWindow.document.close();
        
        // Đợi CSS load xong rồi mới gọi in
        setTimeout(function() {
            printWindow.focus();
            printWindow.print();
            printWindow.close();
        }, 500);
    }
</script>
