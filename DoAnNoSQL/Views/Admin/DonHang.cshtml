                            <p class="mb-1"><i class="fas fa-envelope me-1"></i> @DoAnNoSQL.Helpers.SettingsHelper.GetValue("EmailLienHe", "khoaluancunhan@gmail.com")</p>
                            <p class="mb-1"><i class="fas fa-phone me-1"></i> @DoAnNoSQL.Helpers.SettingsHelper.GetValue("Hotline", "028 3816 3318")</p>
                        </div>
                        <div class="col-5 text-end">
                            <h4 class="fw-bold text-secondary mb-1">HÓA ĐƠN</h4>
                            <p class="mb-0 small text-muted">Mã đơn: <strong id="invMaDon" class="text-dark"></strong></p>
                        </div>
                    </div>
                    
                    <hr />

                    <div class="row mb-4">
                        <div class="col-6">
                            <p class="mb-2 text-muted fw-bold">KHÁCH HÀNG:</p>
                            <p class="mb-1 text-nowrap"><span class="pe-1">Tên khách hàng:</span> <span class="fs-5" id="invTenKhach"></span></p>
                            <p class="mb-1 text-nowrap"><span class="pe-1">SĐT:</span> <span id="invSdtKhach"></span></p>
                        </div>
                        <div class="col-6 text-end">
                            <p class="mb-1 text-muted fw-bold">THÔNG TIN THANH TOÁN:</p>
