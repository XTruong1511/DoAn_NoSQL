            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="printInvoiceModalLabel"><i class="fas fa-file-invoice"></i> Chi Tiết Hóa Đơn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="invoicePrintArea">
                <!-- Nội dung hóa đơn -->
                <div class="invoice-container p-4">
                    <div class="text-center mb-4">
                        <h2 class="text-primary fw-bold text-nowrap m-0" style="font-size: 1.6rem; letter-spacing: 1px;">@DoAnNoSQL.Helpers.SettingsHelper.GetValue("TenCuaHang", "CỬA HÀNG THIẾT BỊ ĐIỆN TỬ - TTT")</h2>
