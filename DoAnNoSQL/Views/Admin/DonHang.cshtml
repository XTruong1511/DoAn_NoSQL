                                <i class="fas fa-qrcode me-1"></i>Quét mã QR để chuyển khoản thanh toán
                            </p>
                            <img id="invQRCode" src="" alt="QR Chuyển khoản" style="display: block; margin: 0 auto; margin-left: auto; margin-right: auto; width: 220px; height: 220px; object-fit: contain; border: 1px solid #dee2e6; border-radius: 8px; padding: 4px; background: white;" />
                        </div>
                    </div>

                    <!-- <div class="row mt-3 text-center" style="page-break-inside: avoid; break-inside: avoid;">
                        <div class="col-6">
                            <h6 class="fw-bold">Khách hàng</h6>
                            <p class="text-muted fst-italic">(Ký, ghi rõ họ tên)</p>
                            <p class="mt-3 fw-bold" id="invTenKhachKy" style="min-height: 24px;"></p>
                        </div>
                        <div class="col-6">
                            <h6 class="fw-bold">Người lập phiếu</h6>
                            <p class="text-muted fst-italic">(Ký, ghi rõ họ tên)</p>
                            <p class="mt-3 fw-bold" style="min-height: 24px;">@Session["UserName"]</p>
                        </div>
                    </div> -->
                </div>
