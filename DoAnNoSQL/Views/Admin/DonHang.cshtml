</div>

<style>
    /* Ẩn các nút khi in */
    .print-hide {
        display: none !important;
    }
    
    /* Giao diện cho phép sửa tên, sđt */
    .editable-field {
        border-bottom: 1px dashed #ccc;
        padding: 0 4px;
        min-width: 100px;
        display: inline-block;
        transition: background-color 0.2s;
    }
    .editable-field:hover, .editable-field:focus {
        background-color: #f8f9fa;
        outline: none;
        border-bottom-color: #0d6efd;
    }

    /* Thêm logo chìm cho hóa đơn */
    .invoice-container {
        position: relative;
        z-index: 1;
    }
    .invoice-container::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 500px;
        height: 500px;
        background-image: url('/Content/images/@DoAnNoSQL.Helpers.SettingsHelper.GetValue("LogoCuaHang", "logo.png")');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        opacity: 0.15;
        z-index: -1;
        pointer-events: none;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
    }

    /* QR Payment Section - in ra giữ màu và căn giữa tuyệt đối */
    .qr-payment-section {
        width: 100% !important;
        text-align: center !important;
        margin: 16px auto !important;
        display: block !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
    }
    .qr-payment-section .text-center,
    .qr-payment-section p {
        text-align: center !important;
        margin-left: auto !important;
        margin-right: auto !important;
    }
    .qr-box {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    @@media print {
        .qr-payment-section {
            width: 100% !important;
            text-align: center !important;
            margin: 16px auto !important;
            break-inside: avoid;
            page-break-inside: avoid;
        }
        .qr-payment-section * {
            text-align: center !important;
        }
        .qr-box {
            background: #f0f7ff !important;
            border: 2px dashed #0d6efd !important;
        }
    }

    /* Ép buộc kích thước QR luôn cố định và căn giữa kể cả khi in */
    #invQRCode {
        display: block !important;
        margin: 0 auto !important;
        margin-left: auto !important;
        margin-right: auto !important;
        width: 220px !important;
        height: 220px !important;
        min-width: 220px !important;
        min-height: 220px !important;
        max-width: 220px !important;
        max-height: 220px !important;
    }
</style>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Export all orders to Excel
    async function exportAllOrders() {
        try {
            // Show Loading
            Swal.fire({
                title: 'Đang xử lý...',
                text: 'Đang tải dữ liệu toàn bộ đơn hàng...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });
            
            // Fetch Data from server
            const response = await fetch('@Url.Action("GetOrdersForExport", "Admin")');
            const data = await response.json();
            
            if (!data || data.length === 0) {
                Swal.fire('Thông báo', 'Không có dữ liệu để xuất', 'info');
                return;
            }
            
            // Check for error
            if (data.error) {
                Swal.fire('Lỗi', 'Không thể tải dữ liệu: ' + data.error, 'error');
                return;
            }
            
            // Function to get status text
            function getTrangThaiText(status) {
                switch(status) {
                    case 1: return 'Chờ xác nhận';
                    case 2: return 'Đã xác nhận';
                    case 3: return 'Đang giao';
                    case 4: return 'Đã giao';
                    case 5: return 'Hoàn thành';
                    case 6: return 'Yêu cầu trả hàng';
                    case 7: return 'Đã trả hàng';
                    case -1: return 'Đã hủy';
                    default: return 'Không xác định';
                }
            }
            
            // Map data to Vietnamese headers
            const formattedData = data.map(item => ({
                "ID": item.ID,
                "Mã đơn hàng": item.MaDonHang || '',
                "Tên khách hàng": item.TenKhachHang || '',
                "Số điện thoại": item.SoDienThoai || '',
                "Email": item.Email || '',
                "Địa chỉ": item.DiaChi || '',
                "Tổng tiền": item.TongTien ? item.TongTien.toLocaleString('vi-VN') + ' đ' : '0 đ',
                "Số lượng SP": item.SoLuongSanPham || 0,
                "PT Thanh toán": item.PhuongThucThanhToan || '',
                "PT Vận chuyển": item.PhuongThucVanChuyen || '',
                "Mã giảm giá": item.MaGiamGia || '',
                "Trạng thái": getTrangThaiText(item.TrangThai),
                "Ngày tạo": item.NgayTao ? new Date(item.NgayTao).toLocaleDateString('vi-VN') : '',
                "Ngày cập nhật": item.NgayCapNhat ? new Date(item.NgayCapNhat).toLocaleDateString('vi-VN') : ''
            }));
            
            // Create Worksheet
            const ws = XLSX.utils.json_to_sheet(formattedData);
            
            // --- AUTO WIDTH LOGIC ---
            const range = XLSX.utils.decode_range(ws['!ref']);
            const colWidths = [];
            
            for (let C = range.s.c; C <= range.e.c; ++C) {
                let maxLen = 10; // Min width
                for (let R = range.s.r; R <= range.e.r; ++R) {
                    const cellRef = XLSX.utils.encode_cell({ c: C, r: R });
                    const cell = ws[cellRef];
                    if (cell && cell.v) {
                        const len = (cell.v.toString().length + 2); // Add padding
                        if (len > maxLen) maxLen = len;
                    }
                }
                colWidths.push({ wch: maxLen });
            }
            ws['!cols'] = colWidths;
            // ------------------------
            
            // Create Workbook
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "DanhSachDonHang");
            
            // Download file
            const filename = `DanhSachDonHang_Full_${new Date().toISOString().slice(0,10)}.xlsx`;
            XLSX.writeFile(wb, filename);
            
            // Show success message
            Swal.fire({
                icon: 'success',
                title: 'Thành công!',
                html: `Đã xuất <strong>${data.length}</strong> đơn hàng ra file Excel!`,
                timer: 2500,
                showConfirmButton: false
            });
        } catch (error) {
            console.error('Export error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Lỗi!',
                text: 'Không thể xuất file: ' + error.message
            });
        }
    }

    function hoanThanhDonHang(orderId) {
        Swal.fire({
            title: 'Xác nhận hoàn thành đơn hàng?',
            text: 'Đơn hàng đã được giao thành công và khách hàng đã nhận được hàng?',
