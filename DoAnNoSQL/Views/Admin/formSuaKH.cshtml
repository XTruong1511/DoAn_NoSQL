@model DoAnNoSQL.tb_TaiKhoan
@{
    ViewBag.Title = "Chỉnh Sửa Khách Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .form-section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .sticky-actions {
        padding: 1rem 0;
        margin-top: 1rem;
    }
</style>

@using (Html.BeginForm("SuaKH", "Admin", FormMethod.Post, new { id = "formEditKH" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0 text-gray-800 fw-bold">
            <i class="fas fa-user-edit text-primary me-2"></i>Sửa Khách Hàng: <span class="text-primary">@(string.IsNullOrEmpty(Model.HoTen) ? Model.TenDangNhap : Model.HoTen)</span>
        </h2>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("KhachHang", "Admin")" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center shadow-sm">
                <i class="fas fa-arrow-left me-2"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 d-inline-flex align-items-center shadow-sm fw-bold">
                <i class="fas fa-save me-2"></i> Cập nhật thông tin
            </button>
        </div>
    </div>

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 shadow-sm" })

    <div class="row g-4">
        <!-- Cột trái: Thông tin tài khoản & Cá nhân -->
        <div class="col-lg-8">
            <!-- Tài khoản -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-user-lock text-primary me-2"></i>Tài khoản đăng nhập</h5>
                    
                    <div class="form-floating mb-3">
                        @Html.EditorFor(model => model.TenDangNhap, new { htmlAttributes = new { @class = "form-control rounded-3 bg-light text-muted fw-semibold", @readonly = "readonly" } })
                        @Html.Label("TenDangNhap", "Tên đăng nhập (Cố định)")
                        <div class="form-text small text-muted"><i class="fas fa-lock me-1"></i>Tên đăng nhập không thể thay đổi sau khi tạo.</div>
                    </div>

                    <div class="alert alert-light border border-warning-subtle rounded-3 p-3 d-flex align-items-start mb-0">
                        <i class="fas fa-shield-alt text-warning fs-4 me-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Chính sách bảo mật mật khẩu</h6>
                            <p class="text-muted small mb-0">
                                Mật khẩu của khách hàng được mã hóa một chiều. Quản trị viên không có quyền xem hay can thiệp trực tiếp. Khách hàng có thể sử dụng chức năng <strong>"Quên mật khẩu"</strong> hoặc tự đổi trong trang cá nhân.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cá nhân & Liên hệ -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-id-card text-primary me-2"></i>Thông tin cá nhân & Liên hệ</h5>
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.HoTen, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "Họ và tên..." } })
                                @Html.Label("HoTen", "Họ và tên khách hàng")
                            </div>
                            @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "name@example.com", type = "email", required = "required" } })
                                @Html.Label("Email", "Địa chỉ Email *")
                            </div>
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.SoDienThoai, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "09...", type = "tel" } })
                                @Html.Label("SoDienThoai", "Số điện thoại liên hệ")
                            </div>
                            @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Trạng thái & Thống kê -->
        <div class="col-lg-4">
            <!-- Trạng thái -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-toggle-on text-primary me-2"></i>Trạng thái tài khoản</h5>
                    
                    <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mb-2">
                        <div>
                            <label class="form-check-label fw-bold text-dark d-block mb-1" for="HoatDongSwitch">
                                <span id="statusLabel" class="@(Model.HoatDong == true ? "text-success" : "text-danger")">
                                    @(Model.HoatDong == true ? "Đang hoạt động" : "Đang bị khóa")
                                </span>
                            </label>
                            <small class="text-muted">Cho phép khách hàng truy cập hệ thống</small>
                        </div>
                        @Html.CheckBox("HoatDong", Model.HoatDong ?? true, new { @class = "form-check-input ms-0 fs-4", id = "HoatDongSwitch", role = "switch" })
                    </div>
                </div>
            </div>

            <!-- Box Thông tin thành viên -->
            <div class="card shadow-sm border-0 rounded-4 mb-4 bg-light">
                <div class="card-body p-4 text-center">
                    <div class="avatar-circle mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; font-size: 1.75rem; font-weight: 700;">
                        @(string.IsNullOrEmpty(Model.HoTen) ? (Model.TenDangNhap?.Substring(0, 1).ToUpper() ?? "U") : Model.HoTen.Substring(0, 1).ToUpper())
                    </div>
                    <h5 class="fw-bold mb-1">@(string.IsNullOrEmpty(Model.HoTen) ? Model.TenDangNhap : Model.HoTen)</h5>
                    <p class="text-muted small mb-2 font-monospace">ID: #@Model.Id</p>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                        <i class="fas fa-check-circle me-1"></i> Khách hàng thân thiết
                    </span>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const switchEl = document.getElementById('HoatDongSwitch');
        const statusLabel = document.getElementById('statusLabel');

        if (switchEl && statusLabel) {
            switchEl.addEventListener('change', function() {
                if (this.checked) {
                    statusLabel.textContent = "Đang hoạt động";
                    statusLabel.className = "text-success";
                } else {
                    statusLabel.textContent = "Đang bị khóa";
                    statusLabel.className = "text-danger";
                }
            });
        }
    });
</script>
}

