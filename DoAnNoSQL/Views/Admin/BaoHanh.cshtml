                        <div class="warranty-card">
                            <div class="header">
                                <h4 class="text-primary text-uppercase fw-bold mb-1">@DoAnNoSQL.Helpers.SettingsHelper.GetValue("TenCuaHang", "CỬA HÀNG THIẾT BỊ ĐIỆN TỬ - TTT")</h4>
                                <p class="small text-muted mb-1">@DoAnNoSQL.Helpers.SettingsHelper.GetValue("DiaChiCuaHang", "140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP. HCM") | Hotline: @DoAnNoSQL.Helpers.SettingsHelper.GetValue("Hotline", "028 3816 3318")</p>
                                <h3 class="fw-bold mt-2 text-dark">PHIẾU BẢO HÀNH ĐIỆN TỬ</h3>
                                <div class="badge bg-primary fs-6">${data.MaBaoHanh}</div>
                            </div>
                            <table class="table table-borderless">
                                <tr><td width="35%"><strong>Tên khách hàng:</strong></td><td>${data.TenKhachHang}</td></tr>
                                <tr><td><strong>Số điện thoại:</strong></td><td>${data.SoDienThoai}</td></tr>
                                <tr><td><strong>Tên sản phẩm:</strong></td><td><strong>${data.TenSanPham}</strong> (${data.MaSanPham})</td></tr>
                                <tr><td><strong>Mã IMEI / Serial:</strong></td><td><code>${data.MaSeri || 'N/A'}</code></td></tr>
                                <tr><td><strong>Ngày kích hoạt:</strong></td><td>${data.NgayKichHoat}</td></tr>
                                <tr><td><strong>Thời hạn bảo hành:</strong></td><td><strong>${data.ThoiHanBaoHanh} tháng</strong></td></tr>
                                <tr><td><strong>Ngày hết hạn:</strong></td><td><strong class="text-danger">${data.NgayHetHan}</strong></td></tr>
                                ${data.GhiChu ? `<tr><td><strong>Ghi chú:</strong></td><td>${data.GhiChu}</td></tr>` : ''}
                                ${(() => {
                                    if (data.ThongTinBoSung && data.ThongTinBoSung.length > 0) {
                                        return data.ThongTinBoSung.map(tt => `<tr><td><strong>${tt.TenTruong}:</strong></td><td>${tt.GiaTri}</td></tr>`).join('');
                                    }
                                    return '';
                                })()}
                            </table>
                            <div class="mt-4 pt-3 border-top d-flex justify-content-between text-center">
                                <div><small>Khách hàng ký</small><div style="height: 60px;"></div><strong>${data.TenKhachHang}</strong></div>
                                <div><small>Đại diện cửa hàng</small><div style="height: 60px;"></div><strong>TTT Electronics</strong></div>
                            </div>
                            <div class="text-center mt-3 text-muted small">Quý khách vui lòng giữ phiếu hoặc cung cấp SĐT / IMEI khi đến bảo hành.</div>
                        </div>
                    </body>
                    </html>
                `);
                win.document.close();
                win.focus();
                setTimeout(() => { win.print(); win.close(); }, 300);
            });
    }

    // In Phiếu Tiếp Nhận Máy Sửa Chữa
    function inPhieuTiepNhan(id) {
        fetch('@Url.Action("LayThongTinInPhieuSua", "Admin")/' + id)
            .then(res => res.json())
            .then(data => {
                if (!data.success) return;
                const win = window.open('', '_blank');
                win.document.write(`
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <title>Phiếu Tiếp Nhận - ${data.MaPhieu}</title>
                        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
                        <style>
                            body { padding: 30px; font-family: Arial, sans-serif; }
                            .ticket-card { border: 2px solid #212529; border-radius: 8px; padding: 25px; max-width: 700px; margin: 0 auto; }
                            .header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 15px; margin-bottom: 15px; }
                        </style>
                    </head>
                    <body>
                        <div class="ticket-card">
                            <div class="header">
                                <h4 class="text-uppercase fw-bold mb-1">@DoAnNoSQL.Helpers.SettingsHelper.GetValue("TenCuaHang", "CỬA HÀNG THIẾT BỊ ĐIỆN TỬ - TTT")</h4>
                                <p class="small text-muted mb-1">@DoAnNoSQL.Helpers.SettingsHelper.GetValue("DiaChiCuaHang", "140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP. HCM") | Hotline: @DoAnNoSQL.Helpers.SettingsHelper.GetValue("Hotline", "028 3816 3318")</p>
                                <h3 class="fw-bold mt-2">PHIẾU TIẾP NHẬN BẢO HÀNH & SỬA CHỮA</h3>
                                <span class="badge bg-dark fs-6">${data.MaPhieu}</span>
                            </div>
                            <table class="table table-bordered">
                                <tr><th width="30%">Khách hàng:</th><td><strong>${data.TenKhachHang}</strong> - ${data.SoDienThoai}</td></tr>
                                <tr><th>Sản phẩm:</th><td>${data.TenSanPham} (IMEI: ${data.MaSeri || 'N/A'})</td></tr>
                                <tr><th>Mã bảo hành:</th><td>${data.MaBaoHanh}</td></tr>
                                <tr><th>Triệu chứng lỗi:</th><td><strong class="text-danger">${data.TrieuChungLoi}</strong></td></tr>
                                <tr><th>Tình trạng ngoại quan:</th><td>${data.TinhTrangTiepNhan || 'Bình thường'}</td></tr>
                                <tr><th>Ngày tiếp nhận:</th><td>${data.NgayTiepNhan}</td></tr>
                                <tr><th>Hẹn trả dự kiến:</th><td><strong>${data.NgayHenTra}</strong></td></tr>
                                <tr><th>Chi phí dự kiến:</th><td>${data.ChiPhiPhatSinh > 0 ? data.ChiPhiPhatSinh.toLocaleString() + ' VNĐ' : 'Bảo hành miễn phí'}</td></tr>
                                <tr><th>Người tiếp nhận:</th><td>${data.NguoiTiepNhan || 'Nhân viên'}</td></tr>
                            </table>
                            <div class="mt-4 pt-3 d-flex justify-content-between text-center">
                                <div><small>Khách hàng bàn giao máy</small><div style="height: 60px;"></div><strong>${data.TenKhachHang}</strong></div>
                                <div><small>Nhân viên tiếp nhận</small><div style="height: 60px;"></div><strong>${data.NguoiTiepNhan || 'TTT Staff'}</strong></div>
                            </div>
                            <div class="text-center mt-3 text-muted small">Vui lòng mang theo phiếu này khi đến nhận máy. Xin cảm ơn!</div>
                        </div>
                    </body>
                    </html>
                `);
                win.document.close();
                win.focus();
                setTimeout(() => { win.print(); win.close(); }, 300);
            });
    }
</script>
}



