    // Submit form thêm/sửa Bảo Hành
    function submitFormBaoHanh(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('bh_Id').value) || 0;
        const url = id > 0 ? '@Url.Action("SuaBaoHanh", "Admin")' : '@Url.Action("ThemBaoHanh", "Admin")';

        const thongTinBoSung = [];
        document.querySelectorAll('.bh-custom-field-row').forEach(row => {
            const nameInput = row.querySelector('input[name="CustomFieldName"]');
            const valInput = row.querySelector('input[name="CustomFieldValue"]');
            const name = nameInput ? nameInput.value.trim() : '';
            const val = valInput ? valInput.value.trim() : '';
            if (name && val) {
                thongTinBoSung.push({ TenTruong: name, GiaTri: val });
            }
        });

        const formData = {
            Id: id,
            SanPhamId: parseInt(document.getElementById('bh_SanPhamId').value),
            MaSeri: document.getElementById('bh_MaSeri').value,
            TenKhachHang: document.getElementById('bh_TenKhachHang').value,
            SoDienThoai: document.getElementById('bh_SoDienThoai').value,
            Email: document.getElementById('bh_Email').value,
            DiaChi: document.getElementById('bh_DiaChi').value,
            NgayKichHoat: document.getElementById('bh_NgayKichHoat').value,
            ThoiHanBaoHanh: parseInt(document.getElementById('bh_ThoiHanBaoHanh').value),
            GhiChu: document.getElementById('bh_GhiChu').value,
            ThongTinBoSung: thongTinBoSung
        };

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: res.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => location.reload());
            } else {
                Swal.fire('Lỗi', res.message, 'error');
            }
        })
        .catch(err => Swal.fire('Lỗi', err.message, 'error'));
    }

