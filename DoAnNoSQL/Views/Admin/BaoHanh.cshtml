    // Tìm kiếm Ajax phiếu bảo hành khi nhập ở modal Tiếp nhận
    let searchTimeout = null;
    function onSearchBaoHanhAjax(val) {
        clearTimeout(searchTimeout);
        const resultsBox = document.getElementById('searchBaoHanhResults');
        if (!val || val.trim().length < 2) {
            resultsBox.style.display = 'none';
            return;
        }

        searchTimeout = setTimeout(() => {
            fetch('@Url.Action("TraCuuBaoHanhAjax", "Admin")?keyword=' + encodeURIComponent(val))
                .then(res => res.json())
                .then(items => {
                    if (items && items.length > 0) {
                        let html = '';
                        items.forEach(it => {
                            const maBH = (it.MaBaoHanh || '').replace(/'/g, "\\'");
                            const tenKH = (it.TenKhachHang || '').replace(/'/g, "\\'");
                            const sdt = (it.SoDienThoai || '').replace(/'/g, "\\'");
                            const tenSP = (it.TenSanPham || '').replace(/'/g, "\\'");
                            const maSeri = (it.MaSeri || '').replace(/'/g, "\\'");
                            
                            html += `
                                <a href="javascript:void(0)" class="list-group-item list-group-item-action" onclick="selectBaoHanhForTiepNhan(${it.Id}, '${maBH}', '${tenKH}', '${sdt}', '${tenSP}', '${maSeri}', '${it.NgayHetHan}', ${it.IsConHan})">
                                    <div class="d-flex justify-content-between">
                                        <strong>${it.TenSanPham}</strong>
                                        <span class="badge ${it.IsConHan ? 'bg-success' : 'bg-secondary'}">${it.IsConHan ? 'Còn hạn' : 'Hết hạn'}</span>
                                    </div>
                                    <small class="text-muted">Mã: ${it.MaBaoHanh} | IMEI: ${it.MaSeri || 'N/A'} | KH: ${it.TenKhachHang} - ${it.SoDienThoai}</small>
                                </a>
                            `;
                        });
                        resultsBox.innerHTML = html;
                        resultsBox.style.display = 'block';
                    } else {
                        resultsBox.innerHTML = '<div class="p-2 text-muted small">Không tìm thấy thẻ bảo hành phù hợp</div>';
                        resultsBox.style.display = 'block';
                    }
                });
        }, 300);
    }

