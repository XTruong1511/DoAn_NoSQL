                        data.ThongTinBoSung.forEach(item => {
                            addBhCustomFieldRow(item.TenTruong, item.GiaTri);
                        });
                    }

                    calculateExpiryDate();
                    var modalEl = document.getElementById('modalBaoHanh');
                    (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl)).show();
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                }
            })
            .catch(err => Swal.fire('Lỗi', err.message, 'error'));
