@model DoAnNoSQL.tb_ThuongHieu
@{
    ViewBag.Title = "Chỉnh Sửa Thương Hiệu";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .form-section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .sticky-actions {
        padding: 1rem 0;
        margin-top: 1rem;
    }
    .file-upload-wrapper {
        border: 2px dashed #cbd5e1;
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        background: #f8fafc;
        transition: all 0.25s ease;
        cursor: pointer;
    }
    .file-upload-wrapper:hover {
        border-color: #3b82f6;
        background: #eff6ff;
    }
</style>

@using (Html.BeginForm("SuaTH", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", id = "formEditTH" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 mb-0 text-gray-800 fw-bold">
            <i class="fas fa-edit text-primary me-2"></i>Sửa Thương Hiệu: <span class="text-primary">@Model.TenThuongHieu</span>
        </h2>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("ThuongHieu", "Admin")" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center shadow-sm">
                <i class="fas fa-arrow-left me-2"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 d-inline-flex align-items-center shadow-sm fw-bold">
                <i class="fas fa-save me-2"></i> Cập nhật thương hiệu
            </button>
        </div>
    </div>

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 shadow-sm" })

    <div class="row g-4">
        <!-- Cột trái: Thông tin chính -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-info-circle text-primary me-2"></i>Thông tin cơ bản</h5>
                    
                    <div class="form-floating mb-3">
                        @Html.EditorFor(model => model.TenThuongHieu, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "Tên thương hiệu...", id = "TenThuongHieu", required = "required" } })
                        @Html.Label("TenThuongHieu", "Tên thương hiệu *")
                        @Html.ValidationMessageFor(model => model.TenThuongHieu, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-floating mb-2">
                        @Html.EditorFor(model => model.BiDanh, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "vd: apple-chinh-hang", id = "BiDanh" } })
                        @Html.Label("BiDanh", "Bí danh URL (Slug)")
                        @Html.ValidationMessageFor(model => model.BiDanh, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Logo & Trạng thái -->
        <div class="col-lg-5">
            <!-- Logo thương hiệu -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-image text-primary me-2"></i>Logo thương hiệu</h5>
                    
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <div class="mb-3 text-center p-3 bg-light rounded-4 border">
                            <span class="badge bg-secondary-subtle text-secondary border mb-2">Logo hiện tại</span>
                            <div class="p-2 bg-white rounded-3 border d-inline-block">
                                <img src="@Url.Content("~/Content/Images/" + Model.HinhAnh)" alt="@Model.TenThuongHieu" class="img-fluid" style="max-height: 90px; max-width: 220px; object-fit: contain;">
                            </div>
                            <small class="text-muted d-block mt-2 font-monospace">@Model.HinhAnh</small>
                        </div>
                    }

                    <div class="file-upload-wrapper mb-3" onclick="document.getElementById('logoFile').click();">
                        <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">@(string.IsNullOrEmpty(Model.HinhAnh) ? "Chọn logo thương hiệu" : "Tải logo mới để thay thế")</h6>
                        <span class="text-muted small">PNG, JPG, SVG hoặc WEBP (Khuyến nghị 200x100px)</span>
                        <input type="file" name="logoFile" id="logoFile" class="d-none" accept="image/*">
                    </div>

                    <div id="imagePreview" class="text-center p-3 rounded-4 bg-light border" style="display: none;">
                        <span class="badge bg-success-subtle text-success border border-success-subtle mb-2">Logo mới xem trước</span>
                        <div class="p-2 bg-white rounded-3 border d-inline-block">
                            <img id="previewImg" src="" alt="Preview" class="img-fluid" style="max-height: 90px; max-width: 220px; object-fit: contain;">
                        </div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" id="clearImage">
                                <i class="fas fa-times me-1"></i> Bỏ logo mới
                            </button>
                        </div>
                    </div>

                    @Html.ValidationMessageFor(model => model.HinhAnh, "", new { @class = "text-danger small" })
                </div>
            </div>

            <!-- Trạng thái -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="form-section-title"><i class="fas fa-toggle-on text-primary me-2"></i>Trạng thái hiển thị</h5>
                    
                    <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-check-label fw-bold text-dark d-block mb-1" for="HienThiSwitch">Hiển thị thương hiệu</label>
                            <small class="text-muted">Cho phép hiển thị thương hiệu trên trang chủ và danh mục</small>
                        </div>
                        @Html.CheckBox("HienThi", Model?.HienThi ?? false, new { @class = "form-check-input ms-0 fs-4", id = "HienThiSwitch", role = "switch" })
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const logoInput = document.getElementById('logoFile');
        const previewContainer = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');
        const clearBtn = document.getElementById('clearImage');

        if (logoInput) {
            logoInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const validTypes = ['image/jpeg', 'image/png', 'image/svg+xml', 'image/gif', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Định dạng không hợp lệ',
                            text: 'Vui lòng chọn file ảnh (JPG, PNG, SVG, WEBP, GIF)',
                            confirmButtonColor: '#3b82f6'
                        });
                        this.value = '';
                        previewContainer.style.display = 'none';
                        return;
                    }
                    
                    if (file.size > 2 * 1024 * 1024) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Dung lượng quá lớn',
                            text: 'Kích thước file không được vượt quá 2MB',
                            confirmButtonColor: '#3b82f6'
                        });
                        this.value = '';
                        previewContainer.style.display = 'none';
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        previewImg.src = e.target.result;
                        previewContainer.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                } else {
                    previewContainer.style.display = 'none';
                }
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                logoInput.value = '';
                previewContainer.style.display = 'none';
                previewImg.src = '';
            });
        }
    });
</script>
}
