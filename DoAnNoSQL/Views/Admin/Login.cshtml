@model DoAnNoSQL.Models.LoginViewModel
@{
    Layout = null;
    ViewBag.Title = "Đăng nhập Quản trị viên";
    var tenCuaHang = DoAnNoSQL.Helpers.SettingsHelper.GetValue("TenCuaHang", "CỬA HÀNG THIẾT BỊ ĐIỆN TỬ");
    var logo = DoAnNoSQL.Helpers.SettingsHelper.GetValue("LogoCuaHang", "logo.png");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập Quản trị - @tenCuaHang</title>
    <link rel="icon" type="image/x-icon" href="~/Content/images/@logo">

    <!-- Google Fonts: Plus Jakarta Sans & Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Three.js CDN for 3D Background -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style>
        :root {
            --primary: #0d9488;
            --primary-hover: #0f766e;
            --primary-gradient: linear-gradient(135deg, #0d9488 0%, #0284c7 100%);
            --accent: #2dd4bf;
            --bg-dark: #030712;
            --card-bg: rgba(10, 16, 31, 0.88);
            --card-border: rgba(45, 212, 191, 0.28);
            --input-bg: rgba(15, 23, 42, 0.7);
            --input-border: rgba(255, 255, 255, 0.12);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            padding: 24px 16px;
        }

        /* 3D WebGL Background Canvas */
        #admin-web3d-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* Ambient Glow & Cyber Vignette */
        .cyber-vignette {
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse at center, transparent 40%, rgba(3, 7, 18, 0.85) 100%);
            z-index: 1;
            pointer-events: none;
        }

        .ambient-glow {
            position: fixed;
            width: 550px;
            height: 550px;
            border-radius: 50%;
            filter: blur(140px);
            opacity: 0.25;
            z-index: 1;
            pointer-events: none;
            animation: floatGlow 16s infinite alternate ease-in-out;
        }
        .glow-1 {
            top: -100px;
            left: -100px;
            background: radial-gradient(circle, #0d9488, #0284c7);
        }
        .glow-2 {
            bottom: -120px;
            right: -100px;
            background: radial-gradient(circle, #6366f1, #0d9488);
            animation-duration: 20s;
            animation-direction: alternate-reverse;
        }

        @@keyframes floatGlow {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(50px, 30px) scale(1.1); }
            100% { transform: translate(-30px, 50px) scale(0.95); }
        }

        /* Running Border Beam Effect */
        .border-beam-3d {
            position: relative;
        }
        .border-beam-3d::after {
            content: '';
            position: absolute;
            inset: -1px;
            border-radius: inherit;
            padding: 1.5px;
            background: linear-gradient(
                90deg,
                transparent 0%,
                rgba(45, 212, 191, 0.85) 50%,
                transparent 100%
            );
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            background-size: 200% 100%;
            animation: beamMove3D 5s linear infinite;
            z-index: 3;
        }

        @@keyframes beamMove3D {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* Main Container Card with 3D Perspective Tilt */
        .login-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 1040px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 28px;
            box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.8),
                        0 0 50px rgba(13, 148, 136, 0.2),
                        inset 0 1px 1px rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            overflow: hidden;
            animation: fadeInCard 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            transition: box-shadow 0.3s ease;
        }

        @@keyframes fadeInCard {
            from {
                opacity: 0;
                transform: translateY(24px) scale(0.97);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Left Showcase Panel */
        .showcase-panel {
            background: linear-gradient(155deg, rgba(15, 23, 42, 0.85) 0%, rgba(8, 14, 28, 0.95) 100%);
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            padding: 48px 36px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .showcase-panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--primary-gradient);
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(13, 148, 136, 0.16);
            border: 1px solid rgba(45, 212, 191, 0.35);
            padding: 6px 16px;
            border-radius: 9999px;
            font-size: 11.5px;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: var(--accent);
            text-transform: uppercase;
            width: fit-content;
            margin-bottom: 24px;
        }

        .brand-badge .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent);
            animation: pulseAnim 2s infinite;
        }

        @@keyframes pulseAnim {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }

        .store-logo-wrapper {
            width: 84px;
            height: 84px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            margin-bottom: 16px;
            background: rgba(13, 148, 136, 0.12);
            border: 1px solid rgba(45, 212, 191, 0.3);
            border-radius: 24px;
            padding: 12px;
            box-shadow: 0 8px 24px rgba(13, 148, 136, 0.25);
        }

        .store-logo-wrapper:hover {
            transform: scale(1.08) rotate(4deg);
            border-color: var(--accent);
            box-shadow: 0 12px 30px rgba(45, 212, 191, 0.4);
        }

        .store-logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 14px;
        }

        .showcase-content {
            text-align: center;
        }

        .showcase-content h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 20px;
            font-weight: 800;
            line-height: 1.3;
            letter-spacing: -0.01em;
            margin-bottom: 10px;
            text-align: center;
            background: linear-gradient(135deg, #ffffff 30%, #a5f3fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .showcase-content p {
            color: var(--text-muted);
            font-size: 13.5px;
            line-height: 1.6;
            margin-bottom: 28px;
            text-align: center;
        }

        .feature-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 13.5px;
            color: #e2e8f0;
            font-weight: 600;
            padding: 8px 12px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.25s ease;
        }

        .feature-item:hover {
            background: rgba(13, 148, 136, 0.12);
            border-color: rgba(45, 212, 191, 0.3);
            transform: translateX(4px);
        }

        .feature-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(13, 148, 136, 0.2);
            border: 1px solid rgba(45, 212, 191, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 15px;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

        .feature-item:hover .feature-icon {
            background: var(--accent);
            color: #030712;
            transform: scale(1.08);
        }

        .showcase-footer {
            margin-top: 32px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: var(--text-muted);
        }

        .system-status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #34d399;
            font-weight: 700;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background-color: #34d399;
            border-radius: 50%;
            box-shadow: 0 0 8px #34d399;
            animation: pulseAnim 2s infinite;
        }

        /* Right Form Panel */
        .form-panel {
            padding: 48px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: rgba(10, 16, 31, 0.7);
            position: relative;
        }

        .form-header {
            margin-bottom: 26px;
            text-align: center;
        }

        .form-header h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 26px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            letter-spacing: -0.02em;
        }

        .form-header p {
            color: var(--text-muted);
            font-size: 13px;
        }

        /* Inputs */
        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 12px;
            font-weight: 700;
            color: #cbd5e1;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            color: #64748b;
            font-size: 15px;
            pointer-events: none;
            transition: color 0.25s;
        }

        .form-control-custom {
            width: 100%;
            height: 50px;
            background: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: 14px;
            padding: 0 44px 0 44px;
            color: #ffffff;
            font-size: 14px;
            font-weight: 500;
            font-family: inherit;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            outline: none;
        }

        .form-control-custom:focus {
            border-color: var(--accent);
            background: rgba(15, 23, 42, 0.95);
            box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.2), 0 0 20px rgba(13, 148, 136, 0.25);
        }

        .input-wrapper:focus-within .input-icon {
            color: var(--accent);
        }

        .form-control-custom::placeholder {
            color: #64748b;
            font-size: 13.5px;
        }

        /* Toggle password visibility button */
        .toggle-password {
            position: absolute;
            right: 14px;
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 6px;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s;
        }

        .toggle-password:hover {
            color: var(--accent);
        }

        /* Error alert */
        .alert-danger-custom {
            background: rgba(239, 68, 68, 0.14);
            border: 1px solid rgba(239, 68, 68, 0.35);
            color: #fca5a5;
            padding: 12px 16px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: shake 0.4s ease-in-out;
        }

        .alert-danger-custom ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-5px); }
            40%, 80% { transform: translateX(5px); }
        }

        /* Submit Button 3D */
        .btn-submit-custom {
            width: 100%;
            height: 50px;
            background: var(--primary-gradient);
            color: #ffffff;
            border: none;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 800;
            font-family: inherit;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 10px 25px -5px rgba(13, 148, 136, 0.5);
            transition: all 0.25s ease;
            margin-top: 10px;
            position: relative;
            overflow: hidden;
        }

        .btn-submit-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px -4px rgba(13, 148, 136, 0.65);
            filter: brightness(1.1);
        }

        .btn-submit-custom:active {
            transform: translateY(0);
        }

        /* Bottom back button */
        .back-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            margin-top: 24px;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: var(--accent);
        }

        .back-link i {
            transition: transform 0.2s;
        }

        .back-link:hover i {
            transform: translateX(-4px);
        }

        /* 3D HUD Badge in Corner */
        .hud-3d-badge {
            position: fixed;
            bottom: 16px;
            left: 20px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(45, 212, 191, 0.2);
            padding: 6px 14px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            z-index: 2;
        }
        .hud-3d-badge .hud-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 6px var(--accent);
        }

        /* Responsive */
        @@media (max-width: 860px) {
            .login-wrapper {
                grid-template-columns: 1fr;
                max-width: 460px;
                border-radius: 24px;
            }
            .showcase-panel {
                display: none;
            }
            .form-panel {
                padding: 40px 26px;
            }
        }
    </style>
</head>
<body>
    <!-- Three.js 3D Running Canvas -->
    <canvas id="admin-web3d-canvas"></canvas>

    <!-- Cyber Vignette & Ambient Glow -->
    <div class="cyber-vignette"></div>
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <div class="login-wrapper border-beam-3d" id="loginCard3D">
        <!-- Left Showcase Side -->
        <div class="showcase-panel">
            <div>

                <div class="showcase-content">
                    <div>
                        <div class="store-logo-wrapper">
                            <img src="~/Content/images/@logo" alt="Logo" class="store-logo-img" onerror="this.src='/Content/images/logo.png';" />
                        </div>
                    </div>
                    <h1>@tenCuaHang</h1>
                    <p>Hệ thống giám sát kinh doanh, xử lý đơn hàng và phân quyền bảo mật cấp cao trên nền tảng Website thời gian thực.</p>
                </div>

                <ul class="feature-list">
                    <li class="feature-item">
                        <div class="feature-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <span>Bảo mật đa lớp & phân quyền quản trị chặt chẽ</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon">
                            <i class="fa-solid fa-cube"></i>
                        </div>
                        <span>Quản lý danh mục &amp; thiết bị sản phẩm</span>
                    </li>
                    <li class="feature-item">
                        <div class="feature-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <span>Phân tích thống kê & báo cáo tăng trưởng chuyên sâu</span>
                    </li>
                </ul>
            </div>

            <div class="showcase-footer">
                <span class="system-status">
                    <span class="status-dot"></span>
                    <span>Hệ thống trực tuyến </span>
                </span>
                <span>Niên khóa: 2026 - 2027</span>
            </div>
        </div>

        <!-- Right Form Side -->
        <div class="form-panel">
            <div class="form-header">
                <h2>
                    ĐĂNG NHẬP ADMIN
                </h2>
                <p>Vui lòng xác thực tài khoản quản trị để truy cập trang điều hành</p>
            </div>

            @using (Html.BeginForm("Login", "Admin", FormMethod.Post, new { id = "adminLoginForm" }))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-danger-custom">
                        <i class="fa-solid fa-triangle-exclamation" style="font-size: 16px; flex-shrink: 0;"></i>
                        <div>
                            @Html.ValidationSummary(true, "")
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label for="EmailOrPhone">Tài khoản Email / Số điện thoại</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-envelope input-icon" id="userIcon"></i>
                        @Html.TextBoxFor(m => m.EmailOrPhone, new { 
                            @class = "form-control-custom", 
                            placeholder = "Nhập địa chỉ email quản trị ...", 
                            required = "required",
                            autocomplete = "username",
                            autofocus = "autofocus"
                        })
                    </div>
                </div>

                <div class="form-group">
                    <label for="Password">Mật khẩu xác thực</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-lock input-icon"></i>
                        @Html.PasswordFor(m => m.Password, new { 
                            @class = "form-control-custom", 
                            placeholder = "Nhập mật khẩu an toàn ...", 
                            required = "required",
                            id = "adminPasswordInput",
                            autocomplete = "current-password"
                        })
                        <button type="button" class="toggle-password" id="btnTogglePassword" title="Hiện/ẩn mật khẩu">
                            <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-submit-custom">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Xác nhận đăng nhập</span>
                </button>
            }

            <a href="@Url.Action("Index", "Home")" class="back-link">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Quay lại trang bán hàng</span>
            </a>
        </div>
    </div>


    <!-- 3D Running Background Engine Script -->
    <script>
        (function() {
            // Password toggle
            document.getElementById('btnTogglePassword')?.addEventListener('click', function() {
                var pwdInput = document.getElementById('adminPasswordInput');
                var icon = document.getElementById('togglePasswordIcon');
                if (pwdInput.type === 'password') {
                    pwdInput.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    pwdInput.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });

            // Three.js 3D Running Wireframe Terrain & Floating Cyber Matrix
            if (typeof THREE === 'undefined') return;

            var canvas = document.getElementById('admin-web3d-canvas');
            var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            var scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x030712, 0.018);

            var camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 15, 45);
            camera.lookAt(0, 0, 0);

            // Lighting
            var ambientLight = new THREE.AmbientLight(0x0d9488, 1.2);
            scene.add(ambientLight);

            var cyanPoint = new THREE.PointLight(0x2dd4bf, 3, 100);
            cyanPoint.position.set(-20, 20, 20);
            scene.add(cyanPoint);

            var bluePoint = new THREE.PointLight(0x0284c7, 3, 100);
            bluePoint.position.set(20, -10, 10);
            scene.add(bluePoint);

            // 1. Running Cyber Wireframe Grid (Digital Horizon)
            var gridWidth = 140;
            var gridHeight = 140;
            var gridSegs = 48;
            var planeGeo = new THREE.PlaneGeometry(gridWidth, gridHeight, gridSegs, gridSegs);
            planeGeo.rotateX(-Math.PI / 2);

            var pos = planeGeo.attributes.position;
            var originalZ = [];
            for (var i = 0; i < pos.count; i++) {
                originalZ.push(pos.getY(i));
            }

            var wireMat = new THREE.MeshBasicMaterial({
                color: 0x0d9488,
                wireframe: true,
                transparent: true,
                opacity: 0.35
            });
            var cyberPlane = new THREE.Mesh(planeGeo, wireMat);
            cyberPlane.position.y = -14;
            scene.add(cyberPlane);

            // 2. Floating 3D Cyber Geometries (Polyhedrons & Cubes)
            var floatingMeshes = [];
            var geoConfigs = [
                { geo: new THREE.IcosahedronGeometry(2.4, 0), pos: [-24, 12, -10], rot: [0.01, 0.015] },
                { geo: new THREE.OctahedronGeometry(2.0, 0), pos: [26, 14, -15], rot: [-0.01, 0.02] },
                { geo: new THREE.TorusGeometry(2.2, 0.6, 12, 24), pos: [-28, -6, 5], rot: [0.015, -0.01] },
                { geo: new THREE.BoxGeometry(2.2, 2.2, 2.2), pos: [28, -5, 0], rot: [0.02, 0.01] },
                { geo: new THREE.TetrahedronGeometry(1.8, 0), pos: [-16, 18, -25], rot: [-0.01, -0.01] },
                { geo: new THREE.IcosahedronGeometry(1.6, 0), pos: [20, 18, -20], rot: [0.015, 0.015] }
            ];

            geoConfigs.forEach(function(item) {
                var meshMat = new THREE.MeshStandardMaterial({
                    color: 0x030712,
                    wireframe: true,
                    emissive: 0x14b8a6,
                    emissiveIntensity: 0.6,
                    roughness: 0.2,
                    metalness: 0.9
                });
                var mesh = new THREE.Mesh(item.geo, meshMat);
                mesh.position.set(item.pos[0], item.pos[1], item.pos[2]);
                mesh.userData = {
                    rotSpeedX: item.rot[0],
                    rotSpeedY: item.rot[1],
                    baseY: item.pos[1],
                    speedOffset: Math.random() * Math.PI * 2
                };
                scene.add(mesh);
                floatingMeshes.push(mesh);
            });

            // 3. Volumetric Cyber Dust (Particles)
            var particleCount = 600;
            var particleGeo = new THREE.BufferGeometry();
            var particlePositions = new Float32Array(particleCount * 3);

            for (var p = 0; p < particleCount * 3; p += 3) {
                particlePositions[p] = (Math.random() - 0.5) * 120;
                particlePositions[p + 1] = (Math.random() - 0.5) * 80;
                particlePositions[p + 2] = (Math.random() - 0.5) * 100;
            }
            particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));

            var particleMat = new THREE.PointsMaterial({
                color: 0x2dd4bf,
                size: 0.65,
                transparent: true,
                opacity: 0.7,
                blending: THREE.AdditiveBlending
            });
            var particles = new THREE.Points(particleGeo, particleMat);
            scene.add(particles);

            // Mouse parallax target
            var mouseX = 0, mouseY = 0;
            var targetX = 0, targetY = 0;
            document.addEventListener('mousemove', function(e) {
                mouseX = (e.clientX - window.innerWidth / 2) * 0.015;
                mouseY = (e.clientY - window.innerHeight / 2) * 0.015;
            });

            // Window resize
            window.addEventListener('resize', function() {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });

            // Animation Loop (Continuous 3D Running Flow)
            var clock = new THREE.Clock();

            function animate() {
                requestAnimationFrame(animate);
                var elapsedTime = clock.getElapsedTime();

                // 1. Move Grid Waves towards camera (High-speed running terrain)
                var p = planeGeo.attributes.position;
                for (var i = 0; i < p.count; i++) {
                    var x = p.getX(i);
                    var z = p.getZ(i);
                    // Wave motion running along Z
                    var wave = Math.sin(x * 0.15 + elapsedTime * 1.8) * 1.6 +
                               Math.cos(z * 0.15 + elapsedTime * 2.2) * 1.4;
                    p.setY(i, wave);
                }
                p.needsUpdate = true;

                // 2. Rotate & Float 3D Polyhedrons
                floatingMeshes.forEach(function(m) {
                    m.rotation.x += m.userData.rotSpeedX;
                    m.rotation.y += m.userData.rotSpeedY;
                    m.position.y = m.userData.baseY + Math.sin(elapsedTime * 1.2 + m.userData.speedOffset) * 1.8;
                });

                // 3. Slow drift of particles
                particles.rotation.y = elapsedTime * 0.03;
                particles.rotation.x = elapsedTime * 0.015;

                // 4. Smooth Camera Parallax
                targetX += (mouseX - targetX) * 0.05;
                targetY += (mouseY - targetY) * 0.05;
                camera.position.x = targetX * 1.8;
                camera.position.y = 15 - targetY * 1.2;
                camera.lookAt(0, 0, 0);

                renderer.render(scene, camera);
            }

            animate();
        })();
    </script>
</body>
</html>
